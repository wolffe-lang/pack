//! art — a frame from the simulation: the forest, the path and the pack
//! drawn onto a grid through a tier. Pure: the same simulation state and
//! tier give the same grid, which is what the goldens pin.
//!
//! The sprites (`docs/ART.md`): the rich wolf is 3 by 2 cells with
//! half-blocks (R-pk00-4 B: the doubling is the wolves' alone), the plain
//! wolf 2 by 1. Posture is the HUD (innovation 5): the ears and the tail
//! carry the stamina band, the head the pant, the gait the speed. The
//! fainted wolf lies where it fell; the shadow wolves with red eyes are
//! drawn where the simulation has them (pk02: eyes dim while they lurk,
//! pulsing while they chase, steady through an attack; a vanquished body
//! fades); the death card is drawn over the field from the same cell model
//! on both tiers; the deer (pk03) are drawn where the simulation has them.

use draw
use grid
use sim
use sprites
use tier
use trail
use world

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

/// A forest cell's sprite by `world.forest_kind`'s answer.
fn forest_sprite(kind: int) -> int {
    if kind == 0 {
        return sprites.SP_GRASS
    }
    if kind == 1 {
        return sprites.SP_TRUNK
    }
    if kind == 2 {
        return sprites.SP_CANOPY
    }
    sprites.SP_FOREST_DARK
}

/// The terrain of screen row `row` into `g`: path cells inside the path,
/// forest outside (its cover from the row's density), the verge at the
/// edge.
fn terrain_row(s: sim.Sim, t: int, p: sprites.Palette, row: int, mut g: grid.Grid) {
    let wr = sim.world_row(s, row)
    let (centre, half) = trail.path(s.seed, s.cols, wr)
    let density = world.density(s.seed, wr)
    var col = 0
    while col < s.cols {
        let xc = col * world.FP + world.FP / 2
        let d = abs(xc - centre)
        if d <= half {
            if world.path_marked(s.seed, wr, col, 9) {
                grid.put(
                    mut g,
                    row,
                    col,
                    sprites.glyph_at(t, p, sprites.SP_PATH_MARK, world.variant(s.seed, wr, col, 4)),
                )
            } else {
                grid.put(mut g, row, col, sprites.glyph_at(t, p, sprites.SP_PATH, 0))
            }
        } else {
            let dist = (d - half + world.FP - 1) / world.FP
            let kind = world.forest_kind(s.seed, wr, col, dist - 1, density)
            let v = world.variant(s.seed, wr, col, 4)
            grid.put(mut g, row, col, sprites.glyph_at(t, p, forest_sprite(kind), v))
        }
        col += 1
    }
}

/// Draw one wolf at screen `row` (its body row), centred on `col`, with
/// a trot `frame`, a `posture`, a stamina `band` and `dim` for the forest
/// edge. Rich: three cells wide and two tall (the head row above: ear,
/// head, ear; the body row: legs, body, tail); plain: the head cell and a
/// tail cell.
pub fn draw_wolf(
    mut g: grid.Grid,
    t: int,
    p: sprites.Palette,
    row: int,
    col: int,
    frame: int,
    posture: int,
    band: int,
    tick: int,
    dim: bool,
) {
    if posture == sim.POSTURE_LEAP {
        let fur = if dim then p.fur_dim else p.fur
        if t == tier.RICH {
            // A long low body, tucked legs and ears out: not the trot or
            // the sprint. All blocks already belong to GLYPHS.md.
            grid.put(mut g, row - 1, col - 1, grid.cell(9629, fur, p.path, 0))
            grid.put(mut g, row - 1, col, grid.cell(9600, fur, p.path, 0))
            grid.put(mut g, row - 1, col + 1, grid.cell(9624, fur, p.path, 0))
            grid.put(mut g, row, col - 1, grid.cell(9604, fur, p.path, 0))
            grid.put(mut g, row, col, grid.cell(9600, fur, p.path, 0))
            grid.put(mut g, row, col + 1, grid.cell(9604, fur, p.path, 0))
        } else {
            grid.put(mut g, row, col, grid.cell(62, fur, p.path, grid.ATTR_BOLD))
            grid.put(mut g, row, col + 1, grid.cell(87, fur, p.path, grid.ATTR_BOLD))
        }
        return
    }
    let pant = posture == sim.POSTURE_PANT && tick / 8 % 2 == 1
    if t == tier.RICH {
        let body = if dim then sprites.SP_WOLF_BODY_DIM else sprites.SP_WOLF_BODY
        let head_v = if pant then 1 else 0
        grid.put(mut g, row - 1, col - 1, sprites.glyph_at(t, p, sprites.SP_WOLF_EAR, 2 * band))
        grid.put(mut g, row - 1, col, sprites.glyph_at(t, p, sprites.SP_WOLF_HEAD, head_v))
        grid.put(mut g, row - 1, col + 1, sprites.glyph_at(t, p, sprites.SP_WOLF_EAR, 2 * band + 1))
        grid.put(mut g, row, col - 1, sprites.glyph_at(t, p, sprites.SP_WOLF_LEGS, frame))
        grid.put(mut g, row, col, sprites.glyph_at(t, p, body, 0))
        grid.put(
            mut g,
            row,
            col + 1,
            sprites.glyph_at(t, p, sprites.SP_WOLF_TAIL, 4 * band + frame),
        )
        return
    }
    var head = sprites.glyph_at(
        t,
        p,
        sprites.SP_WOLF_HEAD,
        if pant || band == sim.BAND_SPENT then 1 else 0,
    )
    if dim {
        head = sprites.glyph_at(t, p, sprites.SP_WOLF_BODY_DIM, 0)
    }
    grid.put(mut g, row, col, head)
    grid.put(mut g, row, col + 1, sprites.glyph_at(t, p, sprites.SP_WOLF_TAIL, 4 * band + frame))
}

/// A fainted wolf at `row`, `col`.
pub fn draw_fainted(mut g: grid.Grid, t: int, p: sprites.Palette, row: int, col: int) {
    if t == tier.RICH {
        grid.put(mut g, row, col - 1, sprites.glyph_at(t, p, sprites.SP_FAINTED, 1))
        grid.put(mut g, row, col, sprites.glyph_at(t, p, sprites.SP_FAINTED, 0))
        grid.put(mut g, row, col + 1, sprites.glyph_at(t, p, sprites.SP_FAINTED, 1))
        return
    }
    grid.put(mut g, row, col, sprites.glyph_at(t, p, sprites.SP_FAINTED, 0))
    grid.put(mut g, row, col + 1, sprites.glyph_at(t, p, sprites.SP_FAINTED, 1))
}

/// A shadow wolf at `row` (its body row), `col`, with its eyes toward the
/// pack: on the row below the body when it faces down the path (`facing_up`
/// false, an ambush ahead), on the row above when it chases from behind.
/// `eyes` is the eye variant (0 bright, 1 dim); `fade` 0 for a live shadow,
/// else the ticks since it was vanquished out of `fade_ticks` (the eyes out,
/// the body thinning). Rich: three cells by two rows; plain: `W` and an eye
/// cell.
pub fn draw_shadow(
    mut g: grid.Grid,
    t: int,
    p: sprites.Palette,
    row: int,
    col: int,
    eyes: int,
    facing_up: bool,
    fade: int,
    fade_ticks: int,
) {
    let body_v = if fade == 0 then 0 else if fade * 2 < fade_ticks then 1 else 2
    if t == tier.RICH {
        let body_row = if facing_up then row else row - 1
        let eye_row = if facing_up then row - 1 else row
        let body = sprites.glyph_at(t, p, sprites.SP_SHADOW_BODY, body_v)
        grid.put(mut g, body_row, col - 1, body)
        grid.put(mut g, body_row, col, body)
        grid.put(mut g, body_row, col + 1, body)
        let eye = if fade == 0 {
            sprites.glyph_at(t, p, sprites.SP_SHADOW_EYE, eyes)
        } else {
            copy body
        }
        grid.put(mut g, eye_row, col - 1, eye)
        grid.put(mut g, eye_row, col, body)
        grid.put(mut g, eye_row, col + 1, eye)
        return
    }
    grid.put(mut g, row, col, sprites.glyph_at(t, p, sprites.SP_SHADOW_BODY, body_v))
    if fade == 0 {
        grid.put(mut g, row, col + 1, sprites.glyph_at(t, p, sprites.SP_SHADOW_EYE, eyes))
    }
}

/// Two readable beats on both tiers: compressed crouch, then stretched
/// lunge. Existing glyphs only; the eyes remain steady bright throughout.
pub fn draw_shadow_attack(
    mut g: grid.Grid,
    t: int,
    p: sprites.Palette,
    row: int,
    col: int,
    crouch: bool,
    facing_up: bool,
    eyes: int,
) {
    if t == tier.PLAIN {
        grid.put(
            mut g,
            row,
            col,
            grid.cell(if crouch then 119 else 62, p.shadow, p.path, grid.ATTR_BOLD),
        )
        grid.put(
            mut g,
            row,
            col + 1,
            grid.cell(58, if eyes == 0 then p.eye else p.eye_dim, p.path, grid.ATTR_BOLD),
        )
        return
    }
    let er = if facing_up then row - 1 else row
    let br = if facing_up then row else row - 1
    let body = grid.cell(if crouch then 9604 else 9600, p.shadow, p.path, 0)
    var dx = -1
    while dx <= 1 { grid.put(mut g, br, col + dx, body); dx += 1 }
    grid.put(mut g, er, col - 1, sprites.glyph_at(t, p, sprites.SP_SHADOW_EYE, eyes))
    grid.put(mut g, er, col, body)
    grid.put(mut g, er, col + 1, sprites.glyph_at(t, p, sprites.SP_SHADOW_EYE, eyes))
}

/// A deer at `row` (its body row), `col` (its left cell), head up the
/// path (pk03): rich, two cells wide and two tall, the antlers over the
/// body (`▝▘` over `██`, code points the wolf already uses, so GLYPHS.md
/// gains no row); plain `YD`.
pub fn draw_deer(mut g: grid.Grid, t: int, p: sprites.Palette, row: int, col: int) {
    if t == tier.RICH {
        grid.put(mut g, row - 1, col, sprites.glyph_at(t, p, sprites.SP_DEER, 0))
        grid.put(mut g, row - 1, col + 1, sprites.glyph_at(t, p, sprites.SP_DEER, 2))
        grid.put(mut g, row, col, sprites.glyph_at(t, p, sprites.SP_DEER, 1))
        grid.put(mut g, row, col + 1, sprites.glyph_at(t, p, sprites.SP_DEER, 1))
        return
    }
    grid.put(mut g, row, col, sprites.glyph_at(t, p, sprites.SP_DEER, 0))
    grid.put(mut g, row, col + 1, sprites.glyph_at(t, p, sprites.SP_DEER, 1))
}

/// Whether a wolf whose body row is `row` is on a screen of `rows` rows
/// on tier `t` (the rich wolf needs the row above too).
fn on_screen(t: int, row: int, rows: int) -> bool {
    let top = if t == tier.RICH then row - 1 else row
    top >= 0 && row < rows
}

/// Draw shadow `k` where the alpha's eye puts it, if on the screen. Under
/// the card the world stands still, eyes included: the pulse reads the
/// death's tick.
fn draw_sim_shadow(s: sim.Sim, t: int, p: sprites.Palette, k: int, mut g: grid.Grid) {
    let sh = copy s.shadows[k]
    if sh.state == sim.GONE {
        return
    }
    let (x, y) = sim.shadow_draw_position(s, k)
    let row = sim.wolf_row(s) - (y / world.FP - sim.alpha(s).y / world.FP)
    let col = x / world.FP
    if on_screen(t, row, s.rows) {
        draw_shadow(
            mut g,
            t,
            p,
            row,
            col,
            sim.shadow_eyes(sh, if s.dead then s.died_tick else s.tick),
            sh.dir > 0,
            if sh.state == sim.VANQUISHED then sh.fade + 1 else 0,
            sim.FADE_TICKS + 1,
        )
        if sh.state == sim.ATTACKING || sh.attack_age > 0 {
            draw_shadow_attack(
                mut g,
                t,
                p,
                row,
                col,
                sim.shadow_crouching(sh),
                sh.dir > 0,
                sim.shadow_eyes(sh, if s.dead then s.died_tick else s.tick),
            )
        }
        if sh.state == sim.LURKING && sh.face_x != 0 {
            // Outward and diagonal facings read in the eyes too, not only
            // in the sensor. Reuse the tier's body and eye cells.
            let side = if sh.face_x < 0 then -1 else 1
            let eye = sprites.glyph_at(t, p, sprites.SP_SHADOW_EYE, 1)
            let body = sprites.glyph_at(t, p, sprites.SP_SHADOW_BODY, 0)
            if t == tier.RICH {
                var dy = -1
                while dy <= 0 {
                    var dx = -1
                    while dx <= 1 { grid.put(mut g, row + dy, col + dx, body); dx += 1 }
                    dy += 1
                }
                let er = if sh.face_y > 0 then row - 1 else row
                grid.put(mut g, er, col + side, eye)
                grid.put(
                    mut g,
                    if sh.face_y == 0 then row - 1 else er,
                    if sh.face_y == 0 then col + side else col,
                    eye,
                )
            } else {
                grid.put(mut g, row, col + 1, sprites.glyph_at(t, p, sprites.SP_PATH, 0))
                grid.put(mut g, row, col + side, eye)
            }
        }
    }
}

/// Draw deer `k` where the alpha's eye puts it, if on the screen.
fn draw_sim_deer(s: sim.Sim, t: int, p: sprites.Palette, k: int, mut g: grid.Grid) {
    if s.deer[k].state == sim.DEER_GONE {
        return
    }
    let row = sim.deer_screen_row(s, k)
    let col = sim.deer_screen_col(s, k)
    if on_screen(t, row, s.rows) {
        draw_deer(mut g, t, p, row, col)
    }
}

/// Draw wolf `i` of the simulation where the alpha's eye puts it, if on
/// the screen.
fn draw_pack_wolf(s: sim.Sim, t: int, p: sprites.Palette, i: int, mut g: grid.Grid) {
    let (x, y) = sim.wolf_draw_position(s, i)
    let row = sim.wolf_row(s) - (y / world.FP - sim.alpha(s).y / world.FP)
    let col = x / world.FP
    let w = copy s.wolves[i]
    if w.state == sim.FAINTED {
        if row >= 0 && row < s.rows {
            draw_fainted(mut g, t, p, row, col)
        }
        return
    }
    if on_screen(t, row, s.rows) {
        draw_wolf(
            mut g,
            t,
            p,
            row,
            col,
            sim.trot_frame(s, i),
            sim.wolf_posture(s, i),
            sim.band(s),
            if s.dead then s.died_tick else s.tick,
            w.in_forest,
        )
    }
}

/// The whole frame: terrain on every row, then the fainted (they lie under
/// the path), the fading shadows, the deer, the live shadows, the wolves,
/// the alpha last; the death card over it all once the run is over. `g` must be the simulation's size
/// (`assert`).
pub fn render(s: sim.Sim, t: int, mut g: grid.Grid) {
    assert(g.rows == s.rows && g.cols == s.cols, "art.render: the grid is the simulation's size")
    // The phase of the day from the distance, the palette once a frame.
    let p = sprites.palette_at(t, sim.phase(s))
    var row = 0
    while row < s.rows {
        terrain_row(s, t, p, row, mut g)
        row += 1
    }
    var i = 0
    while i < sim.PACK_SIZE {
        if s.wolves[i].state == sim.FAINTED {
            draw_pack_wolf(s, t, p, i, mut g)
        }
        i += 1
    }
    // The fading first, so a live shadow passing over one is drawn whole.
    var k = 0
    while k < s.shadows.len {
        if s.shadows[k].state == sim.VANQUISHED {
            draw_sim_shadow(s, t, p, k, mut g)
        }
        k += 1
    }
    k = 0
    while k < s.deer.len {
        draw_sim_deer(s, t, p, k, mut g)
        k += 1
    }
    k = 0
    while k < s.shadows.len {
        if s.shadows[k].state != sim.VANQUISHED {
            draw_sim_shadow(s, t, p, k, mut g)
        }
        k += 1
    }
    i = 0
    while i < sim.PACK_SIZE {
        if i != sim.ALPHA && s.wolves[i].state != sim.FAINTED {
            draw_pack_wolf(s, t, p, i, mut g)
        }
        i += 1
    }
    draw_pack_wolf(s, t, p, sim.ALPHA, mut g)
    if s.leap_landing {
        var mark = 0
        while mark < s.leap_marks_x.len {
            let row = sim.wolf_row(s) -
                (s.leap_marks_y[mark] / world.FP - sim.alpha(s).y / world.FP)
            grid.put(
                mut g,
                row,
                s.leap_marks_x[mark] / world.FP,
                grid.cell(if t == tier.RICH then 183 else 42, p.fur, p.path, grid.ATTR_BOLD),
            )
            mark += 1
        }
    }
    if s.dead {
        card_with(s, t, mut g, "")
    }
}

/// The card's width in cells.
pub const CARD_COLS: int = 44

/// The card's height in rows.
pub const CARD_ROWS: int = 10

fn put_text(
    mut g: grid.Grid,
    t: int,
    p: sprites.Palette,
    row: int,
    col: int,
    text: str,
    emphasis: bool,
) {
    draw.put_text(mut g, row, col, text, sprites.card_text_at(t, p, 32, emphasis))
}

/// A line of the card: a label at the left, a number at the right.
fn card_line(
    mut g: grid.Grid,
    t: int,
    p: sprites.Palette,
    row: int,
    col: int,
    label: str,
    value: str,
    emphasis: bool,
) {
    put_text(mut g, t, p, row, col + 3, label, emphasis)
    put_text(mut g, t, p, row, col + CARD_COLS - 3 - value.len, value, emphasis)
}

/// The death card (pk02, the campaign's innovation 5: the first numbers
/// the player sees): shadows vanquished, seconds survived, the distance in
/// cells, and the score, with the offer to save the replay (`s`) or leave
/// (`q`); R-pk02-4 A: nothing else on it. Centred over the field from the
/// same cell model on both tiers; `saved` names the file once `s` wrote it.
pub fn card(s: sim.Sim, t: int, mut g: grid.Grid) {
    card_with(s, t, mut g, "")
}

/// The card, with the saved file's name on its last line when not empty.
pub fn card_with(s: sim.Sim, t: int, mut g: grid.Grid, saved: str) {
    card_offer(
        s,
        t,
        mut g,
        if saved == "" then "s saves the replay, q leaves" else "saved {saved}; q leaves",
    )
}

/// The card with an explicit last line (a replay's verdict, pk03).
pub fn card_offer(s: sim.Sim, t: int, mut g: grid.Grid, offer: str) {
    let p = sprites.palette_at(t, sim.phase(s))
    let top = (s.rows - CARD_ROWS) / 2
    let left = (s.cols - CARD_COLS) / 2
    draw.frame(
        mut g,
        top,
        left,
        CARD_ROWS,
        CARD_COLS,
        sprites.card_frame_at(t, p, 0),
        sprites.card_frame_at(t, p, 1),
        sprites.card_frame_at(t, p, 2),
        sprites.card_text_at(t, p, 32, false),
    )
    let title = "the pack is gone"
    put_text(mut g, t, p, top + 1, left + (CARD_COLS - title.len) / 2, title, true)
    card_line(mut g, t, p, top + 3, left, "shadows vanquished", "{s.vanquished}", false)
    card_line(mut g, t, p, top + 4, left, "seconds survived", "{sim.seconds(s)}", false)
    card_line(mut g, t, p, top + 5, left, "distance, cells", "{sim.distance_cells(s)}", false)
    card_line(mut g, t, p, top + 6, left, "score", "{sim.score(s)}", true)
    put_text(mut g, t, p, top + 8, left + 3, draw.fit(offer, CARD_COLS - 6, false), false)
}

/// The art study's sheet (`docs/ART.md`): every sprite the tiers know,
/// laid out on a 24 by 60 grid over a strip of path and forest — the
/// forest a clearing on the top third, thin woods in the middle, a dense
/// stand below — the four trot frames, the postures (standing, sprinting,
/// the two pant phases, dim, tired, spent), the fainted wolf, the shadow
/// wolf with bright eyes facing down the path, with dim eyes facing up it,
/// and fading, the deer, and the pack in formation.
/// Committed as a golden on both tiers.
pub fn sheet(t: int) -> grid.Grid {
    let p = sprites.palette_at(t, 0)
    var g = grid.new(24, 60)
    // A band of path down the middle with forest either side.
    var row = 0
    while row < 24 {
        let density = if row < 8 then 0 else if row < 16 then world.FP / 2 else world.FP
        var col = 0
        while col < 60 {
            let d = abs(col - 30)
            var c = sprites.glyph_at(t, p, sprites.SP_PATH, 0)
            if d > 14 {
                let dist = d - 14
                let kind = world.forest_kind(1, row, col, dist - 1, density)
                c = sprites.glyph_at(t, p, forest_sprite(kind), world.variant(1, row, col, 4))
            } else if world.path_marked(1, row, col, 9) {
                c = sprites.glyph_at(t, p, sprites.SP_PATH_MARK, world.variant(1, row, col, 4))
            }
            grid.put(mut g, row, col, c)
            col += 1
        }
        row += 1
    }
    // The four trot frames, side by side on row 3.
    var f = 0
    while f < 4 {
        draw_wolf(mut g, t, p, 3, 20 + f * 5, f, sim.POSTURE_TROT, sim.BAND_FRESH, 0, false)
        f += 1
    }
    // Standing, sprinting, panting (both phases), dim, tired, spent.
    draw_wolf(mut g, t, p, 7, 20, 0, sim.POSTURE_STAND, sim.BAND_FRESH, 0, false)
    draw_wolf(mut g, t, p, 7, 25, 1, sim.POSTURE_SPRINT, sim.BAND_FRESH, 0, false)
    draw_wolf(mut g, t, p, 7, 30, 0, sim.POSTURE_PANT, sim.BAND_SPENT, 0, false)
    draw_wolf(mut g, t, p, 7, 35, 0, sim.POSTURE_PANT, sim.BAND_SPENT, 8, false)
    draw_wolf(mut g, t, p, 7, 40, 2, sim.POSTURE_TROT, sim.BAND_FRESH, 0, true)
    draw_wolf(mut g, t, p, 7, 45, 1, sim.POSTURE_TROT, sim.BAND_TIRED, 0, false)
    draw_wolf(mut g, t, p, 7, 50, 2, sim.POSTURE_TROT, sim.BAND_SPENT, 0, false)
    draw_wolf(mut g, t, p, 3, 42, 0, sim.POSTURE_LEAP, sim.BAND_FRESH, 0, false)
    // The fainted wolf, the shadow wolf (two eye frames), the deer.
    draw_fainted(mut g, t, p, 11, 20)
    draw_shadow(mut g, t, p, 11, 27, 0, false, 0, sim.FADE_TICKS)
    draw_shadow(mut g, t, p, 11, 33, 1, true, 0, sim.FADE_TICKS)
    draw_shadow(mut g, t, p, 11, 46, 0, false, 10, sim.FADE_TICKS)
    draw_deer(mut g, t, p, 11, 39)
    draw_shadow_attack(mut g, t, p, 14, 43, true, false, 0)
    draw_shadow_attack(mut g, t, p, 14, 50, false, false, 0)
    // The pack in formation, the alpha trailing at the centre: the slots
    // of `sim.slot_dx`/`slot_dy` around the alpha at (21, 30).
    var i = 0
    while i < sim.PACK_SIZE {
        draw_wolf(
            mut g,
            t,
            p,
            21 - sim.slot_dy(i),
            30 + sim.slot_dx(i),
            i % 4,
            sim.POSTURE_TROT,
            sim.BAND_FRESH,
            0,
            false,
        )
        i += 1
    }
    g
}

/// The title card's width in cells (pk03).
pub const TITLE_COLS: int = 56

/// The title card's height in rows.
pub const TITLE_ROWS: int = 14

/// What the title card shows (pk03): the seed the next run takes, the
/// last run's score (-1 for none) and its verdict when it was a replay,
/// the best (score, seed, date, the replay's name; -1 for none), the last
/// saved replay's path, the prompt (open, with its text so far) and a
/// message line (a refusal by name, a verdict).
pub struct Title {
    seed: int,
    last_score: int,
    last_note: str,
    best_score: int,
    best_seed: int,
    best_date: str,
    best_name: str,
    saved: str,
    prompt_open: bool,
    prompt: str,
    message: str,
}

/// A title with nothing to show but the seed.
pub fn title_new(seed: int) -> Title {
    Title {
        seed: seed,
        last_score: -1,
        last_note: "",
        best_score: -1,
        best_seed: 0,
        best_date: "",
        best_name: "-",
        saved: "",
        prompt_open: false,
        prompt: "",
        message: "",
    }
}

/// The title card, drawn over the field (the seed's forest at its start)
/// from the same cell model as the death card, on both tiers: the name,
/// `any key to run`, the last score and the best, what the keys do, and
/// the prompt when it is open. Text is ASCII, so GLYPHS.md gains no row.
pub fn title(t: int, phase: int, info: Title, rows: int, cols: int, mut g: grid.Grid) {
    let p = sprites.palette_at(t, phase)
    let top = (rows - TITLE_ROWS) / 2
    let left = (cols - TITLE_COLS) / 2
    draw.frame(
        mut g,
        top,
        left,
        TITLE_ROWS,
        TITLE_COLS,
        sprites.card_frame_at(t, p, 0),
        sprites.card_frame_at(t, p, 1),
        sprites.card_frame_at(t, p, 2),
        sprites.card_text_at(t, p, 32, false),
    )
    let inner = TITLE_COLS - 6
    let name = "p a c k"
    put_text(mut g, t, p, top + 1, left + (TITLE_COLS - name.len) / 2, name, true)
    let sub = "lead the pack up the forest path"
    put_text(mut g, t, p, top + 2, left + (TITLE_COLS - sub.len) / 2, sub, false)
    put_text(mut g, t, p, top + 4, left + 3, "seed {info.seed}", false)
    let last = if info.last_score < 0 {
        "last   -"
    } else {
        draw.fit(
            "last   {info.last_score}{if info.last_note == "" then "" else "   {info.last_note}"}",
            inner,
            false,
        )
    }
    put_text(mut g, t, p, top + 5, left + 3, last, false)
    let best = if info.best_score < 0 {
        "best   -"
    } else {
        draw.fit(
            "best   {info.best_score}  seed {info.best_seed}  {info.best_date[0..if info.best_date.len < 10 then info.best_date.len else 10]}{if info.best_name == "-" then "" else "  {draw.short_name(info.best_name)}"}",
            inner,
            false,
        )
    }
    put_text(mut g, t, p, top + 6, left + 3, best, true)
    let saved = if info.saved == "" {
        "no replay saved yet"
    } else {
        draw.fit("saved  {draw.short_name(info.saved)}", inner, false)
    }
    put_text(mut g, t, p, top + 7, left + 3, saved, false)
    put_text(mut g, t, p, top + 9, left + 3, "any key to run; r runs this seed again", false)
    put_text(mut g, t, p, top + 10, left + 3, "p plays the last saved replay; / one by name", false)
    put_text(mut g, t, p, top + 11, left + 3, "q leaves", false)
    let line = if info.prompt_open {
        draw.fit("replay: {info.prompt}_", inner, true)
    } else {
        draw.fit(info.message, inner, false)
    }
    put_text(mut g, t, p, top + 12, left + 3, line, info.prompt_open)
}
