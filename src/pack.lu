//! member: false
//!
//! pack — lead a pack of wolves up an endless forest path. The entry: the
//! command line, the live loop (one wait a tick on the terminal and the
//! signals, the simulation stepped once a tick, the screen diffed once a
//! frame), the headless run that writes frames for the goldens, the
//! replay and record paths, and the two tools the pty runner and the art
//! study need (`--apply`, `--probe-glyphs`).
//!
//! Track 19 of the wolffe-lang planning repo. pk00 was the engine (M-PK0:
//! one wolf on a scrolling path); pk01 made it a pack in a forest (M-PK1:
//! five wolves in formation, health as fainting and return, the forest's
//! density, posture as the HUD); pk02 made it a fight (M-PK2: the shadows,
//! the leap and the parry, damage into health, the death card and the
//! score, the replay saved from the card); pk03 made it the game (M-PK3:
//! the deer, the difficulty curve, dusk, the title card with the best and
//! the last, replays loaded and verified).

use art
use best
use clock
use grid
use input
use replay
use sim
use std.env
use std.fs
use std.time
use term
use tier

/// What the command line asked for.
struct Options {
    headless: bool,
    seed: int,
    script: str,
    frames: int,
    every: int,
    from_tick: int,
    tier: int,
    cols: int,
    rows: int,
    dump: str,
    replay_path: str,
    record_path: str,
    trap_at: int,
    ticks: int,
    truecolor: int,
    apply_path: str,
    art_study: bool,
    probe_glyphs: bool,
    bench: bool,
    selftest: bool,
    trace: bool,
    debug: bool,
    speed_scale: int,
    bench_shadows: int,
    bench_deer: int,
    start_rows: int,
    no_title: bool,
    help: bool,
    version: bool,
}

fn usage_text() -> str {
    "pack — lead a pack of wolves up an endless forest path\n\n" +
        "  pack [--seed N] [--tier rich|plain] [--record FILE] [--no-title]\n" +
        "  pack --replay FILE                reproduce a recorded run\n" +
        "  pack --headless --seed N [--script FILE] --frames N [--every K] [--from T]\n" +
        "       --tier T --size WxH --dump DIR\n" +
        "  pack --apply CAPTURE --size WxH   a captured byte stream as a frame\n" +
        "  pack --art-study --dump DIR       the sprite sheets, both tiers\n" +
        "  pack --probe-glyphs               measure the rich glyphs' widths here\n" +
        "  pack --bench --size WxH --tier T --frames N [--bench-shadows N] [--bench-deer N]\n" +
        "                                    time render + diff a frame\n" +
        "  pack --selftest                   the decoder table and the diff property, on THIS binary\n\n" +
        "  keys: arrows steer, Up sprints, Down stops, Space leaps,\n" +
        "        Shift+Down or z parries, q or Esc leaves the run for the title (or quits\n" +
        "        under --no-title); on the death card s saves the replay (pack-SEED-SCORE.pk\n" +
        "        in the working directory, or --record's path) with its score, q leaves it\n" +
        "  the title: any key runs, r the same seed again, p the last saved replay,\n" +
        "        / a replay by name, q leaves; the best and the last are kept in ~/.pack/best\n" +
        "  --no-title                        the run at once, no title card (the pty rows)\n" +
        "  --truecolor / --no-truecolor      override COLORTERM\n" +
        "  --ticks N                         quit after N ticks\n" +
        "  --start N                         begin N rows up the path (the replay header's start N):\n" +
        "                                    the curve and the dusk from there; --start 1200 is full dusk\n" +
        "  --trace                           one line a tick on standard error: the bytes read, the keys\n" +
        "                                    applied, the steer and heading; a line per frame that carries a key\n" +
        "  --debug                           allow the debug knobs: --speed-scale N (percent of every speed),\n" +
        "                                    the keys - and = (the pack's health down and up by ten)\n"
}

fn options_default() -> Options {
    Options {
        headless: false,
        seed: 1,
        script: "",
        frames: 60,
        every: 1,
        from_tick: 0,
        tier: -1,
        cols: 0,
        rows: 0,
        dump: "",
        replay_path: "",
        record_path: "",
        trap_at: 0,
        ticks: 0,
        truecolor: -1,
        apply_path: "",
        art_study: false,
        probe_glyphs: false,
        bench: false,
        selftest: false,
        trace: false,
        debug: false,
        speed_scale: 100,
        bench_shadows: 0,
        bench_deer: 0,
        start_rows: -1,
        no_title: false,
        help: false,
        version: false,
    }
}

fn parse_args(args: List[str]) -> Options ! {usage, parse} {
    var o = options_default()
    var i = 0
    while i < args.len {
        let a = args[i]
        let more = i + 1 < args.len
        if a == "--headless" {
            o.headless = true
        } else if a == "--help" || a == "-h" {
            o.help = true
        } else if a == "--version" {
            o.version = true
        } else if a == "--art-study" {
            o.art_study = true
        } else if a == "--probe-glyphs" {
            o.probe_glyphs = true
        } else if a == "--bench" {
            o.bench = true
        } else if a == "--selftest" {
            o.selftest = true
        } else if a == "--trace" {
            o.trace = true
        } else if a == "--debug" {
            o.debug = true
        } else if a == "--no-title" {
            o.no_title = true
        } else if more && a == "--speed-scale" {
            i += 1
            o.speed_scale = args[i].to_int()?
        } else if more && a == "--bench-shadows" {
            i += 1
            o.bench_shadows = args[i].to_int()?
        } else if more && a == "--bench-deer" {
            i += 1
            o.bench_deer = args[i].to_int()?
        } else if more && a == "--start" {
            i += 1
            o.start_rows = args[i].to_int()?
            if o.start_rows < 0 {
                return usage
            }
        } else if a == "--truecolor" {
            o.truecolor = 1
        } else if a == "--no-truecolor" {
            o.truecolor = 0
        } else if more && a == "--seed" {
            i += 1
            o.seed = args[i].to_int()?
        } else if more && a == "--frames" {
            i += 1
            o.frames = args[i].to_int()?
        } else if more && a == "--every" {
            i += 1
            o.every = args[i].to_int()?
        } else if more && a == "--from" {
            i += 1
            o.from_tick = args[i].to_int()?
        } else if more && a == "--trap-at" {
            i += 1
            o.trap_at = args[i].to_int()?
        } else if more && a == "--ticks" {
            i += 1
            o.ticks = args[i].to_int()?
        } else if more && a == "--tier" {
            i += 1
            o.tier = tier.of_name(args[i]) else |_| {
                return usage
            }
        } else if more && a == "--size" {
            i += 1
            let (c, r) = replay.parse_size(args[i]) else |_| {
                return usage
            }
            o.cols = c
            o.rows = r
        } else if more && a == "--script" {
            i += 1
            o.script = args[i]
        } else if more && a == "--dump" {
            i += 1
            o.dump = args[i]
        } else if more && a == "--replay" {
            i += 1
            o.replay_path = args[i]
        } else if more && a == "--record" {
            i += 1
            o.record_path = args[i]
        } else if more && a == "--apply" {
            i += 1
            o.apply_path = args[i]
        } else {
            return usage
        }
        i += 1
    }
    if o.frames < 1 ||
        o.every < 1 ||
        o.from_tick < 0 ||
        o.speed_scale < 1 ||
        o.bench_shadows < 0 ||
        o.bench_deer < 0 {
        return usage
    }
    o
}

/// The debug knobs are refused by name without `--debug` (a release binary
/// never takes one by accident; the maintainer tunes with both flags).
fn debug_refusal(o: Options) -> str {
    if o.debug {
        return ""
    }
    if o.speed_scale != 100 {
        return "pack: --speed-scale is a debug knob; add --debug"
    }
    ""
}

fn pad4(n: int) -> str {
    if n < 10 {
        return "000{n}"
    }
    if n < 100 {
        return "00{n}"
    }
    if n < 1000 {
        return "0{n}"
    }
    "{n}"
}

fn write_frame(dir: str, name: str, g: grid.Grid) -> () ! {io} {
    var text = List[byte]()
    grid.dump_text(g, mut text)
    fs.write_bytes("{dir}/{name}.txt", text) else |_| {
        return io
    }
    var sty = List[byte]()
    grid.dump_styles(g, mut sty)
    fs.write_bytes("{dir}/{name}.sty", sty) else |_| {
        return io
    }
}

/// The replay a run follows: the file named by `--script` or `--replay`,
/// or an empty one from the options. Flags given on the command line
/// override the file's header.
fn load_replay(o: Options, want_cols: int, want_rows: int) -> replay.Replay ! {parse, io} {
    let path = if o.script != "" then o.script else o.replay_path
    var r = replay.new(o.seed, if o.tier < 0 then tier.RICH else o.tier, want_cols, want_rows)
    if path != "" {
        let text = fs.read_text(path) else |_| {
            return io
        }
        r = replay.from_text(text)?
        if o.cols > 0 {
            r.cols = o.cols
            r.rows = o.rows
        }
        if o.tier >= 0 {
            r.tier = o.tier
        }
    }
    if o.start_rows >= 0 {
        r.start = o.start_rows
    }
    r
}

fn seed_given(args: List[str]) -> bool {
    for a in args {
        if a == "--seed" {
            return true
        }
    }
    false
}

/// The headless run: `frames` ticks from the script, every `every`th
/// frame from tick `from_tick` on and the final one written to `dump` as
/// cell text and styles.
fn run_headless(o: Options, args: List[str]) -> int {
    var r = load_replay(
        o,
        if o.cols > 0 then o.cols else 80,
        if o.rows > 0 then o.rows else 24,
    ) else |e| {
        eprint("pack: the script could not be read ({e})")
        return 2
    }
    if seed_given(args) {
        r.seed = o.seed
    }
    if o.dump == "" {
        eprint("pack: --headless needs --dump DIR")
        return 2
    }
    fs.create_dir_all(o.dump) else |_| {
        eprint("pack: cannot create {o.dump}")
        return 2
    }
    var s = sim.new_at(r.seed, r.cols, r.rows, r.start)
    s.speed_scale = o.speed_scale
    var g = grid.new(r.rows, r.cols)
    var keys = List[int]()
    var k = 0
    while k < o.frames {
        (mut keys).reset()
        let (c, rows, health) = replay.at(r, k, mut keys)
        if c > 0 {
            sim.resize(mut s, c, rows)
            g = grid.new(rows, c)
        }
        sim.step(mut s, keys, health)
        if k + 1 >= o.from_tick && (k + 1) % o.every == 0 && k + 1 < o.frames {
            art.render(s, r.tier, mut g)
            write_frame(o.dump, "frame-{pad4(k + 1)}", g) else |_| {
                eprint("pack: cannot write into {o.dump}")
                return 2
            }
        }
        k += 1
    }
    // The last frame is always `final` (the pty runner compares it).
    art.render(s, r.tier, mut g)
    write_frame(o.dump, "final", g) else |_| {
        eprint("pack: cannot write into {o.dump}")
        return 2
    }
    0
}

/// `--apply`: a captured byte stream through the terminal model, the
/// resulting screen written to standard output as text then styles (the
/// pty runner compares it with the headless `final`).
fn run_apply(o: Options) -> int {
    if o.cols == 0 {
        eprint("pack: --apply needs --size WxH")
        return 2
    }
    let bytes = fs.read_bytes(o.apply_path) else |_| {
        eprint("pack: cannot read {o.apply_path}")
        return 2
    }
    var m = grid.model_new(o.rows, o.cols)
    grid.model_feed(mut m, bytes)
    var out = List[byte]()
    grid.dump_text(m.grid, mut out)
    grid.push_str(mut out, "--\n")
    grid.dump_styles(m.grid, mut out)
    grid.push_str(
        mut out,
        "--\nalt_enters {m.alt_enters} alt_leaves {m.alt_leaves} cursor_visible {m.cursor_visible} unknown {m.unknown}\n",
    )
    var tout = fs.stdout()
    fs.write_chunk(mut tout, out) else |_| {
        return 2
    }
    0
}

/// `--art-study`: the sprite sheets on both tiers into `dump`.
fn run_art_study(o: Options) -> int {
    if o.dump == "" {
        eprint("pack: --art-study needs --dump DIR")
        return 2
    }
    fs.create_dir_all(o.dump) else |_| {
        eprint("pack: cannot create {o.dump}")
        return 2
    }
    write_frame(o.dump, "sheet-rich", art.sheet(tier.RICH)) else |_| {
        return 2
    }
    write_frame(o.dump, "sheet-plain", art.sheet(tier.PLAIN)) else |_| {
        return 2
    }
    0
}

/// The environment's tier and colour depth, where the flags left them.
fn pick_tier(o: Options) -> (int, bool) {
    var t = o.tier
    if t < 0 {
        let lang = env.get("LC_ALL") else (env.get("LANG") else "")
        t = tier.detect(env.get("TERM") else "", lang)
    }
    var truecolor = o.truecolor == 1
    if o.truecolor < 0 {
        truecolor = tier.truecolor_of(env.get("COLORTERM") else "")
    }
    (t, truecolor)
}

/// `--probe-glyphs`: each rich code point written to the terminal and the
/// cursor asked where it landed (`CSI 6 n`), the width it took printed
/// as a table after the terminal is restored. The measurement
/// `docs/GLYPHS.md` records per terminal; a photo is not evidence.
fn run_probe(o: Options) -> int {
    var t = term.open() else |e| {
        eprint(term.message("{e}"))
        return 2
    }
    term.enter(mut t) else |_| {
        eprint(term.message("io"))
        return 3
    }
    let cps = tier.rich_code_points()
    var widths = List[int]()
    for cp in cps {
        var probe = List[byte]()
        grid.push_str(mut probe, "\x1b[2;1H\x1b[2K")
        grid.push_utf8(mut probe, cp)
        grid.push_str(mut probe, "\x1b[6n")
        term.write(probe) else |_| {}
        // The reply: ESC [ row ; col R, within 200 ms.
        var col = -1
        var waited = 0
        var reply = List[byte]()
        while col < 0 && waited < 10 {
            var c = clock.new(clock.now_ns())
            let w = clock.wait_until(mut c, clock.now_ns() + 20000000, term.signal_set()) else |_| {
                break
            }
            if w.input_ready {
                let got = term.read_keys(64) else |_| {
                    break
                }
                for b in got {
                    (mut reply).push(b)
                }
                col = cpr_col(reply)
            }
            waited += 1
        }
        (mut widths).push(if col < 0 then -1 else col - 1)
    }
    term.leave(mut t)
    print("code point | width | terminal {t.term_name}")
    var i = 0
    while i < cps.len {
        print("U+{hex4(cps[i])} | {widths[i]} | {string_of(cps[i])}")
        i += 1
    }
    0
}

fn string_of(cp: int) -> str {
    var v = List[byte]()
    grid.push_utf8(mut v, cp)
    str_from_utf8(v) else "?"
}

fn hex4(n: int) -> str {
    let digits = "0123456789ABCDEF"
    var s = ""
    var p = 4096
    while p >= 1 {
        let d = n / p % 16
        s = s + digits[d..d + 1]
        p /= 16
    }
    s
}

/// The column of a cursor position report `ESC [ row ; col R` in `v`, or
/// -1 when none is complete.
fn cpr_col(v: List[byte]) -> int {
    var i = 0
    while i + 3 < v.len {
        if v[i] as int == 27 && v[i + 1] as int == 91 {
            var j = i + 2
            var row = 0
            var col = 0
            var second = false
            while j < v.len {
                let b = v[j] as int
                if b >= 48 && b <= 57 {
                    if second {
                        col = col * 10 + b - 48
                    } else {
                        row = row * 10 + b - 48
                    }
                } else if b == 59 {
                    second = true
                } else if b == 82 {
                    return col
                } else {
                    break
                }
                j += 1
            }
        }
        i += 1
    }
    -1
}

/// `--bench`: `frames` ticks of a scripted steer on a field of `--size`,
/// each frame rendered and diffed as the live loop does (no terminal, no
/// write), the time of render + diff recorded per frame; the average, the
/// 99th percentile and the maximum in microseconds, and the bytes a frame,
/// printed on one line for tools/perf.
fn run_bench(o: Options) -> int {
    let cols = if o.cols > 0 then o.cols else 80
    let rows = if o.rows > 0 then o.rows else 24
    let t = if o.tier < 0 then tier.RICH else o.tier
    var s = sim.new_at(o.seed, cols, rows, if o.start_rows > 0 then o.start_rows else 0)
    if o.bench_shadows > 0 {
        // The perf gate's dozen: shadows chasing around the pack from the
        // first frame (the spawn would take a long run to reach that many).
        sim.seed_shadows(mut s, o.bench_shadows)
    }
    if o.bench_deer > 0 {
        sim.seed_deer(mut s, o.bench_deer)
    }
    var front = grid.new(rows, cols)
    var back = grid.new(rows, cols)
    var pen = grid.pen_new()
    var out = List[byte]()
    var keys = List[int]()
    var times = List[int]()
    var bytes: int = 0
    var k = 0
    while k < o.frames {
        (mut keys).reset()
        if k % 7 == 0 {
            (mut keys).push(sim.KEY_LEFT)
        } else if k % 11 == 0 {
            (mut keys).push(sim.KEY_RIGHT)
        } else if k % 50 == 0 {
            (mut keys).push(sim.KEY_UP)
        }
        sim.step(mut s, keys, 0)
        let r0 = clock.now_ns()
        art.render(s, t, mut back)
        grid.diff(front, back, k == 0, mut pen, mut out, tier.dialect(t, false))
        let r1 = clock.now_ns()
        (mut times).push((r1 - r0) / 1000)
        bytes += out.len
        (mut out).reset()
        let tmp = front
        front = back
        back = tmp
        k += 1
    }
    // Insertion sort for the percentiles: a few hundred frames.
    var i = 1
    while i < times.len {
        var j = i
        while j > 0 && times[j - 1] > times[j] {
            let x = times[j]
            times[j] = times[j - 1]
            times[j - 1] = x
            j -= 1
        }
        i += 1
    }
    var total: int = 0
    for x in times {
        total += x
    }
    let n = times.len
    let p99 = times[n * 99 / 100 - (if n * 99 % 100 == 0 && n > 0 then 1 else 0)]
    print(
        "bench {cols}x{rows} {tier.name(t)} frames {n} avg_us {total / n} p99_us {p99} max_us {times[n - 1]} bytes_avg {bytes / n} shadows {o.bench_shadows} alive_at_end {sim.shadows_alive(s)} deer {o.bench_deer} deer_at_end {sim.deer_alive(s)}",
    )
    0
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn decode_all(s: str, split_at: int) -> List[int] {
    var d = input.new()
    var keys = List[int]()
    let bs = bytes_of(s)
    var i = 0
    while i < bs.len {
        input.feed(mut d, bs[i], if i < split_at then 1000 else 1010, mut keys)
        i += 1
    }
    input.flush(mut d, 1010 + input.ESC_TIMEOUT_MS, mut keys)
    keys
}

fn keys_text(keys: List[int]) -> str {
    var t = ""
    for k in keys {
        t = "{t} {k}"
    }
    t
}

/// `--selftest`: the decoder's table (every control, whole and split at
/// every byte) and the diff property (the model fed the diff shows the
/// next grid) run on THIS binary, the tier that ships. The unit tests run
/// on the checked machine; wolf 0.2.35's release tier miscompiled the
/// decoder's recursive shape while they passed, which is why the shipped
/// binary is held to the same table here. Exit 1 on any mismatch.
fn run_selftest() -> int {
    var bad = 0
    // Each row: the bytes, `|`, the keys wanted (space separated).
    var rows = List[str]()
    (mut rows).push("\x1b[A|1")
    (mut rows).push("\x1b[B|2")
    (mut rows).push("\x1b[C|4")
    (mut rows).push("\x1b[D|3")
    (mut rows).push("\x1bOA|1")
    (mut rows).push("\x1bOB|2")
    (mut rows).push("\x1b[1;2B|5")
    (mut rows).push("\x1b[1;2A|1")
    (mut rows).push("\x1b[1;5B|2")
    (mut rows).push(" |6")
    (mut rows).push("z|5")
    (mut rows).push("Z|5")
    (mut rows).push("q|7")
    (mut rows).push("Q|7")
    (mut rows).push("\x03|8")
    (mut rows).push("-|9")
    (mut rows).push("_|9")
    (mut rows).push("=|10")
    (mut rows).push("+|10")
    (mut rows).push("s|11")
    (mut rows).push("S|11")
    (mut rows).push("r|14")
    (mut rows).push("P|15")
    (mut rows).push("/|16")
    (mut rows).push("\x1b|7")
    (mut rows).push("\x1b |7 6")
    (mut rows).push("\x1b[57;2u|")
    (mut rows).push("\x1b[5~|")
    (mut rows).push("\x1b[D\x1b[1;2B |3 5 6")
    for row in rows {
        let (seq, want_raw) = row.split_once("|") else (row, "")
        let want = if want_raw.len == 0 then "" else " {want_raw}"
        var at = 0
        while at <= seq.len {
            let got = keys_text(decode_all(seq, at))
            if got != want {
                print("selftest: decoder: {describe(seq)} split at {at}: got{got}, want{want}")
                bad += 1
            }
            at += 1
        }
    }
    // The diff property, through the model, in the 256 and the 16 dialects.
    var m = grid.model_new(5, 9)
    var prev = grid.new(5, 9)
    var pen = grid.pen_new()
    var salt = 0
    while salt < 12 {
        var next = grid.new(5, 9)
        var r = 0
        while r < 5 {
            var c = 0
            while c < 9 {
                let k = (r * 7 + c * 13 + salt) % 11
                if k < 7 {
                    grid.put(
                        mut next,
                        r,
                        c,
                        grid.cell(
                            9600 + k,
                            (k * 37 + salt) % 256,
                            if k % 3 == 0 then grid.COLOR_DEFAULT else k * 20,
                            k % 8 & grid.ATTR_MASK,
                        ),
                    )
                }
                c += 1
            }
            r += 1
        }
        var out = List[byte]()
        grid.diff(prev, next, salt == 0, mut pen, mut out, grid.COLORS_256)
        grid.model_feed(mut m, out)
        if !grid.model_equals(m, next) {
            let (dr, dc) = grid.model_first_diff(m, next)
            print("selftest: diff property: frame {salt} differs first at {dr},{dc}")
            bad += 1
        }
        prev = next
        salt += 1
    }
    if bad == 0 {
        print(
            "selftest: ok (the decoder table whole and split at every byte; the diff property over 12 frames)",
        )
        return 0
    }
    print("selftest: {bad} FAILED")
    1
}

fn describe(seq: str) -> str {
    var t = ""
    for b in seq.bytes() {
        t = "{t} {b as int}"
    }
    "bytes{t}"
}

/// The replay's file name when `s` is pressed on the card and `--record`
/// gave none: `pack-SEED-SCORE.pk` in the working directory.
fn card_save_name(seed: int, score: int) -> str {
    "pack-{seed}-{score}.pk"
}

/// Save the recording to `path` with a `quit` at `tick` appended (the card
/// is up at that tick; a replay of the file shows it until then) and the
/// run's score as a `# score N` comment (pk03, R-pk03-2 A). `io` on a
/// failed write; the card then says nothing was saved.
fn save_replay(rec: replay.Replay, tick: int, path: str, score: int) -> () ! {io} {
    var r = copy rec
    replay.push_key(mut r, tick, input.KEY_QUIT)
    var text = List[byte]()
    replay.format_scored(r, score, mut text)
    fs.write_bytes(path, text) else |_| {
        return io
    }
}

/// A path as the best file records it: absolute, so a replay saved in one
/// working directory plays from another.
fn absolute(path: str) -> str {
    if path.starts_with("/") {
        return path
    }
    let cwd = env.cwd() else {
        return path
    }
    "{cwd}/{path}"
}

/// The score a replay reaches, by a headless re-run of the simulation
/// alone (no render) up to its last tick: the state the card's `s` saw.
fn rerun_score(rp: replay.Replay) -> int {
    var s = sim.new_at(rp.seed, rp.cols, rp.rows, rp.start)
    var keys = List[int]()
    let last = replay.last_tick(rp)
    var k = 0
    while k < last {
        (mut keys).reset()
        let (c, rows, health) = replay.at(rp, k, mut keys)
        if c > 0 {
            sim.resize(mut s, c, rows)
        }
        sim.step(mut s, keys, health)
        k += 1
    }
    sim.score(s)
}

/// The verdict on a replay's `# score N` against a headless re-run
/// (R-pk03-2 A): verified, UNVERIFIED with both numbers, or the re-run's
/// score alone when the file carries none. Never silently accepted.
fn verdict_of(rp: replay.Replay, text: str) -> str {
    let got = rerun_score(rp)
    let filed = replay.score_of(text) else {
        return "score {got}, the file carries none"
    }
    if filed == got {
        return "score {got} verified"
    }
    "UNVERIFIED: the file says {filed}, the run gives {got}"
}

/// A replay read for playing from the title (pk03): the file and the
/// verdict. `io` when the file cannot be read, `parse` when it is not a
/// replay.
fn load_for_play(path: str) -> (replay.Replay, str) ! {parse, io} {
    let text = fs.read_text(path) else |_| {
        return io
    }
    let rp = replay.from_text(text)?
    let v = verdict_of(rp, text)
    (rp, v)
}

/// What a run ended with (pk03): why; whether the program leaves (a
/// signal, `--ticks`, a quit with no title to return to, a failed wait or
/// write); the score; whether the pack died; the saved replay's path;
/// the seed; the ticks.
struct Outcome {
    ended: str,
    leave: bool,
    score: int,
    dead: bool,
    saved: str,
    seed: int,
    ticks: int,
}

/// One run on the open terminal: the live loop (one wait a tick on the
/// terminal and the signals, the simulation stepped once a tick, the
/// screen diffed once a frame), to its end. `titled` says a title card is
/// waiting behind it (a quit returns there, else it leaves); `verdict` is
/// a replay's, for the card's last line.
fn play(
    o: Options,
    mut t: term.Term,
    rp: replay.Replay,
    replaying: bool,
    titled: bool,
    verdict: str,
    truecolor: bool,
    record: bool,
) -> Outcome {
    var cols = t.cols
    var rows = t.rows
    if replaying {
        // The replay's size is the field's; the terminal must be at least
        // that (the pty runner sizes it so).
        cols = rp.cols
        rows = rp.rows
    }
    var rec = replay.new(rp.seed, rp.tier, cols, rows)
    rec.start = rp.start
    let dialect = tier.dialect(rp.tier, truecolor)
    var s = sim.new_at(rp.seed, cols, rows, rp.start)
    s.speed_scale = o.speed_scale
    var front = grid.new(rows, cols)
    var back = grid.new(rows, cols)
    var pen = grid.pen_new()
    var out = List[byte]()
    var keys = List[int]()
    var tick_keys = List[int]()
    var d = input.new()
    var c = clock.new(clock.now_ns())
    var full = true
    var quit = false
    var leave = false
    var frames = 0
    var render_ns = 0
    var render_max_ns = 0
    var ended = "the loop"
    var late_ns = 0
    var late_max_ns = 0
    var late_n = 0
    // The trace (`--trace`): the bytes read since the last tick, the wall
    // time the first of this tick's keys arrived (0 for none), and the keys
    // the tick applied, so the frame that carries a key can be named.
    let t0_ns = clock.now_ns()
    var trace_bytes = 0
    var trace_first_key_ns = 0
    // The death card (pk02): once the run is over the world stands still,
    // `s` saves the replay (once) and `q` leaves; other keys are dropped.
    var saved = ""
    var save_failed = false
    loop {
        var deadline = clock.next_due_ns(c)
        if input.esc_pending(d) {
            let esc = input.esc_deadline_ms(d) * 1000000
            if esc < deadline {
                deadline = esc
            }
        }
        let w = clock.wait_until(mut c, deadline, term.signal_set()) else |_| {
            ended = "a failed wait"
            quit = true
            leave = true
            break
        }
        let now = clock.now_ns()
        let now_ms = now / 1000000
        if w.timed_out {
            // How late the tick's wake was against its deadline: the wait's
            // own cost, which the latency bar pays once a key.
            let late = if now > deadline then now - deadline else 0
            late_ns += late
            late_n += 1
            if late > late_max_ns {
                late_max_ns = late
            }
        }
        if w.meaning != 0 {
            if w.meaning == 16384 {
                if term.resize(mut t) && !replaying {
                    cols = t.cols
                    rows = t.rows
                    sim.resize(mut s, cols, rows)
                    front = grid.new(rows, cols)
                    back = grid.new(rows, cols)
                    pen = grid.pen_new()
                    full = true
                    replay.push_size(mut rec, s.tick, cols, rows)
                }
            } else {
                ended = if w.meaning == 16 then "the interrupt" else "a signal ({w.meaning})"
                quit = true
                leave = true
            }
        }
        if w.input_ready {
            let got = term.read_keys(64) else |e| {
                // A hang-up (eof) or a failed read ends the game; say which.
                eprint("pack: standard input: {e}")
                ended = "standard input ({e})"
                quit = true
                leave = true
                List[byte]()
            }
            let before = keys.len
            input.feed_all(mut d, got, now_ms, mut keys)
            trace_bytes += got.len
            if keys.len > before && trace_first_key_ns == 0 {
                trace_first_key_ns = now
            }
        }
        input.flush(mut d, now_ms, mut keys)
        let due = clock.advance(mut c, now)
        var n = 0
        while n < due {
            (mut tick_keys).reset()
            var health = 0
            if replaying {
                let (rc, rr, rh) = replay.at(rp, s.tick, mut tick_keys)
                health = rh
                if rc > 0 {
                    sim.resize(mut s, rc, rr)
                    front = grid.new(rr, rc)
                    back = grid.new(rr, rc)
                    pen = grid.pen_new()
                    full = true
                }
                if s.tick > replay.last_tick(rp) && o.ticks == 0 {
                    ended = "the replay's end"
                    quit = true
                    leave = !titled
                }
                if n == 0 {
                    // The keyboard is ignored during a replay, except that
                    // q, Esc and Ctrl-C leave it (pk03).
                    for k in keys {
                        if k == input.KEY_QUIT || k == input.KEY_INTERRUPT {
                            ended = if k == input.KEY_QUIT {
                                "the quit key"
                            } else {
                                "Ctrl-C as a byte"
                            }
                            quit = true
                            leave = !titled || k == input.KEY_INTERRUPT
                        }
                    }
                }
            } else if n == 0 {
                for k in keys {
                    if k == input.KEY_QUIT || k == input.KEY_INTERRUPT {
                        ended = if k == input.KEY_QUIT then "the quit key" else "Ctrl-C as a byte"
                        quit = true
                        leave = !titled || k == input.KEY_INTERRUPT
                        // Recorded, so a replay of the file ends where the
                        // run did (the card shown for as long as it was).
                        replay.push_key(mut rec, s.tick, k)
                    } else if k == input.KEY_SAVE {
                        if s.dead && saved == "" && !save_failed {
                            let path = if o.record_path != "" {
                                o.record_path
                            } else {
                                card_save_name(rp.seed, sim.score(s))
                            }
                            save_replay(rec, s.tick, path, sim.score(s)) else |_| {
                                save_failed = true
                            }
                            if !save_failed {
                                saved = path
                            }
                        }
                    } else if k == input.KEY_HEALTH_DOWN || k == input.KEY_HEALTH_UP {
                        // The debug keys: health by ten, recorded as a
                        // `health` event; nothing without --debug.
                        if o.debug && !s.dead {
                            let delta = if k == input.KEY_HEALTH_DOWN then -10 else 10
                            health += delta
                            replay.push_health(mut rec, s.tick, delta)
                        }
                    } else if k >= sim.KEY_UP && k <= sim.KEY_LEAP && !s.dead {
                        // The simulation's keys alone are applied and
                        // recorded; the title's keys are dropped in play.
                        (mut tick_keys).push(k)
                        replay.push_key(mut rec, s.tick, k)
                    }
                }
            }
            sim.step(mut s, tick_keys, health)
            if o.trace {
                eprint(
                    "trace tick {s.tick} in {trace_bytes} keys {tick_keys.len} queue {keys.len} steer {sim.steer_target(s)} heading {sim.steer_heading(s)} x {sim.steer_x(s)} y {sim.steer_y(s)} stamina {s.stamina} health {s.health} down {s.down} spawn {sim.spawn_rate(s)} shadows {sim.shadows_alive(s)} landed {s.landed} deer {sim.deer_alive(s)} fed {s.fed} dead {if s.dead then 1 else 0} wall_us {(clock.now_ns() - t0_ns) / 1000}",
                )
                trace_bytes = 0
            }
            if o.trap_at > 0 && s.tick == o.trap_at {
                // The planted trap: a broken contract, as any trap would be.
                // The runtime restores the terminal (`[os.term.restore]`).
                assert(false, "pack: --trap-at {o.trap_at} (a planted trap)")
            }
            if o.ticks > 0 && s.tick >= o.ticks {
                ended = "--ticks"
                quit = true
                leave = true
            }
            n += 1
        }
        if due > 0 {
            // The keys were applied on the first tick above; keys read on a
            // wake with no tick due wait for the next tick (one tick of
            // latency at most). The pty runner's `quit` row caught a reset
            // here that dropped them.
            (mut keys).reset()
            let r0 = clock.now_ns()
            art.render(s, rp.tier, mut back)
            if s.dead && replaying {
                art.card_offer(s, rp.tier, mut back, "replay: {verdict}; q leaves")
            } else if s.dead && saved != "" {
                art.card_with(s, rp.tier, mut back, saved)
            }
            grid.diff(front, back, full, mut pen, mut out, dialect)
            let r1 = clock.now_ns()
            render_ns += r1 - r0
            if r1 - r0 > render_max_ns {
                render_max_ns = r1 - r0
            }
            term.write(out) else |_| {
                ended = "a failed write"
                quit = true
                leave = true
            }
            (mut out).reset()
            let tmp = front
            front = back
            back = tmp
            full = false
            frames += 1
            if o.trace && trace_first_key_ns != 0 {
                // The frame that carries a key: written, so the runner can
                // time from its write to this line (the sound latency,
                // R-pk00-6's shape); `inner_us` is the loop's own share, from
                // the key's read to the frame's write.
                eprint(
                    "trace frame {frames} tick {s.tick} carries_key inner_us {(clock.now_ns() - trace_first_key_ns) / 1000} wall_us {(clock.now_ns() - t0_ns) / 1000}",
                )
                trace_first_key_ns = 0
            }
        }
        if quit {
            break
        }
    }
    if o.record_path != "" && !replaying && record && saved != o.record_path {
        // The run as played, to --record's path, unless the card saved it
        // there already (that file carries the score and ends at the save).
        var text = List[byte]()
        replay.format(rec, mut text)
        fs.write_bytes(o.record_path, text) else |_| {
            eprint("pack: cannot write {o.record_path}")
        }
    }
    let avg_us = if frames > 0 then render_ns / frames / 1000 else 0
    let late_avg_us = if late_n > 0 then late_ns / late_n / 1000 else 0
    eprint(
        "pack: ended by {ended}; {s.tick} ticks, {frames} frames, {c.dropped} dropped, {c.waits} waits, {sim.distance_cells(s)} cells, health {s.health} ({s.down} down), stamina {s.stamina}; shadows {s.spawned} spawned {s.vanquished} vanquished {s.landed} landed {s.turned} turned; deer {s.deer_spawned} seen {s.fed} fed; {if s.dead then "dead at tick {s.died_tick}, score {sim.score(s)}" else "alive, score {sim.score(s)}"}{if saved != "" then ", saved {saved}" else ""}{if save_failed then ", the save FAILED" else ""}{if replaying then "; replay {verdict}" else ""}; render avg {avg_us} us max {render_max_ns / 1000} us; wait late avg {late_avg_us} us max {late_max_ns / 1000} us over {late_n}; seed {rp.seed} tier {tier.name(rp.tier)} {cols}x{rows}{if o.speed_scale != 100 then " speed-scale {o.speed_scale}" else ""}{if rp.start != 0 then " start {rp.start}" else ""}",
    )
    Outcome {
        ended: ended,
        leave: leave,
        score: sim.score(s),
        dead: s.dead,
        saved: saved,
        seed: rp.seed,
        ticks: s.tick,
    }
}

/// The live game: the terminal opened and entered once, the title card
/// (pk03) between runs — the seed, the last score and the best, `any key
/// to run`, `r` the same seed again, `p` the last saved replay, `/` a
/// replay by name, `q` leaves — and the runs. `--replay FILE` and
/// `--no-title` play one run and leave, as every build before pk03 did.
/// The terminal is restored on every path out, the title's included.
fn run_live(o: Options, args: List[str]) -> int {
    var t = term.open() else |e| {
        eprint(term.message("{e}"))
        return 2
    }
    let (tr, truecolor) = pick_tier(o)
    var rp = load_replay(o, t.cols, t.rows) else |e| {
        eprint("pack: the replay could not be read ({e})")
        return 2
    }
    let replaying = o.replay_path != ""
    var verdict = ""
    if replaying {
        let text = fs.read_text(o.replay_path) else ""
        verdict = verdict_of(rp, text)
    } else {
        rp.tier = tr
        if seed_given(args) {
            rp.seed = o.seed
        }
    }
    term.enter(mut t) else |_| {
        eprint(term.message("io"))
        return 3
    }
    if replaying || o.no_title {
        let _ = play(o, mut t, rp, replaying, false, verdict, truecolor, true)
        term.leave(mut t)
        return 0
    }
    // The title card.
    let best_path = best.path() else ""
    var record = best.empty()
    var info = art.title_new(rp.seed)
    if best_path == "" {
        info.message = "no HOME in the environment: the best score is not kept"
    } else {
        record = best.load(best_path) else |_| {
            info.message = "{best_path} does not parse; left alone"
            best.empty()
        }
    }
    refresh_title(mut info, record)
    let dialect = tier.dialect(tr, truecolor)
    var front = grid.new(t.rows, t.cols)
    var back = grid.new(t.rows, t.cols)
    var pen = grid.pen_new()
    var out = List[byte]()
    var keys = List[int]()
    var d = input.new()
    var c = clock.new(clock.now_ns())
    var full = true
    var ran = false
    var leave = false
    var seed = rp.seed
    // --record's file is written by the run that ends on it, until a card
    // saves there: that file is then kept for the session.
    var record_saved = false
    while !leave {
        // The card over the seed's forest at its start.
        let field = sim.new_at(seed, t.cols, t.rows, rp.start)
        if back.rows != t.rows || back.cols != t.cols {
            front = grid.new(t.rows, t.cols)
            back = grid.new(t.rows, t.cols)
            pen = grid.pen_new()
            full = true
        }
        art.render(field, tr, mut back)
        art.title(tr, sim.phase(field), info, t.rows, t.cols, mut back)
        grid.diff(front, back, full, mut pen, mut out, dialect)
        term.write(out) else |_| {
            leave = true
        }
        (mut out).reset()
        let tmp = front
        front = back
        back = tmp
        full = false
        // Wait for a key, a resize or a signal: one wait a second, never
        // a spin; a lone ESC resolves on its timeout.
        var redraw = false
        while !redraw && !leave && keys.len == 0 {
            let now = clock.now_ns()
            var deadline = now + 1000000000
            if input.esc_pending(d) {
                let esc = input.esc_deadline_ms(d) * 1000000
                if esc < deadline {
                    deadline = esc
                }
            }
            let w = clock.wait_until(mut c, deadline, term.signal_set()) else |_| {
                leave = true
                break
            }
            if w.meaning != 0 {
                if w.meaning == 16384 {
                    if term.resize(mut t) {
                        redraw = true
                    }
                } else {
                    leave = true
                }
            }
            if w.input_ready {
                let got = term.read_keys(64) else |_| {
                    leave = true
                    List[byte]()
                }
                input.feed_all(mut d, got, clock.now_ns() / 1000000, mut keys)
            }
            input.flush(mut d, clock.now_ns() / 1000000, mut keys)
        }
        if leave || redraw {
            continue
        }
        // Act on the keys: 0 nothing, 1 run this seed, 2 run the next seed
        // (R-pk03-4 A: the seed advances by one after a run; `r` keeps it),
        // 3 play the last saved replay, 4 play the named one.
        var action = 0
        for k in keys {
            if info.prompt_open {
                if k == input.KEY_ENTER {
                    info.prompt_open = false
                    input.set_text(mut d, false)
                    if info.prompt != "" {
                        action = 4
                    }
                } else if k == input.KEY_QUIT {
                    info.prompt_open = false
                    info.prompt = ""
                    input.set_text(mut d, false)
                } else if k == input.KEY_BACKSPACE {
                    if info.prompt.len > 0 {
                        info.prompt = info.prompt[0..info.prompt.len - 1]
                    }
                } else if k == input.KEY_INTERRUPT {
                    leave = true
                } else {
                    let ch = input.char_of(k)
                    if ch >= 0 && info.prompt.len < 200 {
                        info.prompt += ch as char
                    }
                }
            } else if k == input.KEY_QUIT || k == input.KEY_INTERRUPT {
                leave = true
            } else if k == input.KEY_RESTART {
                action = 1
            } else if k == input.KEY_PLAY {
                action = 3
            } else if k == input.KEY_PROMPT {
                info.prompt_open = true
                info.prompt = ""
                info.message = ""
                input.set_text(mut d, true)
            } else if action == 0 {
                action = if ran then 2 else 1
            }
        }
        (mut keys).reset()
        if leave || action == 0 {
            continue
        }
        if action == 2 {
            seed += 1
        }
        info.seed = seed
        info.message = ""
        if action == 1 || action == 2 {
            var run_rp = replay.new(seed, tr, t.cols, t.rows)
            run_rp.start = rp.start
            let outcome = play(o, mut t, run_rp, false, true, "", truecolor, !record_saved)
            ran = true
            if outcome.saved != "" && outcome.saved == o.record_path {
                record_saved = true
            }
            let date = time.now_iso8601()
            let name = if outcome.saved == "" then "-" else absolute(outcome.saved)
            best.record(mut record, outcome.score, seed, date, name)
            if outcome.saved != "" {
                best.saved_at(mut record, name, outcome.score, seed)
            }
            if best_path != "" {
                best.store(best_path, record) else |_| {
                    info.message = "the best file could not be written: {best_path}"
                }
            }
            info.last_note = if outcome.dead then "" else "left alive"
            leave = outcome.leave
        } else {
            let path = if action == 3 then record.saved else info.prompt
            if path == "" {
                info.message = "no replay saved yet"
                full = true
                continue
            }
            let (loaded, v) = load_for_play(path) else |e| {
                info.message = if "{e}" == "io" {
                    "{path}: cannot be read"
                } else {
                    "{path}: not a replay (parse)"
                }
                full = true
                continue
            }
            let outcome = play(o, mut t, loaded, true, true, v, truecolor, false)
            ran = true
            // The replay's verdict on the message line; the last run's
            // score stays the last.
            info.message = "{best.basename(path)}: {v}"
            leave = outcome.leave
        }
        refresh_title(mut info, record)
        full = true
    }
    term.leave(mut t)
    0
}

/// The title's lines from the record.
fn refresh_title(mut info: art.Title, record: best.Best) {
    info.last_score = record.last_score
    info.best_score = record.best_score
    info.best_seed = record.best_seed
    info.best_date = copy record.best_date
    info.best_name = copy record.best_name
    info.saved = copy record.saved
}

fn main() -> int {
    let args = env.args()
    let o = parse_args(args) else |_| {
        eprint(usage_text())
        return 2
    }
    if o.help {
        print(usage_text())
        return 0
    }
    let refusal = debug_refusal(o)
    if refusal != "" {
        eprint(refusal)
        return 2
    }
    if o.version {
        print("pack 0.3.0 (pk03: the game)")
        return 0
    }
    if o.apply_path != "" {
        return run_apply(o)
    }
    if o.art_study {
        return run_art_study(o)
    }
    if o.probe_glyphs {
        return run_probe(o)
    }
    if o.bench {
        return run_bench(o)
    }
    if o.selftest {
        return run_selftest()
    }
    if o.headless {
        return run_headless(o, args)
    }
    run_live(o, args)
}
