//! world — the forest path from seeded noise (campaign innovation 3). Every
//! question about the world is a pure function of the seed and a world
//! coordinate, so any row can be asked at any time (a resize asks for rows
//! never seen), nothing is stored, and the same seed is the same forest on
//! every machine.
//!
//! Positions are fixed-point: `FP` units a cell. A world row is a
//! cell-sized band of path; the path at a row has a centre and a half
//! width, both from 1-D value noise: lattice points every `LATTICE` rows
//! take a hashed value, and rows between take a smoothstep blend. The
//! texture of the forest and the path at a cell is a hash of the cell.

/// Fixed-point units a cell.
pub const FP: int = 256

/// Rows between noise lattice points: the path bends over this scale
/// (about two seconds of trot).
pub const LATTICE: int = 64

/// A 64-bit mix of two words: the one hash the world uses.
fn mix(a: int, b: int) -> wrapping[u64] {
    let m1: wrapping[u64] = 11400714819323198485
    let m2: wrapping[u64] = 14029467366897019727
    let s: wrapping[u64] = 7046029254386353087
    var h: wrapping[u64] = a as wrapping[u64] * m1 + s
    h = h ^ h >> 29
    h = (h + b as wrapping[u64]) * m2
    h = h ^ h >> 32
    h = h * m1
    h ^ h >> 29
}

/// A hash of `(seed, a, b)` in `[0, n)`; `n` above 0.
pub fn hash(seed: int, a: int, b: int, n: int) -> int {
    let h = mix(seed * 7919 + a, b * 104729 + a)
    let mask: wrapping[u64] = 2147483647
    (h >> 11 & mask) as int % n
}

/// Noise in `[0, FP]` at `row` on channel `ch`: value noise with a
/// smoothstep blend between lattice points.
pub fn noise(seed: int, ch: int, row: int) -> int {
    var k = row / LATTICE
    var r = row - k * LATTICE
    if r < 0 {
        r += LATTICE
        k -= 1
    }
    let a = hash(seed, ch, k, FP + 1)
    let b = hash(seed, ch, k + 1, FP + 1)
    // smoothstep t*t*(3-2t) over t in [0,1], both t and the result in FP.
    let t = r * FP / LATTICE
    let s = t * t / FP * (3 * FP - 2 * t) / FP
    a + (b - a) * s / FP
}

/// The path at `row` in a world `cols` cells wide: its centre and half
/// width, both in FP units. The centre wanders over the middle three
/// eighths of the width (so its steepest bend, smoothstep's 1.5 times the
/// swing over a lattice, stays under a cell a row even with the noise's
/// rounding: a wolf at 45 degrees can follow it); the half width is
/// between a sixteenth and an eighth of the width, never under 3 cells.
pub fn path(seed: int, cols: int, row: int) -> (int, int) {
    let width = cols * FP
    let centre = width * 5 / 16 + noise(seed, 1, row) * (width * 3 / 8) / FP
    var half = width / 16 + noise(seed, 2, row / 2) * (width / 16) / FP
    if half < 3 * FP {
        half = 3 * FP
    }
    (centre, half)
}

/// The sprite kind at a cell outside the path: 0 grass (the verge, within
/// a cell of the edge), 1 trunk, 2 canopy, 3 deep forest. Density rises
/// with distance from the path.
pub fn forest_kind(seed: int, row: int, col: int, dist_cells: int) -> int {
    if dist_cells <= 0 {
        return 0
    }
    let h = hash(seed, row, col, 100)
    if dist_cells <= 2 {
        return if h < 12 then 1 else if h < 55 then 2 else 0
    }
    if dist_cells <= 6 {
        return if h < 10 then 1 else if h < 80 then 2 else 3
    }
    if h < 6 then 1 else if h < 60 then 2 else 3
}

/// A variant for a cell's texture, in `[0, n)`.
pub fn variant(seed: int, row: int, col: int, n: int) -> int {
    hash(seed + 31, col, row, n)
}

/// Whether a path cell carries a mark (one cell in `density` does).
pub fn path_marked(seed: int, row: int, col: int, density: int) -> bool {
    hash(seed + 17, row, col, density) == 0
}
