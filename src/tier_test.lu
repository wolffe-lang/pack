//! member: false
//!
//! The tiers' promises: the plain tier inside Latin-1 and the sixteen
//! colours for every sprite and variant; the rich tier's glyphs all above
//! the ASCII range where they are meant to be; detection.

use grid
use tier

fn test_plain_tier_keeps_its_promise() {
    var s = 0
    while s < tier.SPRITE_COUNT {
        var v = 0
        while v < tier.VARIANT_COUNT {
            let c = tier.glyph(tier.PLAIN, s, v)
            assert(c.cp >= 32 && c.cp <= 255, "sprite {s} variant {v}: cp {c.cp}")
            assert(c.fg <= 15 || c.fg == grid.COLOR_DEFAULT, "sprite {s}: fg {c.fg}")
            assert(c.bg <= 15 || c.bg == grid.COLOR_DEFAULT, "sprite {s}: bg {c.bg}")
            v += 1
        }
        s += 1
    }
}

fn test_rich_tier_colours_are_indices() {
    var s = 0
    while s < tier.SPRITE_COUNT {
        let c = tier.glyph(tier.RICH, s, 0)
        assert(c.fg >= 0 && c.fg <= 255 && c.bg >= 0 && c.bg <= 255, "sprite {s}")
        s += 1
    }
}

fn test_wolf_sprites_sit_on_the_path() {
    let p = tier.glyph(tier.RICH, tier.SP_PATH, 0)
    assert(
        tier.glyph(tier.RICH, tier.SP_WOLF_BODY, 0).bg == p.bg,
        "the wolf's background is the path's",
    )
    assert(
        tier.glyph(tier.PLAIN, tier.SP_WOLF_HEAD, 0).bg ==
            tier.glyph(tier.PLAIN, tier.SP_PATH, 0).bg,
        "plain too",
    )
}

fn test_posture_glyphs_differ_by_band() {
    // The ears: fresh and tired swap the quadrants, spent is flat.
    let fresh_l = tier.glyph(tier.RICH, tier.SP_WOLF_EAR, 0).cp
    let tired_l = tier.glyph(tier.RICH, tier.SP_WOLF_EAR, 2).cp
    let spent_l = tier.glyph(tier.RICH, tier.SP_WOLF_EAR, 4).cp
    assert(fresh_l != tired_l && tired_l != spent_l && fresh_l != spent_l, "three ear shapes")
    assert(spent_l == tier.glyph(tier.RICH, tier.SP_WOLF_EAR, 5).cp, "flat ears are symmetric")
    // The tail: a fresh tail wags, a tired one holds, a spent one is low.
    assert(
        tier.glyph(tier.RICH, tier.SP_WOLF_TAIL, 0).cp !=
            tier.glyph(tier.RICH, tier.SP_WOLF_TAIL, 1).cp,
        "the fresh tail wags",
    )
    assert(
        tier.glyph(tier.RICH, tier.SP_WOLF_TAIL, 4).cp ==
            tier.glyph(tier.RICH, tier.SP_WOLF_TAIL, 5).cp,
        "the tired tail holds",
    )
    assert(
        tier.glyph(tier.PLAIN, tier.SP_WOLF_TAIL, 0).cp !=
            tier.glyph(tier.PLAIN, tier.SP_WOLF_TAIL, 8).cp,
        "plain fresh and spent tails differ",
    )
}

fn test_detect() {
    assert(tier.detect("xterm-256color", "en_US.UTF-8") == tier.RICH, "a UTF-8 xterm is rich")
    assert(tier.detect("linux", "en_US.UTF-8") == tier.PLAIN, "the Linux VT is plain")
    assert(tier.detect("dumb", "en_US.UTF-8") == tier.PLAIN, "dumb is plain")
    assert(tier.detect("xterm", "C") == tier.PLAIN, "no UTF-8 is plain")
    assert(tier.detect("xterm", "C.utf8") == tier.RICH, "utf8 spelled so")
    assert(
        tier.truecolor_of("truecolor") && tier.truecolor_of("24bit") && !tier.truecolor_of(""),
        "COLORTERM",
    )
}

fn test_names_round_trip() {
    assert(
        (tier.of_name(tier.name(tier.RICH)) else -1) == tier.RICH &&
            (tier.of_name(tier.name(tier.PLAIN)) else -1) == tier.PLAIN,
        "names",
    )
    assert((tier.of_name("vivid") else -1) == -1, "an unknown tier is parse")
}

fn test_dialects() {
    assert(tier.dialect(tier.PLAIN, true) == grid.COLORS_16, "plain is sixteen even with COLORTERM")
    assert(
        tier.dialect(tier.RICH, false) == grid.COLORS_256 &&
            tier.dialect(tier.RICH, true) == grid.COLORS_RGB,
        "rich",
    )
}

fn test_shadow_variants_eyes_and_fade() {
    let bright = tier.glyph(tier.RICH, tier.SP_SHADOW_EYE, 0)
    let dim = tier.glyph(tier.RICH, tier.SP_SHADOW_EYE, 1)
    assert(bright.cp == dim.cp && bright.fg != dim.fg, "the eyes pulse by colour, one glyph")
    assert(bright.fg == 196 && dim.fg == 124, "red, and a darker red (PALETTE.md)")
    assert(
        tier.glyph(tier.PLAIN, tier.SP_SHADOW_EYE, 0).fg == 9 &&
            tier.glyph(tier.PLAIN, tier.SP_SHADOW_EYE, 1).fg == 1,
        "plain: bright red and red, the one colour both tiers share",
    )
    let solid = tier.glyph(tier.RICH, tier.SP_SHADOW_BODY, 0).cp
    let dark = tier.glyph(tier.RICH, tier.SP_SHADOW_BODY, 1).cp
    let light = tier.glyph(tier.RICH, tier.SP_SHADOW_BODY, 2).cp
    assert(
        solid == 9608 && dark == 9619 && light == 9617,
        "the fade: full block, dark shade, light shade",
    )
    assert(
        tier.glyph(tier.PLAIN, tier.SP_SHADOW_BODY, 0).cp !=
            tier.glyph(tier.PLAIN, tier.SP_SHADOW_BODY, 2).cp,
        "the plain fade changes the glyph too",
    )
}

fn test_card_cells_need_no_font_row() {
    var cp = 32
    while cp <= 126 {
        let c = tier.card_text(tier.RICH, cp, false)
        assert(c.cp == cp && c.cp <= 255, "text is Latin-1")
        let p = tier.card_text(tier.PLAIN, cp, true)
        assert(p.fg <= 15 && p.bg <= 15, "plain text in the sixteen")
        cp += 1
    }
    let listed = tier.rich_code_points()
    var which = 0
    while which < 3 {
        let f = tier.card_frame(tier.RICH, which).cp
        var found = false
        for k in listed {
            if k == f {
                found = true
            }
        }
        assert(found, "the frame's glyph {f} is in GLYPHS.md's list already")
        assert(tier.card_frame(tier.PLAIN, which).cp <= 126, "the plain frame is ASCII")
        which += 1
    }
}
