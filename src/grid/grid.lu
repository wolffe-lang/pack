//! grid — the cell model: a grid of cells, double-buffered by the caller,
//! and the diff renderer that turns two grids into the fewest terminal
//! bytes. Nothing here reads the terminal or the clock: a frame is a value.
//!
//! A `Cell` is four ints and is `Copy`: a code point, a foreground, a
//! background and the attribute bits. Colours are indices into the 256
//! terminal colours (0-15 the VT colours, 16-231 the cube, 232-255 the
//! greys) or `COLOR_DEFAULT` (256) for the terminal's own; the plain tier
//! never writes an index above 15 (`tier` keeps that promise, and
//! `plain_ok` checks it). The renderer speaks three colour dialects:
//! `COLORS_16` (SGR 30-37, 90-97, 40-47, 100-107: what PAX's console and
//! a Linux VT draw), `COLORS_256` (`38;5;n`) and `COLORS_RGB` (`38;2;r;g;b`
//! from the cube's own RGB, for a terminal whose `COLORTERM` says so).
//!
//! The diff walks both grids once. A cell that differs is written at its
//! position: a cursor move only when the cursor is not already there, an
//! SGR only when the style changed since the last cell written, then the
//! glyph as UTF-8. A full repaint is the diff against a grid of blanks
//! with every cell forced. The cursor is assumed hidden by the caller
//! (`term` hides it), so it is never parked.
//!
//! `model.lu` in this module is the other direction: a small terminal
//! model that applies the bytes to a grid, which the property test and the
//! pty runner use to prove the stream means what the grid says.

/// Bold.
pub const ATTR_BOLD: int = 1

/// Dim.
pub const ATTR_DIM: int = 2

/// Inverse video.
pub const ATTR_INVERSE: int = 4

/// Every attribute bit a cell may carry.
pub const ATTR_MASK: int = 7

/// The terminal's own colour, as a colour index.
pub const COLOR_DEFAULT: int = 256

/// The renderer's 16-colour dialect (the plain tier, PAX, a Linux VT).
pub const COLORS_16: int = 0

/// The renderer's 256-colour dialect (`38;5;n`).
pub const COLORS_256: int = 1

/// The renderer's RGB dialect (`38;2;r;g;b`, the cube's own RGB; the
/// sixteen stay SGR 30-37/90-97, which the terminal themes).
pub const COLORS_RGB: int = 2

/// One cell: a code point, two colour indices (0-255 or `COLOR_DEFAULT`)
/// and attribute bits. Four ints, `Copy`.
pub struct Cell {
    cp: int,
    fg: int,
    bg: int,
    attrs: int,
}

/// A grid of `rows` by `cols` cells, row-major in one list.
pub struct Grid {
    rows: int,
    cols: int,
    cells: List[Cell],
}

/// The blank cell: a space in the terminal's own colours.
pub fn blank() -> Cell {
    Cell { cp: 32, fg: COLOR_DEFAULT, bg: COLOR_DEFAULT, attrs: 0 }
}

/// A cell with the given fields.
pub fn cell(cp: int, fg: int, bg: int, attrs: int) -> Cell {
    Cell { cp: cp, fg: fg, bg: bg, attrs: attrs }
}

/// Whether two cells are the same in every field.
pub fn same(a: Cell, b: Cell) -> bool {
    a.cp == b.cp && a.fg == b.fg && a.bg == b.bg && a.attrs == b.attrs
}

/// Whether two cells share a style (colours and attributes).
pub fn same_style(a: Cell, b: Cell) -> bool {
    a.fg == b.fg && a.bg == b.bg && a.attrs == b.attrs
}

/// A grid of blanks. Traps `assert` when a dimension is below 1.
pub fn new(rows: int, cols: int) -> Grid {
    assert(rows >= 1 && cols >= 1, "grid.new: a grid has at least one cell")
    var cells = List[Cell]()
    (mut cells).reserve(rows * cols)
    var i = 0
    while i < rows * cols {
        (mut cells).push(blank())
        i += 1
    }
    Grid { rows: rows, cols: cols, cells: cells }
}

/// Every cell blank again, the size kept.
pub fn clear(mut g: Grid) {
    var i = 0
    let b = blank()
    while i < g.cells.len {
        g.cells[i] = b
        i += 1
    }
}

/// Every cell set to `c`.
pub fn fill(mut g: Grid, c: Cell) {
    var i = 0
    while i < g.cells.len {
        g.cells[i] = c
        i += 1
    }
}

/// The cell at `row`, `col`; `blank()` outside the grid, so a sprite that
/// hangs off an edge reads as nothing rather than trapping.
pub fn at(g: Grid, row: int, col: int) -> Cell {
    if row < 0 || col < 0 || row >= g.rows || col >= g.cols {
        return blank()
    }
    g.cells[row * g.cols + col]
}

/// Write `c` at `row`, `col`; a write outside the grid is dropped, so a
/// sprite may hang off an edge.
pub fn put(mut g: Grid, row: int, col: int, c: Cell) {
    if row < 0 || col < 0 || row >= g.rows || col >= g.cols {
        return
    }
    g.cells[row * g.cols + col] = c
}

/// Whether every cell of `g` keeps the plain tier's promise: a code point
/// at most 255 and colours at most 15 or the default.
pub fn plain_ok(g: Grid) -> bool {
    for c in g.cells {
        if c.cp > 255 {
            return false
        }
        if c.fg > 15 && c.fg != COLOR_DEFAULT {
            return false
        }
        if c.bg > 15 && c.bg != COLOR_DEFAULT {
            return false
        }
    }
    true
}

/// Append `cp` to `out` as UTF-8 (1 to 4 bytes). A code point outside
/// Unicode or a surrogate is written as U+FFFD.
pub fn push_utf8(mut out: List[byte], cp_in: int) {
    var cp = cp_in
    if cp < 0 || cp > 1114111 || cp >= 55296 && cp <= 57343 {
        cp = 65533
    }
    if cp < 128 {
        (mut out).push(cp as byte)
    } else if cp < 2048 {
        (mut out).push((192 + cp / 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else if cp < 65536 {
        (mut out).push((224 + cp / 4096) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    } else {
        (mut out).push((240 + cp / 262144) as byte)
        (mut out).push((128 + cp / 4096 % 64) as byte)
        (mut out).push((128 + cp / 64 % 64) as byte)
        (mut out).push((128 + cp % 64) as byte)
    }
}

/// Append the decimal digits of `n` (n >= 0) to `out`.
pub fn push_int(mut out: List[byte], n: int) {
    if n < 0 {
        (mut out).push(45 as byte)
        push_int(mut out, 0 - n)
        return
    }
    if n >= 10 {
        push_int(mut out, n / 10)
    }
    (mut out).push((48 + n % 10) as byte)
}

/// Append the bytes of `s` to `out`.
pub fn push_str(mut out: List[byte], s: str) {
    for b in s.bytes() {
        (mut out).push(b)
    }
}

/// The RGB of a 256-colour index, the xterm way: 0-15 the standard
/// palette, 16-231 the 6x6x6 cube with levels 0, 95, 135, 175, 215, 255,
/// 232-255 the greys from 8 to 238 in steps of 10. Anything else is black.
pub fn rgb_of(index: int) -> (int, int, int) {
    if index >= 16 && index <= 231 {
        let i = index - 16
        return (cube_level(i / 36), cube_level(i / 6 % 6), cube_level(i % 6))
    }
    if index >= 232 && index <= 255 {
        let v = 8 + (index - 232) * 10
        return (v, v, v)
    }
    if index >= 0 && index <= 15 {
        return standard_rgb(index)
    }
    (0, 0, 0)
}

fn cube_level(i: int) -> int {
    if i == 0 then 0 else 55 + i * 40
}

fn standard_rgb(i: int) -> (int, int, int) {
    // xterm's defaults for the sixteen; a terminal may theme them.
    match i {
        0 => (0, 0, 0),
        1 => (205, 0, 0),
        2 => (0, 205, 0),
        3 => (205, 205, 0),
        4 => (0, 0, 238),
        5 => (205, 0, 205),
        6 => (0, 205, 205),
        7 => (229, 229, 229),
        8 => (127, 127, 127),
        9 => (255, 0, 0),
        10 => (0, 255, 0),
        11 => (255, 255, 0),
        12 => (92, 92, 255),
        13 => (255, 0, 255),
        14 => (0, 255, 255),
        _ => (255, 255, 255),
    }
}

/// Append `ESC [ row+1 ; col+1 H`.
pub fn push_cup(mut out: List[byte], row: int, col: int) {
    (mut out).push(27 as byte)
    (mut out).push(91 as byte)
    push_int(mut out, row + 1)
    (mut out).push(59 as byte)
    push_int(mut out, col + 1)
    (mut out).push(72 as byte)
}

fn push_color(mut out: List[byte], index: int, bg: bool, dialect: int) {
    (mut out).push(59 as byte)
    if index == COLOR_DEFAULT {
        push_int(mut out, if bg then 49 else 39)
        return
    }
    if dialect == COLORS_16 || index <= 15 {
        var i = index
        if i > 15 {
            i = 7
        }
        let base = if bg then 40 else 30
        if i >= 8 {
            push_int(mut out, base + 60 + i - 8)
        } else {
            push_int(mut out, base + i)
        }
        return
    }
    push_int(mut out, if bg then 48 else 38)
    if dialect == COLORS_RGB {
        let (r, g, b) = rgb_of(index)
        push_str(mut out, ";2;")
        push_int(mut out, r)
        (mut out).push(59 as byte)
        push_int(mut out, g)
        (mut out).push(59 as byte)
        push_int(mut out, b)
    } else {
        push_str(mut out, ";5;")
        push_int(mut out, index)
    }
}

/// Append the SGR that sets `c`'s whole style from a reset: `ESC [ 0`,
/// the attribute bits (1 bold, 2 dim, 7 inverse), the foreground, the
/// background, `m`.
pub fn push_sgr(mut out: List[byte], c: Cell, dialect: int) {
    push_str(mut out, "\x1b[0")
    if c.attrs & ATTR_BOLD != 0 {
        push_str(mut out, ";1")
    }
    if c.attrs & ATTR_DIM != 0 {
        push_str(mut out, ";2")
    }
    if c.attrs & ATTR_INVERSE != 0 {
        push_str(mut out, ";7")
    }
    push_color(mut out, c.fg, false, dialect)
    push_color(mut out, c.bg, true, dialect)
    (mut out).push(109 as byte)
}

/// The renderer's memory between frames: where the terminal's cursor is
/// and what style it last set. `row` -1 means unknown (after a resize, an
/// alternate-screen entry, or a fresh terminal), and `styled` false means
/// the terminal's SGR state is unknown.
pub struct Pen {
    row: int,
    col: int,
    style: Cell,
    styled: bool,
}

/// A pen that knows nothing: the first write moves the cursor and sets
/// the style.
pub fn pen_new() -> Pen {
    Pen { row: -1, col: -1, style: blank(), styled: false }
}

/// Write the cells of `next` that differ from `prev` (or every cell when
/// `full`) to `out`, as the fewest bytes the pen allows: a cursor move
/// when the cursor is elsewhere, an SGR when the style changed, then the
/// glyph. Both grids must have the same size (`assert`). The pen is
/// updated to where the terminal is left.
pub fn diff(prev: Grid, next: Grid, full: bool, mut pen: Pen, mut out: List[byte], dialect: int) {
    assert(prev.rows == next.rows && prev.cols == next.cols, "grid.diff: sizes differ")
    var i = 0
    var row = 0
    while row < next.rows {
        var col = 0
        while col < next.cols {
            let c = copy next.cells[i]
            if full || !same(prev.cells[i], c) {
                if pen.row != row || pen.col != col {
                    push_cup(mut out, row, col)
                }
                if !pen.styled || !same_style(pen.style, c) {
                    push_sgr(mut out, c, dialect)
                    pen.style = copy c
                    pen.styled = true
                }
                push_utf8(mut out, c.cp)
                pen.row = row
                pen.col = col + 1
                if pen.col >= next.cols {
                    // The terminal holds a pending wrap here; the next cell is
                    // never contiguous, so the next write moves the cursor.
                    pen.row = -1
                    pen.col = -1
                }
            }
            i += 1
            col += 1
        }
        row += 1
    }
}

/// The glyph rows of `g` as text, one line per row, each cell its code
/// point in UTF-8: the headless dump's `.txt` file.
pub fn dump_text(g: Grid, mut out: List[byte]) {
    var i = 0
    var row = 0
    while row < g.rows {
        var col = 0
        while col < g.cols {
            push_utf8(mut out, g.cells[i].cp)
            i += 1
            col += 1
        }
        (mut out).push(10 as byte)
        row += 1
    }
}

/// The styles of `g` as text, one line per row, each run of one style as
/// `fg,bg,attrs*count` separated by spaces: the headless dump's `.sty`
/// file. Compact and diffable.
pub fn dump_styles(g: Grid, mut out: List[byte]) {
    var i = 0
    var row = 0
    while row < g.rows {
        var col = 0
        var first = true
        while col < g.cols {
            let c = copy g.cells[i]
            var n = 1
            while col + n < g.cols && same_style(c, g.cells[i + n]) {
                n += 1
            }
            if !first {
                (mut out).push(32 as byte)
            }
            first = false
            push_int(mut out, c.fg)
            (mut out).push(44 as byte)
            push_int(mut out, c.bg)
            (mut out).push(44 as byte)
            push_int(mut out, c.attrs)
            (mut out).push(42 as byte)
            push_int(mut out, n)
            i += n
            col += n
        }
        (mut out).push(10 as byte)
        row += 1
    }
}
