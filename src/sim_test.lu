//! member: false
//!
//! The simulation's bars as tests: determinism, the speeds, the turn
//! rate, the held key, stamina's drain and regeneration, the stop, the
//! forest edge, the formation (slots, lag, wander, no overlap), health as
//! fainting and return, the spawn rate.

use input
use sim
use trail
use std.fs
use replay
use controls
use world

fn none() -> List[int] {
    List[int]()
}

fn one(k: int) -> List[int] {
    var v = List[int]()
    (mut v).push(k)
    v
}

fn run(mut s: sim.Sim, n: int) {
    var i = 0
    while i < n {
        sim.step(mut s, none(), 0)
        i += 1
    }
}

fn same_pack(a: sim.Sim, b: sim.Sim) -> bool {
    var i = 0
    while i < sim.PACK_SIZE {
        let p = copy a.wolves[i]
        let q = copy b.wolves[i]
        if p.x != q.x || p.y != q.y || p.heading != q.heading || p.state != q.state {
            return false
        }
        i += 1
    }
    a.stamina == b.stamina && a.health == b.health && a.px == b.px
}

fn test_two_runs_are_one() {
    var a = sim.new(11, 80, 24)
    var b = sim.new(11, 80, 24)
    var i = 0
    while i < 300 {
        let keys = if i % 17 == 0 {
            one(sim.KEY_LEFT)
        } else if i % 23 == 0 {
            one(sim.KEY_UP)
        } else {
            none()
        }
        let h = if i == 100 then -45 else if i == 200 then 40 else 0
        sim.step(mut a, keys, h)
        sim.step(mut b, keys, h)
        assert(same_pack(a, b), "tick {i}")
        i += 1
    }
}

fn test_trot_advances_at_v() {
    var s = sim.new(1, 80, 24)
    run(mut s, 100)
    assert(s.py == 100 * sim.TROT_V, "the reference's y {s.py}")
    assert(sim.posture(s) == sim.POSTURE_TROT, "trotting")
    // The alpha follows the reference's slot (its wander aside).
    let a = sim.alpha(s)
    assert(
        a.y > 100 * sim.TROT_V - 2 * world.FP && a.y < 100 * sim.TROT_V + 2 * world.FP,
        "the alpha near its slot: {a.y}",
    )
}

fn test_sprint_is_bounded_and_drains() {
    var s = sim.new(1, 80, 24)
    sim.step(mut s, one(sim.KEY_UP), 0)
    var ticks_fast = 0
    var i = 0
    while i < 60 {
        if s.speed > sim.TROT_V {
            ticks_fast += 1
        }
        sim.step(mut s, none(), 0)
        i += 1
    }
    let brake_ticks = (sim.SPRINT_V - sim.TROT_V) / sim.BRAKE + 1
    assert(
        ticks_fast > 0 && ticks_fast <= sim.SPRINT_BURST_TICKS + brake_ticks,
        "fast for {ticks_fast} ticks",
    )
    assert(s.speed == sim.TROT_V, "back to the trot")
    assert(s.stamina < sim.STAMINA_MAX, "stamina spent: {s.stamina}")
}

fn test_speed_never_jumps() {
    var s = sim.new(1, 80, 24)
    var prev = s.speed
    var i = 0
    while i < 120 {
        let keys = if i == 5 {
            one(sim.KEY_UP)
        } else if i == 40 {
            one(sim.KEY_DOWN)
        } else if i == 80 {
            one(sim.KEY_UP)
        } else {
            none()
        }
        sim.step(mut s, keys, 0)
        let d = if s.speed > prev then s.speed - prev else prev - s.speed
        assert(d <= sim.BRAKE, "a jump of {d} at tick {i}")
        prev = s.speed
        i += 1
    }
}

fn test_stop_regenerates_fastest() {
    var s = sim.new(1, 80, 24)
    sim.step(mut s, one(sim.KEY_UP), 0)
    run(mut s, sim.SPRINT_BURST_TICKS)
    let spent = s.stamina
    var standing = sim.new(1, 80, 24)
    standing.stamina = spent
    sim.step(mut standing, one(sim.KEY_DOWN), 0)
    run(mut standing, 30)
    var trotting = sim.new(1, 80, 24)
    trotting.stamina = spent
    run(mut trotting, 31)
    assert(standing.speed == 0 && sim.posture(standing) == sim.POSTURE_STAND, "stopped")
    assert(
        standing.stamina > trotting.stamina,
        "standing {standing.stamina} > trotting {trotting.stamina}",
    )
}

fn test_exhaustion_pants_and_recovers() {
    var s = sim.new(1, 80, 24)
    var i = 0
    while i < 400 && !s.exhausted {
        sim.step(mut s, one(sim.KEY_UP), 0)
        i += 1
    }
    assert(s.exhausted && sim.posture(s) == sim.POSTURE_PANT, "exhausted after {i} ticks")
    assert(sim.band(s) == sim.BAND_SPENT, "spent")
    sim.step(mut s, one(sim.KEY_UP), 0)
    assert(s.sprint_left == 0, "no sprint while panting")
    var j = 0
    while j < 400 && s.exhausted {
        sim.step(mut s, none(), 0)
        j += 1
    }
    assert(!s.exhausted, "recovered after {j} ticks")
}

fn test_bands_follow_stamina() {
    var s = sim.new(1, 80, 24)
    assert(sim.band(s) == sim.BAND_FRESH, "fresh at the start")
    s.stamina = sim.STAMINA_TIRED - 1
    assert(sim.band(s) == sim.BAND_TIRED, "tired below the band")
    s.stamina = sim.STAMINA_SPENT - 1
    assert(sim.band(s) == sim.BAND_SPENT, "spent below the band")
}

fn test_turn_rate_bounds_the_heading_change() {
    var s = sim.new(1, 80, 24)
    var prev = 0
    var i = 0
    while i < 90 {
        sim.step(mut s, if i < 6 then one(sim.KEY_RIGHT) else none(), 0)
        let d = s.heading - prev
        assert(d <= sim.TURN_RATE && d >= 0 - sim.TURN_RATE, "turned {d} in one tick")
        assert(s.heading <= sim.STEER_HEADING, "bounded by the steer")
        prev = s.heading
        i += 1
    }
    assert(s.heading_target == 0 && s.heading == 0, "straight again")
}

fn test_a_tap_holds_for_the_tap_ticks() {
    var s = sim.new(1, 80, 24)
    sim.step(mut s, one(sim.KEY_LEFT), 0)
    var held_ticks = 0
    var i = 0
    while i < 40 {
        if s.heading_target != 0 {
            held_ticks += 1
        }
        sim.step(mut s, none(), 0)
        i += 1
    }
    assert(held_ticks == input.HOLD_TAP_TICKS, "held for {held_ticks} ticks")
}

fn pressed(i: int) -> bool {
    i == 0 || i >= 10 && i <= 70 && (i - 10) % 3 == 0
}

fn test_a_held_run_releases_within_the_interval_and_margin() {
    // The keyboard: a press, the initial delay (10 ticks), then a repeat
    // every 3 ticks for 60 ticks, then nothing.
    var s = sim.new(1, 80, 24)
    var last_press = 0
    var released_at = -1
    var i = 0
    while i < 120 {
        if pressed(i) {
            last_press = i
        }
        sim.step(mut s, if pressed(i) then one(sim.KEY_LEFT) else none(), 0)
        if i >= 20 && i <= 70 {
            assert(s.heading_target == 0 - sim.STEER_HEADING, "held through the run at {i}")
        }
        if i > 70 && released_at < 0 && s.heading_target == 0 {
            released_at = i
        }
        i += 1
    }
    assert(
        released_at > last_press && released_at <= last_press + 3 + input.HOLD_MARGIN + 1,
        "released at {released_at}, the last press at {last_press}",
    )
    assert(s.heading == 0, "straight by tick 120")
}

fn test_both_steer_keys_held_cancel() {
    var s = sim.new(1, 80, 24)
    var keys = List[int]()
    (mut keys).push(sim.KEY_LEFT)
    (mut keys).push(sim.KEY_RIGHT)
    sim.step(mut s, keys, 0)
    assert(s.heading_target == 0, "cancelled")
}

fn test_speed_scale_scales_the_trot() {
    var s = sim.new(1, 80, 24)
    s.speed_scale = 150
    run(mut s, 60)
    assert(s.speed == sim.TROT_V * 3 / 2, "speed {s.speed}")
}

fn test_steering_moves_the_pack_sideways() {
    var s = sim.new(1, 80, 24)
    let x0 = s.px
    let a0 = sim.alpha(s).x
    sim.step(mut s, one(sim.KEY_RIGHT), 0)
    run(mut s, 30)
    assert(s.px > x0, "the reference moved right: {s.px} from {x0}")
    assert(sim.alpha(s).x > a0, "the alpha followed: {sim.alpha(s).x} from {a0}")
}

fn test_the_turn_ripples_back_through_the_pack() {
    // Hold Right: the leaders' heading turns first, the flankers' three
    // ticks later, the alpha's six; a slot lag of zero would turn all five
    // in the same tick (the plant).
    var s = sim.new(1, 80, 24)
    var lead_turned = -1
    var flank_turned = -1
    var alpha_turned = -1
    var i = 0
    while i < 30 {
        sim.step(mut s, if i % 2 == 0 then one(sim.KEY_RIGHT) else none(), 0)
        if lead_turned < 0 && s.wolves[0].heading > 0 {
            lead_turned = i
        }
        if flank_turned < 0 && s.wolves[2].heading > 0 {
            flank_turned = i
        }
        if alpha_turned < 0 && s.wolves[sim.ALPHA].heading > 0 {
            alpha_turned = i
        }
        i += 1
    }
    assert(lead_turned >= 0 && flank_turned >= 0 && alpha_turned >= 0, "all turned")
    assert(
        flank_turned - lead_turned == sim.slot_lag(2) &&
            alpha_turned - lead_turned == sim.slot_lag(sim.ALPHA),
        "lead {lead_turned} flank {flank_turned} alpha {alpha_turned}",
    )
}

fn test_bodies_never_overlap() {
    // Steer hard both ways and sprint over a long run on several seeds;
    // after every tick the separation rule leaves no two bodies overlapping.
    var seed = 1
    while seed <= 2 {
        var s = sim.new(seed, 80, 24)
        var i = 0
        while i < 300 {
            let keys = if i % 90 < 30 {
                one(sim.KEY_LEFT)
            } else if i % 90 < 60 {
                one(sim.KEY_RIGHT)
            } else if i % 90 == 61 {
                one(sim.KEY_UP)
            } else {
                none()
            }
            sim.step(mut s, keys, 0)
            assert(!sim.any_overlap(s), "seed {seed} tick {i}: two bodies overlap")
            i += 1
        }
        seed += 1
    }
}

fn test_the_pack_bumps_and_wanders() {
    // Over a trot the wolves drift off their slots (the wander) and, on
    // some seed, two of them meet and are nudged apart (a bump, counted).
    var bumps = 0
    var drifted = false
    var seed = 1
    while seed <= 4 {
        var s = sim.new(seed, 80, 24)
        var i = 0
        while i < 300 {
            sim.step(mut s, none(), 0)
            var k = 0
            while k < sim.PACK_SIZE {
                let slot_x = s.px + sim.slot_dx(k) * world.FP
                let off = s.wolves[k].x - slot_x
                if off > world.FP || off < 0 - world.FP {
                    drifted = true
                }
                k += 1
            }
            i += 1
        }
        bumps += s.bumps
        seed += 1
    }
    assert(drifted, "a wolf drifted a cell off its slot")
    assert(bumps > 0, "a bump happened on some seed in 1200 ticks")
}

fn test_forest_edge_slows_and_scratches() {
    var s = sim.new(1, 80, 24)
    var i = 0
    while i < 400 && !sim.alpha(s).in_forest {
        sim.step(mut s, one(sim.KEY_LEFT), 0)
        i += 1
    }
    assert(sim.alpha(s).in_forest, "the alpha reached the forest")
    run(mut s, 40)
    assert(s.speed <= sim.FOREST_V, "the pack capped at {s.speed}")
    assert(sim.alpha(s).scratches > 0, "scratched")
    var k = 0
    while k < sim.PACK_SIZE {
        assert(s.wolves[k].x >= world.FP, "never off the screen")
        k += 1
    }
}

fn test_health_floors_faint_the_farthest_and_recovery_returns() {
    var s = sim.new(3, 80, 24)
    run(mut s, 20)
    sim.step(mut s, none(), -25)
    assert(s.down == 1 && s.health == 75, "one down at 75: {s.down}")
    var fainted = -1
    var k = 0
    while k < sim.PACK_SIZE {
        if s.wolves[k].state == sim.FAINTED {
            fainted = k
        }
        k += 1
    }
    assert(fainted >= 0 && fainted != sim.ALPHA, "a wolf, not the alpha, fainted: {fainted}")
    let fy = s.wolves[fainted].y
    run(mut s, 60)
    assert(s.wolves[fainted].y == fy, "the fainted wolf lies where it fell")
    assert(sim.screen_row(s, fainted) > sim.wolf_row(s), "left behind, below the alpha")
    // A second floor: another faints. Then recovery: one returns at a time,
    // each once health is HEALTH_HYST back above the floor that put it down.
    sim.step(mut s, none(), -20)
    assert(s.down == 2, "two down at 55")
    sim.step(mut s, none(), 10)
    assert(s.down == 2, "65 is under the second floor's threshold (70): still two down")
    run(mut s, 5)
    assert(s.down == 2, "hysteresis holds")
    sim.step(mut s, none(), 5)
    assert(s.down == 1, "70 is not; one returned")
    sim.step(mut s, none(), 15)
    assert(s.down == 1, "85 is under the first floor's threshold (90): still one down")
    var returning = -1
    k = 0
    while k < sim.PACK_SIZE {
        if s.wolves[k].state == sim.RETURNING {
            returning = k
        }
        k += 1
    }
    assert(returning >= 0, "a wolf is returning")
    assert(sim.wolf_posture(s, returning) != sim.POSTURE_STAND, "it moves")
    var j = 0
    while j < 400 && s.wolves[returning].state == sim.RETURNING {
        sim.step(mut s, none(), 0)
        j += 1
    }
    assert(s.wolves[returning].state == sim.RUNNING, "back in its slot after {j} ticks")
    assert(j > 10, "the return took time, no teleport: {j} ticks")
}

fn test_return_speed_is_the_sprint() {
    var s = sim.new(3, 80, 24)
    run(mut s, 300)
    sim.step(mut s, none(), -25)
    run(mut s, 200)
    sim.step(mut s, none(), 25)
    var fastest = 0
    var k = 0
    var i = 0
    while i < 60 {
        sim.step(mut s, none(), 0)
        k = 0
        while k < sim.PACK_SIZE {
            if s.wolves[k].state == sim.RETURNING && s.wolves[k].speed > fastest {
                fastest = s.wolves[k].speed
            }
            k += 1
        }
        i += 1
    }
    assert(fastest == sim.RETURN_V, "the return reaches RETURN_V: {fastest}")
}

fn test_health_slows_the_gait() {
    var hurt = sim.new(1, 80, 24)
    sim.step(mut hurt, none(), -90)
    run(mut hurt, 40)
    assert(hurt.speed < sim.TROT_V, "slowed at health {hurt.health}: {hurt.speed}")
    assert(hurt.speed >= sim.TROT_V * 3 / 4, "never below three quarters")
}

fn test_resize_keeps_the_path_position() {
    var s = sim.new(3, 80, 24)
    let frac = s.px * 1000 / (80 * world.FP)
    sim.resize(mut s, 160, 48)
    assert(s.cols == 160 && s.rows == 48, "resized")
    assert(s.px * 1000 / (160 * world.FP) == frac, "same part of the path")
    assert(sim.wolf_row(s) == 48 - sim.WOLF_ROW_FROM_BOTTOM, "the alpha's row follows the bottom")
}

fn test_world_rows_lead_ahead() {
    let s = sim.new(3, 80, 24)
    assert(sim.world_row(s, sim.wolf_row(s)) == 0, "the alpha's row is world row 0")
    assert(sim.world_row(s, 0) == sim.wolf_row(s), "the top shows the rows ahead")
    assert(
        sim.screen_row(s, 0) == sim.wolf_row(s) - sim.slot_dy(0),
        "a leader is ahead on the screen",
    )
}

fn test_spawn_rate_is_the_worlds_at_the_alphas_row() {
    var s = sim.new(3, 80, 24)
    run(mut s, 100)
    assert(
        sim.spawn_rate(s) == trail.spawn_rate(3, sim.distance_cells(s)),
        "the alpha's row feeds the rate: {sim.spawn_rate(s)}",
    )
    assert(trail.spawn_rate(3, 4000) > trail.spawn_rate(3, 0), "and it rises with distance")
}

// The shadows (pk02).

fn shadow_at(s: sim.Sim, row_ahead: int, dx_cells: int, state: int) -> sim.Shadow {
    let a = sim.alpha(s)
    sim.Shadow {
        face_x: 0,
        face_y: -2,
        attack_age: 0,
        attack_dx: 0,
        attack_dy: 0,
        pose_x: 0,
        pose_y: 0,
        x: a.x + dx_cells * world.FP,
        y: a.y + row_ahead * world.FP,
        heading: 0,
        speed: 0,
        dir: -1,
        state: state,
        target: sim.ALPHA,
        windup: 0,
        cooldown: 0,
        recoil: 0,
        fade: 0,
    }
}

fn no_spawn(mut s: sim.Sim) {
    // A seed whose first 300 rolls spawn nothing, so a placed shadow is
    // alone (the roll is the world's hash of the tick; searched once).
    s.seed = 1
}

fn test_spawn_roll_is_the_seeds_and_groups_above_the_rate() {
    var singles = 0
    var groups = 0
    var tick = 0
    while tick < 3000 {
        let n = sim.spawn_roll(9, tick, 4)
        assert(n == 0 || n == 1, "under GROUP_RATE a spawn is one shadow: {n}")
        singles += n
        let g = sim.spawn_roll(9, tick, 12)
        assert(g == 0 || g == 2 || g == 3, "above it two or three: {g}")
        if g > 0 {
            groups += 1
        }
        assert(sim.spawn_roll(9, tick, 4) == n, "the roll is a pure function of the tick")
        tick += 1
    }
    // 4 thousandths over 3000 ticks is 12 expected; 12 thousandths, 36.
    assert(singles >= 4 && singles <= 24, "{singles} single spawns of 12 expected")
    assert(groups >= 18 && groups <= 60, "{groups} group spawns of 36 expected")
}

fn test_shadows_spawn_at_the_edge_ahead_from_the_seed() {
    // Seed 16 starts in a dense stand (the rate near its highest); within
    // 300 ticks at least one shadow has appeared at the forest edge above
    // the top of the screen, and two runs agree on every one of them.
    var a = sim.new(16, 80, 24)
    var b = sim.new(16, 80, 24)
    var first_tick = -1
    var i = 0
    while i < 300 {
        sim.step(mut a, none(), 0)
        sim.step(mut b, none(), 0)
        if first_tick < 0 && a.spawned > 0 {
            first_tick = i
            let sh = copy a.shadows[0]
            let (centre, half) = trail.path(16, 80, sh.y / world.FP)
            let d = if sh.x > centre then sh.x - centre else centre - sh.x
            assert(
                d >= half - 3 * world.FP && d <= half + world.FP / 2,
                "spawn in edge/verge/shoulder band",
            )
            assert(sh.state == sim.LURKING && sh.speed == 0, "a lurker stands still")
            assert(
                sim.shadow_screen_row(a, 0) <= 0,
                "above the alpha's eye: row {sim.shadow_screen_row(a, 0)}",
            )
        }
        assert(a.shadows.len == b.shadows.len, "two runs spawn alike at {i}")
        i += 1
    }
    assert(first_tick >= 0, "seed 16 spawns within 300 ticks")
}

fn test_a_lurker_perceives_within_the_radius_and_not_beyond() {
    var far = sim.new(1, 80, 24)
    no_spawn(mut far)
    (mut far.shadows).push(shadow_at(far, sim.PERCEIVE + 8, 0, sim.LURKING))
    sim.step(mut far, none(), 0)
    assert(far.shadows[0].state == sim.LURKING, "beyond PERCEIVE it lurks on")
    var near = sim.new(1, 80, 24)
    no_spawn(mut near)
    (mut near.shadows).push(shadow_at(near, sim.PERCEIVE + 4, 0, sim.LURKING))
    sim.step(mut near, none(), 0)
    // The leaders are five cells ahead of the alpha: within reach of it.
    assert(near.shadows[0].state == sim.CHASING, "within PERCEIVE of a leader it turns")
}

fn test_a_passed_shadow_decelerates_turns_at_rest_and_chases_at_1_3_v() {
    // A shadow stalking down the path at the stalk speed, already past
    // the leaders and level with the alpha; the pack trots on. It must
    // brake to zero before its direction flips (no pivot), never change
    // speed by more than the brake or heading by more than the turn rate
    // in a tick, and then chase up the path at CHASE_V, closing.
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    var sh = shadow_at(s, -1, 5, sim.CHASING)
    sh.speed = sim.STALK_V
    (mut s.shadows).push(sh)
    var flipped_at = -1
    var speed_at_flip = -1
    var peak_after_flip = 0
    var prev_speed = sim.STALK_V
    var prev_heading = 0
    var prev_dir = -1
    var i = 0
    while i < 200 {
        sim.step(mut s, none(), 0)
        let c = copy s.shadows[0]
        let ds = if c.speed > prev_speed then c.speed - prev_speed else prev_speed - c.speed
        assert(ds <= sim.SHADOW_BRAKE, "speed jumped {ds} at tick {i}")
        let dh = if c.heading > prev_heading {
            c.heading - prev_heading
        } else {
            prev_heading - c.heading
        }
        assert(dh <= sim.SHADOW_TURN_RATE, "heading jumped {dh} at tick {i}")
        if c.dir != prev_dir {
            flipped_at = i
            speed_at_flip = prev_speed
        }
        if flipped_at >= 0 && c.speed > peak_after_flip {
            peak_after_flip = c.speed
        }
        prev_speed = c.speed
        prev_heading = c.heading
        prev_dir = c.dir
        i += 1
    }
    let c = copy s.shadows[0]
    assert(flipped_at > 0, "the direction flipped")
    assert(speed_at_flip <= sim.SHADOW_BRAKE, "it flipped at rest, speed {speed_at_flip}")
    assert(peak_after_flip == sim.CHASE_V, "it chased up the path at 1.3 v: peak {peak_after_flip}")
    // In reach it matches its target's pace (the pack's, slowed by the
    // health its bites cost) rather than overshooting.
    assert(
        c.dir == 1 && c.speed >= sim.TROT_V * 3 / 4 && c.speed <= sim.CHASE_V,
        "dir {c.dir} speed {c.speed}",
    )
    assert(
        c.state == sim.CHASING || c.state == sim.ATTACKING,
        "still after the pack: state {c.state}",
    )
    let a = sim.alpha(s)
    assert(
        c.y <= a.y + sim.REACH * world.FP,
        "it caught the alpha or hangs behind it: {(a.y - c.y) / world.FP} rows back",
    )
}

fn test_a_sprint_shakes_a_chaser_a_trot_does_not() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    var sh = shadow_at(s, -6, 0, sim.CHASING)
    sh.dir = 1
    sh.speed = sim.CHASE_V
    (mut s.shadows).push(sh)
    let gap0 = sim.alpha(s).y - s.shadows[0].y
    run(mut s, 30)
    let gap_trot = sim.alpha(s).y - s.shadows[0].y
    assert(gap_trot < gap0, "at the trot the chaser closes: {gap_trot} from {gap0}")
    sim.step(mut s, one(sim.KEY_UP), 0)
    run(mut s, sim.SPRINT_BURST_TICKS)
    let gap_sprint = sim.alpha(s).y - s.shadows[0].y
    assert(gap_sprint > gap_trot, "a sprint opens the gap: {gap_sprint} from {gap_trot}")
}

fn test_a_shaken_shadow_is_gone_behind_the_alpha() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    (mut s.shadows).push(shadow_at(s, 0 - sim.GONE_ROWS - 1, 0, sim.LURKING))
    sim.step(mut s, none(), 0)
    assert(s.shadows.len == 0, "dropped from the list")
}

fn test_bodies_never_overlap_with_shadows() {
    // Three shadows chasing through the pack over 200 ticks of steering
    // on two seeds: no two bodies, wolf or shadow, overlap after any tick.
    var seed = 1
    while seed <= 2 {
        var s = sim.new(seed, 80, 24)
        var k = 0
        while k < 3 {
            var sh = shadow_at(s, 8 - 4 * k, 0 - 6 + 6 * k, sim.CHASING)
            sh.speed = sim.STALK_V
            (mut s.shadows).push(sh)
            k += 1
        }
        var i = 0
        while i < 200 {
            let keys = if i % 60 < 20 {
                one(sim.KEY_LEFT)
            } else if i % 60 < 40 {
                one(sim.KEY_RIGHT)
            } else {
                none()
            }
            sim.step(mut s, keys, 0)
            assert(!sim.any_overlap(s), "seed {seed} tick {i}: two bodies overlap")
            i += 1
        }
        seed += 1
    }
}

fn test_group_attack_lands_damage_per_shadow_a_lone_one_less() {
    // Two shadows on the alpha's flanks, in reach, cooldowns ready: after
    // the windup each lands DAMAGE (health 100 -> 80). One alone: DAMAGE_LONE.
    var pair = sim.new(1, 80, 24)
    no_spawn(mut pair)
    var l = shadow_at(pair, 0, 0 - sim.REACH, sim.CHASING)
    l.dir = 1
    l.speed = sim.TROT_V
    var r = shadow_at(pair, 0, sim.REACH, sim.CHASING)
    r.dir = 1
    r.speed = sim.TROT_V
    (mut pair.shadows).push(l)
    (mut pair.shadows).push(r)
    var i = 0
    while i < sim.ATTACK_WINDUP + 3 && pair.landed < 2 {
        sim.step(mut pair, none(), 0)
        i += 1
    }
    assert(pair.landed == 2, "both landed: {pair.landed} after {i} ticks")
    assert(pair.health == sim.HEALTH_MAX - 2 * sim.DAMAGE, "health {pair.health}")
    assert(pair.down == 1, "one wolf down at 80")
    var lone = sim.new(1, 80, 24)
    no_spawn(mut lone)
    var o = shadow_at(lone, 0, sim.REACH, sim.CHASING)
    o.dir = 1
    o.speed = sim.TROT_V
    (mut lone.shadows).push(o)
    i = 0
    while i < sim.ATTACK_WINDUP + 3 && lone.landed < 1 {
        sim.step(mut lone, none(), 0)
        i += 1
    }
    assert(
        lone.landed == 1 && lone.health == sim.HEALTH_MAX - sim.DAMAGE_LONE,
        "alone: health {lone.health}",
    )
    // The cooldown: no second landing within ATTACK_COOLDOWN.
    run(mut lone, sim.ATTACK_COOLDOWN - 2)
    assert(lone.landed == 1, "the cooldown holds: {lone.landed}")
}

fn test_leap_vanquishes_in_reach_costs_stamina_and_fades() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    var near = shadow_at(s, 5, 0, sim.CHASING)
    near.dir = 1
    (mut s.shadows).push(near)
    (mut s.shadows).push(shadow_at(s, sim.PERCEIVE + sim.LEAP_REACH + 9, 0, sim.LURKING))
    let st = s.stamina
    sim.step(mut s, one(sim.KEY_LEAP), 0)
    assert(s.shadows[0].state == sim.VANQUISHED, "the near one is vanquished")
    assert(s.shadows[1].state == sim.LURKING, "the far one is not")
    assert(s.vanquished == 1, "counted")
    assert(s.stamina == st - sim.LEAP_STAMINA + sim.REGEN_TROT, "stamina paid: {s.stamina}")
    assert(
        sim.wolf_posture(s, 0) == sim.POSTURE_LEAP && sim.posture(s) != sim.POSTURE_LEAP,
        "first group leaps; alpha holds",
    )
    run(mut s, sim.LEAP_COOLDOWN - 2)
    // Within the cooldown a second leap does nothing.
    (mut s.shadows).push(shadow_at(s, 0, sim.REACH, sim.CHASING))
    let st2 = s.stamina
    sim.step(mut s, one(sim.KEY_LEAP), 0)
    assert(s.vanquished == 1 && s.stamina == st2 + sim.REGEN_TROT, "the cooldown refuses")
    run(mut s, sim.FADE_TICKS)
    assert(s.shadows.len >= 1 && s.shadows[0].state != sim.VANQUISHED, "the first shadow faded")
}

fn test_the_spent_pack_cannot_leap() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    s.stamina = sim.LEAP_STAMINA - 1
    (mut s.shadows).push(shadow_at(s, 0, sim.REACH, sim.CHASING))
    sim.step(mut s, one(sim.KEY_LEAP), 0)
    assert(s.vanquished == 0 && s.shadows[0].state != sim.VANQUISHED, "nothing happens")
    var p = sim.new(1, 80, 24)
    no_spawn(mut p)
    p.exhausted = true
    (mut p.shadows).push(shadow_at(p, 0, sim.REACH, sim.CHASING))
    sim.step(mut p, one(sim.KEY_LEAP), 0)
    assert(p.vanquished == 0, "the pant refuses")
}

fn test_a_parry_turns_a_landing_attack() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    var sh = shadow_at(s, 0, sim.REACH, sim.CHASING)
    sh.dir = 1
    sh.speed = sim.TROT_V
    (mut s.shadows).push(sh)
    // The windup starts on the first tick; parry a few ticks later, inside
    // PARRY_WINDOW of the landing.
    sim.step(mut s, none(), 0)
    assert(s.shadows[0].state == sim.ATTACKING, "winding up")
    run(mut s, 3)
    sim.step(mut s, one(sim.KEY_PARRY), 0)
    run(mut s, sim.ATTACK_WINDUP)
    assert(s.turned == 1 && s.landed == 0, "turned {s.turned} landed {s.landed}")
    assert(s.health == sim.HEALTH_MAX, "no damage")
    let c = copy s.shadows[0]
    assert(c.speed == 0, "the shadow lost its speed")
    assert(c.recoil > 0 || c.y > sim.alpha(s).y + world.FP, "pushed back: recoil {c.recoil}")
    // A parry pressed during the cooldown does nothing.
    sim.step(mut s, one(sim.KEY_PARRY), 0)
    assert(s.parry_until < s.tick, "the cooldown refuses a second window")
}

fn test_a_parry_is_a_press_not_a_stance() {
    var s = sim.new(1, 80, 24)
    sim.step(mut s, one(sim.KEY_PARRY), 0)
    assert(s.parry_until == sim.PARRY_WINDOW, "the window is PARRY_WINDOW ticks from the press")
    run(mut s, sim.PARRY_WINDOW)
    assert(s.tick >= s.parry_until, "and then it is over")
}

fn test_death_at_zero_health_on_the_next_landed_attack_freezes_the_run() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    sim.step(mut s, none(), -100)
    run(mut s, 5)
    assert(
        s.health == 0 && s.down == sim.PACK_SIZE - 1 && !s.dead,
        "the alpha is alone, the run goes on",
    )
    var sh = shadow_at(s, 0, sim.REACH, sim.CHASING)
    sh.dir = 1
    sh.speed = sim.TROT_V
    (mut s.shadows).push(sh)
    var i = 0
    while i < sim.ATTACK_WINDUP + 3 && !s.dead {
        sim.step(mut s, none(), 0)
        i += 1
    }
    assert(s.dead, "the next landed attack ends the run")
    assert(s.died_tick == s.tick - 1, "died at the landing's tick")
    let y = sim.alpha(s).y
    let t = s.tick
    run(mut s, 10)
    assert(sim.alpha(s).y == y, "the world stands still")
    assert(s.tick == t + 10, "the tick keeps counting")
    assert(sim.seconds(s) == s.died_tick / 30, "seconds survived are the death's")
    assert(
        sim.score(s) == s.vanquished * 100 + sim.seconds(s) * 2 + sim.distance_cells(s),
        "the score is the campaign's formula: {sim.score(s)}",
    )
}

fn test_shadow_eyes_dim_pulse_steady() {
    var lurk = shadow_at(sim.new(1, 80, 24), 5, 0, sim.LURKING)
    assert(sim.shadow_eyes(lurk, 0) == 1, "a lurker's eyes are dim")
    lurk.state = sim.CHASING
    assert(
        sim.shadow_eyes(lurk, 0) != sim.shadow_eyes(lurk, sim.EYE_PULSE),
        "a chaser's eyes pulse",
    )
    lurk.state = sim.ATTACKING
    assert(
        sim.shadow_eyes(lurk, 0) == 0 && sim.shadow_eyes(lurk, sim.EYE_PULSE) == 0,
        "an attacker's eyes are steady and bright",
    )
}

// The deer (pk03).

fn deer_at(s: sim.Sim, row_ahead: int, dx_cells: int) -> sim.Deer {
    let a = sim.alpha(s)
    sim.Deer {
        id: 0,
        x: a.x + dx_cells * world.FP,
        y: a.y + row_ahead * world.FP,
        heading: 0,
        speed: 0,
        dir: -1,
        state: sim.DEER_WANDERING,
        stamina: sim.DEER_STAMINA,
        tired: false,
    }
}

fn test_deer_roll_is_the_seeds_and_rarer_than_the_shadows() {
    var deer = 0
    var shadows = 0
    var tick = 0
    while tick < 3000 {
        if sim.deer_roll(9, tick, trail.deer_rate(9, 0)) {
            deer += 1
        }
        if sim.spawn_roll(9, tick, trail.SPAWN_CEILING) > 0 {
            shadows += 1
        }
        assert(
            sim.deer_roll(9, tick, 2) == sim.deer_roll(9, tick, 2),
            "the roll is a pure function of the tick",
        )
        tick += 1
    }
    // 2 to 5 thousandths over 3000 ticks is 6 to 15 expected deer; the
    // ceiling's 12 thousandths is 36 shadow rolls.
    assert(deer >= 2 && deer <= 30, "{deer} deer rolls of 6 to 15 expected")
    assert(shadows > deer, "shadows at the ceiling outnumber the deer: {shadows} to {deer}")
}

fn test_deer_spawn_on_the_path_ahead_from_the_seed() {
    // Seed 11 starts in a clearing, where deer graze (the rate at its
    // highest); within 600 ticks one has appeared on the path above the
    // top of the screen, and two runs agree.
    var a = sim.new(11, 80, 24)
    var b = sim.new(11, 80, 24)
    var first = -1
    var i = 0
    while i < 600 {
        sim.step(mut a, none(), 0)
        sim.step(mut b, none(), 0)
        if first < 0 && a.deer_spawned > 0 {
            first = i
            let d = copy a.deer[0]
            let (centre, half) = trail.path(11, 80, d.y / world.FP)
            let off = if d.x > centre then d.x - centre else centre - d.x
            assert(off <= half, "spawned on the path: {off} inside {half}")
            assert(d.state == sim.DEER_WANDERING, "a grazer")
            assert(sim.deer_screen_row(a, 0) <= 0, "above the alpha's eye")
        }
        assert(a.deer.len == b.deer.len, "two runs spawn alike at {i}")
        i += 1
    }
    assert(first >= 0, "seed 11 spawns a deer within 600 ticks")
}

fn test_a_deer_wanders_at_the_walk_beyond_perception() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    (mut s.deer).push(deer_at(s, sim.DEER_PERCEIVE + 12, 0))
    // Stand the pack so the deer stays out of its perception.
    sim.step(mut s, one(sim.KEY_DOWN), 0)
    var peak = 0
    var i = 0
    while i < 100 {
        sim.step(mut s, none(), 0)
        let d = copy s.deer[0]
        assert(d.state == sim.DEER_WANDERING, "wandering at tick {i}")
        if d.speed > peak {
            peak = d.speed
        }
        i += 1
    }
    assert(peak > 0 && peak <= sim.DEER_WALK_V, "the walk: peak {peak}")
    assert(s.deer[0].stamina == sim.DEER_STAMINA, "walking keeps its stamina")
}

fn test_a_deer_flees_at_1_5_v_away_from_the_pack_under_the_bars() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    // Thirteen rows ahead of the alpha: eight from the leaders, inside
    // DEER_PERCEIVE and outside CATCH_REACH.
    var d0 = deer_at(s, sim.DEER_PERCEIVE + 3, 0)
    d0.dir = 1
    (mut s.deer).push(d0)
    var peak = 0
    var prev_speed = 0
    var prev_heading = 0
    var i = 0
    while i < 60 {
        sim.step(mut s, none(), 0)
        let d = copy s.deer[0]
        assert(d.state == sim.DEER_FLEEING, "fleeing at tick {i}")
        assert(d.dir == 1, "away from the pack: up the path")
        let ds = if d.speed > prev_speed then d.speed - prev_speed else prev_speed - d.speed
        assert(ds <= sim.DEER_BRAKE, "speed jumped {ds} at tick {i}")
        let dh = if d.heading > prev_heading {
            d.heading - prev_heading
        } else {
            prev_heading - d.heading
        }
        assert(dh <= sim.DEER_TURN_RATE, "heading jumped {dh} at tick {i}")
        if d.speed > peak {
            peak = d.speed
        }
        prev_speed = d.speed
        prev_heading = d.heading
        i += 1
    }
    assert(peak == sim.FLEE_V, "it fled at 1.5 v: peak {peak}")
    assert(sim.FLEE_V > sim.TROT_V && sim.FLEE_V < sim.SPRINT_V, "between the trot and the sprint")
    let d = copy s.deer[0]
    assert(d.stamina < sim.DEER_STAMINA, "flight drains: {d.stamina}")
    // It pulled away from a trotting pack.
    assert(d.y - sim.alpha(s).y > (sim.DEER_PERCEIVE + 3) * world.FP, "the gap opened")
}

fn test_a_tired_deer_slows_below_the_trot_and_recovers_walking() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    var d0 = deer_at(s, sim.DEER_PERCEIVE + 3, 0)
    d0.dir = 1
    d0.speed = sim.FLEE_V
    d0.stamina = 2
    (mut s.deer).push(d0)
    run(mut s, 20)
    var d = copy s.deer[0]
    assert(d.tired, "tired once its stamina is spent")
    assert(
        d.speed == sim.DEER_TIRED_V && sim.DEER_TIRED_V < sim.TROT_V,
        "slowed below the trot: {d.speed}",
    )
    // Out of the pack's sight it walks and recovers.
    d.y = sim.alpha(s).y + (sim.DEER_PERCEIVE + sim.DEER_CALM + 19) * world.FP
    s.deer[0] = d
    sim.step(mut s, one(sim.KEY_DOWN), 0)
    run(mut s, sim.DEER_RECOVER + 5)
    let e = copy s.deer[0]
    assert(e.state == sim.DEER_WANDERING, "calm again")
    assert(e.stamina > 0, "walking returns stamina: {e.stamina}")
    run(mut s, sim.DEER_RECOVER * sim.DEER_REGEN_TICKS)
    let f = copy s.deer[0]
    assert(!f.tired && f.stamina >= sim.DEER_RECOVER, "recovered: {f.stamina}")
}

fn test_a_caught_deer_feeds_the_pack_and_a_wolf_returns() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    sim.step(mut s, none(), -25)
    assert(s.health == 75 && s.down == 1, "one wolf down")
    // A deer just ahead of a RUNNING leader (the faint took the farthest
    // wolf, which may be a leader), in reach: brought down this tick.
    let lead = if s.wolves[0].state == sim.FAINTED then copy s.wolves[1] else copy s.wolves[0]
    var d0 = deer_at(s, 0, 0)
    d0.x = lead.x
    d0.y = lead.y + sim.CATCH_REACH * world.FP
    (mut s.deer).push(d0)
    sim.step(mut s, none(), 0)
    assert(s.fed == 1, "fed")
    assert(s.health == 75 + sim.FEED, "health up by FEED: {s.health}")
    assert(s.deer.len == 0, "the deer is gone")
    assert(s.down == 0, "the fainted wolf returns above its threshold")
}

fn test_bodies_never_overlap_with_deer() {
    var s = sim.new(2, 80, 24)
    no_spawn(mut s)
    var k = 0
    while k < 3 {
        (mut s.deer).push(deer_at(s, 7 + 3 * k, 0 - 4 + 4 * k))
        k += 1
    }
    var i = 0
    while i < 150 {
        sim.step(mut s, if i % 40 < 20 then one(sim.KEY_LEFT) else none(), 0)
        assert(!sim.any_overlap(s), "tick {i}: two bodies overlap")
        i += 1
    }
}

fn test_a_deer_far_behind_or_far_ahead_is_gone() {
    var s = sim.new(1, 80, 24)
    no_spawn(mut s)
    (mut s.deer).push(deer_at(s, 0 - sim.GONE_ROWS - 1, 0))
    (mut s.deer).push(deer_at(s, sim.wolf_row(s) + sim.DEER_GONE_MARGIN + 1, 0))
    sim.step(mut s, none(), 0)
    assert(s.deer.len == 0, "both dropped: {s.deer.len} left")
}

fn test_the_curve_is_gentle_first_then_groups_then_a_ceiling() {
    // Whatever the forest, the first SPAWN_RAMP_ROWS rows are a single
    // thousandth; groups (above GROUP_RATE) come only after the ramp has
    // climbed to them (the first forty-five seconds at the trot); the
    // ceiling holds far out, and the second minute is a fight.
    let groups_from = (sim.GROUP_RATE - trail.SPAWN_RAMP_BASE + 1) * trail.SPAWN_RAMP_ROWS
    var seed = 1
    while seed <= 20 {
        var r = 0
        while r < trail.SPAWN_RAMP_ROWS {
            assert(
                trail.spawn_rate(seed, r) <= 1,
                "seed {seed} row {r}: {trail.spawn_rate(seed, r)}",
            )
            r += 7
        }
        r = 0
        while r < groups_from {
            assert(
                trail.spawn_rate(seed, r) <= sim.GROUP_RATE,
                "no groups before row {groups_from}",
            )
            r += 10
        }
        assert(trail.spawn_rate(seed, 5000) == trail.SPAWN_CEILING, "the ceiling at 5000 rows")
        assert(
            trail.spawn_rate(seed, 560) >= 4,
            "the second minute is a fight: {trail.spawn_rate(seed, 560)}",
        )
        seed += 1
    }
    assert(groups_from >= 200, "groups no sooner than forty seconds: row {groups_from}")
    // Seed 16 (a stand) reaches groups within two minutes.
    assert(trail.spawn_rate(16, 560) > sim.GROUP_RATE, "groups by the second minute in a stand")
}

fn test_deer_rate_follows_the_curve_and_the_clearings() {
    assert(trail.deer_rate(11, 0) > trail.deer_rate(16, 0), "more deer in a clearing than a stand")
    assert(trail.deer_rate(7, 5000) > trail.deer_rate(7, 0), "more deer as the shadows come")
    assert(trail.deer_rate(7, 0) >= 1, "never none")
}

fn test_a_spawn_lurks_on_the_outside_of_the_bend() {
    // Search a seed and a row where the path bends more than a cell over
    // the screen's height; the side is the outside (the centre moving
    // right puts the group on the left).
    var found = false
    var seed = 1
    while seed <= 40 && !found {
        var s = sim.new(seed, 80, 24)
        let top = sim.world_row(s, 0) + 1
        let (here, _) = trail.path(seed, 80, 0)
        let (there, _) = trail.path(seed, 80, top)
        if there - here > world.FP {
            assert(sim.spawn_side(s, top) == -1, "seed {seed}: bending right, the left verge")
            found = true
        } else if here - there > world.FP {
            assert(sim.spawn_side(s, top) == 1, "seed {seed}: bending left, the right verge")
            found = true
        }
        seed += 1
    }
    assert(found, "some seed of forty bends at its start")
}

// Dusk and the start (pk03).

fn test_the_phase_follows_the_distance_slowly() {
    assert(sim.phase_at(0) == 0 && sim.phase_at(sim.DUSK_START) == 0, "afternoon until DUSK_START")
    assert(sim.phase_at(sim.DUSK_FULL) == 256, "dusk at DUSK_FULL")
    assert(sim.phase_at(sim.NIGHT_FULL) == 512 && sim.phase_at(99999) == 512, "night, and it holds")
    var prev = 0
    var r = 0
    while r <= sim.NIGHT_FULL + 100 {
        let ph = sim.phase_at(r)
        assert(ph >= prev && ph - prev <= 2, "a slow climb at row {r}: {prev} to {ph}")
        prev = ph
        r += 1
    }
}

fn test_a_run_can_start_up_the_path() {
    var s = sim.new_at(7, 80, 24, 1200)
    assert(sim.distance_cells(s) == 1200, "the alpha at row 1200: {sim.distance_cells(s)}")
    assert(sim.phase(s) == 256, "full dusk there")
    assert(sim.spawn_rate(s) == trail.spawn_rate(7, 1200), "the curve read there")
    let (centre, half) = trail.path(7, 80, 1200)
    let a = sim.alpha(s)
    assert(a.x >= centre - half && a.x <= centre + half, "on the path at row 1200")
    run(mut s, 10)
    assert(sim.distance_cells(s) > 1200, "and it moves on")
}

fn test_pk04_speed_preserves_the_maintainers_ticks_and_wear_down() {
    assert(sim.TROT_V == 46 && sim.SPRINT_V == 83 && sim.RETURN_V == 83, "15 percent faster")
    assert(
        sim.FOREST_V == 23 && sim.FLEE_V == 69 && sim.DEER_TIRED_V == 37 && sim.DEER_WALK_V == 18,
        "deer match",
    )
    assert((sim.TROT_V + sim.ACCEL - 1) / sim.ACCEL == 10, "ten ticks to trot")
    assert((sim.TROT_V + sim.BRAKE - 1) / sim.BRAKE == 5, "five ticks to stop")
    assert(sim.CHASE_V == 52 && sim.STALK_V == 20, "shadows unchanged")
    assert(
        sim.DEER_STAMINA == 90 && sim.DEER_REGEN_TICKS == 3 && sim.DEER_RECOVER == 60,
        "wear-down unchanged",
    )
    assert(sim.DEER_PERCEIVE == 10 && sim.DEER_CALM == 6, "flight hysteresis unchanged")
    assert(
        sim.DUSK_START == 600 && sim.DUSK_FULL == 1200 && sim.NIGHT_FULL == 1800,
        "dusk rows unchanged",
    )
}

fn test_pk04_detection_cone_contact_and_outward_spawn_bands() {
    var s = sim.new(1, 80, 24)
    var sh = shadow_at(s, 15, 0, sim.LURKING)
    sh.face_x = 2
    sh.face_y = 0
    assert(sim.shadow_perceives(sh, sh.x + 8 * world.FP, sh.y), "forward edge of range")
    assert(!sim.shadow_perceives(sh, sh.x + 9 * world.FP, sh.y), "beyond range")
    assert(!sim.shadow_perceives(sh, sh.x - 4 * world.FP, sh.y), "not behind")
    assert(sim.shadow_perceives(sh, sh.x - 3 * world.FP, sh.y), "contact all round")
    assert(
        sim.shadow_perceives(sh, sh.x + 4 * world.FP, sh.y + 6 * world.FP),
        "inside sixty degrees",
    )
    assert(
        !sim.shadow_perceives(sh, sh.x + 3 * world.FP, sh.y + 6 * world.FP),
        "outside sixty degrees",
    )
    var bands = List[int]()
    (mut bands).push(0)
    (mut bands).push(0)
    (mut bands).push(0)
    var facings = List[int]()
    var j = 0
    while j < 5 { (mut facings).push(0); j += 1 }
    var seed = 1
    while seed <= 100 {
        s.seed = seed
        var side = -1
        while side <= 1 {
            let c = sim.lurker(s, 30, side)
            assert(c.face_x * side <= 0, "never facing into woods")
            assert(c.face_x != 0 || c.face_y != 0, "nonzero facing")
            let band = sim.spawn_band(seed, 0, 30)
            bands[band] += 1
            let face = if c.face_x == 0 {
                (if c.face_y < 0 then 0 else 4)
            } else if c.face_y < 0 {
                1
            } else if c.face_y == 0 {
                2
            } else {
                3
            }
            facings[face] += 1
            assert(c.x == sim.lurker(s, 30, side).x, "seed-pure columns")
            side += 2
        }
        seed += 1
    }
    for n in bands { assert(n > 10, "all three bands represented") }
    for n in facings { assert(n > 10, "all five outward facings represented") }
}

fn test_pk04_detection_considers_every_visible_wolf() {
    var s = sim.new(1, 80, 24)
    var sh = shadow_at(s, 0, 0, sim.LURKING)
    sh.face_x = 0
    sh.face_y = 2
    // Alpha behind at four cells; leaders in front at five cells.
    sh.y = sim.alpha(s).y + 4 * world.FP
    var w = copy s.wolves[0]
    w.y = sh.y + 5 * world.FP
    w.x = sh.x
    s.wolves[0] = w
    assert(sim.perceived_wolf(s, sh) >= 0, "a hidden nearest wolf cannot mask a visible one")
}

fn test_pk04_pack_leap_alternates_moves_and_holds_formation() {
    var s = sim.new(7, 80, 24)
    var control = sim.new(7, 80, 24)
    sim.step(mut s, one(sim.KEY_LEAP), 0)
    sim.step(mut control, none(), 0)
    assert(s.leap_group == 0 && s.leap_next_group == 1, "leaders leap first")
    assert(s.leap_x[3] == 0 && s.leap_y[3] == 0 && s.leap_y[4] == 0, "other group holds")
    assert(s.leap_tell && s.leap_y[0] == 0, "a compass tell before travel")
    assert(s.wolves[4].y == control.wolves[4].y && s.speed == control.speed, "no whole-pack sprint")
    sim.step(mut s, one(sim.KEY_LEAP), 0)
    assert(s.leap_group == 0 && s.leap_next_group == 1, "refused leap does not alternate")
    run(mut s, sim.LEAP_COOLDOWN - 2)
    sim.step(mut s, one(sim.KEY_LEAP), 0)
    assert(s.leap_group == 1 && s.leap_next_group == 0, "alpha leaps second")
    assert(sim.wolf_posture(s, sim.ALPHA) == sim.POSTURE_LEAP, "alpha's turn")
    assert(s.leap_x[0] == 0 && s.leap_y[0] == 0, "leaders hold second time")
    assert(sim.LEAP_COOLDOWN == 14 && sim.LEAP_TICKS == 8, "2.14 leaps/s burst rhythm")
    var age = 0
    while age < sim.LEAP_TICKS {
        sim.step(mut s, none(), 0)
        assert(!sim.any_pose_overlap(s), "animated bodies never overlap")
        age += 1
    }
    assert(s.leap_landing && s.leap_y[4] == 0, "one-tick landing, back in formation")
    sim.step(mut s, none(), 0)
    assert(!s.leap_landing, "landing mark expires next tick")
}

fn test_pk04_shared_arc_is_bounded_out_and_back() {
    var tick = 0
    var prev = 0
    while tick <= 8 {
        let (x, y) = sim.leap_arc(0, 2000, tick, 8)
        assert(x == 0 && y >= 0 && y <= 2 * world.FP, "two-cell apex")
        let dy = if y > prev then y - prev else prev - y
        assert(dy <= world.FP / 2, "half a cell a tick")
        prev = y
        tick += 1
    }
    assert(prev == 0, "returned")
    let (x, y) = sim.leap_arc(-2000, 0, 6, 12)
    assert(x == -3 * world.FP && y == 0, "same arc, shadow's three-cell apex")
}

fn test_pk04_shadow_lunge_has_six_crouch_ticks_and_six_travelling_ticks() {
    var s = sim.new(1, 80, 24)
    var sh = shadow_at(s, 0, sim.REACH, sim.CHASING)
    sh.dir = 1
    sh.speed = sim.TROT_V
    (mut s.shadows).push(sh)
    sim.step(mut s, none(), 0)
    assert(
        sim.ATTACK_WINDUP == 12 && sim.ATTACK_LUNGE_TICKS == 6 && sim.PARRY_WINDOW == 12,
        "readable two-beat",
    )
    var tick = 1
    var retreated = false
    var advanced = false
    while tick <= sim.ATTACK_WINDUP {
        sim.step(mut s, none(), 0)
        let c = copy s.shadows[0]
        if tick <= 6 {
            assert(c.attack_age == 0, "six crouch beats before the lunge")
            if c.pose_x != 0 || c.pose_y != 0 { retreated = true }
        } else {
            assert(c.attack_age == tick - 6, "one shared-arc step per lunge tick")
            if c.pose_x > 0 || c.pose_y != 0 { advanced = true }
        }
        assert(!sim.any_pose_overlap(s), "crouch and lunge cannot pass through a body")
        tick += 1
    }
    assert(retreated && advanced && s.landed == 1, "gathered, travelled and bit on final tick")
}

fn test_pk04_fixed_offset_parry_is_turned_at_the_landing() {
    var s = sim.new(1, 80, 24)
    var sh = shadow_at(s, 0, sim.REACH, sim.CHASING)
    sh.dir = 1
    sh.speed = sim.TROT_V
    (mut s.shadows).push(sh)
    sim.step(mut s, none(), 0)
    run(mut s, 1)
    sim.step(mut s, one(sim.KEY_PARRY), 0)
    run(mut s, 10)
    assert(s.turned == 1 && s.landed == 0, "ten ticks before landing still turns it")
    assert(
        s.shadows[0].recoil > 0 && sim.shadow_eyes(s.shadows[0], s.tick) == 1,
        "recoil stays dim",
    )
}

fn test_pk04_all_animated_bodies_stay_separate_in_a_fight_and_resize() {
    var s = sim.new_at(16, 80, 24, 600)
    var t = 0
    while t < 260 {
        var keys = none()
        if t % 17 == 0 { (mut keys).push(sim.KEY_LEAP) }
        if t % 47 == 0 { (mut keys).push(sim.KEY_PARRY) }
        if t == 200 { sim.resize(mut s, 100, 30) }
        sim.step(mut s, keys, 0)
        s.stamina = sim.STAMINA_MAX
        assert(!sim.any_pose_overlap(s), "no animated overlap in live fight")
        t += 1
    }
}

fn test_pk04_actual_stop_and_restart_keep_five_and_ten_ticks() {
    var s = sim.new(11, 200, 60)
    var t = 0
    while t < 4 {
        sim.step(mut s, if t == 0 then one(sim.KEY_DOWN) else none(), 0)
        assert(s.speed > 0, "not stopped before the fifth tick")
        t += 1
    }
    sim.step(mut s, none(), 0)
    assert(s.speed == 0, "stopped on fifth tick")
    s.stopping = false
    t = 0
    while t < 9 {
        sim.step(mut s, none(), 0)
        assert(s.speed < sim.TROT_V, "not at trot before tenth tick")
        t += 1
    }
    sim.step(mut s, none(), 0)
    assert(s.speed == sim.TROT_V, "at trot on tenth tick")
}

fn test_pk04_re_recorded_terminal_replays_verify_their_scores() {
    for name in ["card", "title"] {
        let text = fs.read_text("tests/replays/pk04-{name}.pk") else |_| {
            assert(false, "recorded terminal replay must exist")
            ""
        }
        let rp = replay.from_text(text, controls.vocab()) else |_| {
            assert(false, "recorded terminal replay must parse")
            replay.new(16, 1, 80, 24)
        }
        let expected = replay.score_of(text) else -1
        assert(expected == 51, "newly recorded score, not an old accepted score")
        var s = sim.new_at(rp.seed, rp.cols, rp.rows, rp.start)
        var keys = none()
        var tick = 0
        while tick < replay.last_tick(rp) {
            (mut keys).reset()
            let (cols, rows, health) = replay.at(rp, tick, mut keys)
            if cols > 0 { sim.resize(mut s, cols, rows) }
            sim.step(mut s, keys, health)
            tick += 1
        }
        assert(
            s.dead && sim.score(s) == expected,
            "the real terminal replay verifies at the current constants",
        )
    }
}
