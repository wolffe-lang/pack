//! trail — what pack lays over the engine's forest: the path, and the
//! rates the shadows and the deer spawn at. Every answer is a pure
//! function of the seed and a world row, read through the engine's noise
//! (`world`, campaign innovation 3), so any row can be asked at any time
//! and the same seed is the same path on every machine.
//!
//! The path at a row has a centre and a half width from the noise's
//! channels 1 and 2; the forest's density (the engine's third channel)
//! widens it in a clearing and narrows it in a stand, and the spawn rate
//! pk02 reads rises with distance and with density, so the forest feels
//! like one place.

use world

/// The path at `row` in a world `cols` cells wide: its centre and half
/// width, both in world.FP units. The centre wanders over the middle three
/// eighths of the width (so its steepest bend, smoothstep's 1.5 times the
/// swing over a lattice, stays under a cell a row even with the world.noise's
/// rounding: a wolf at 45 degrees can follow it); the half width is
/// between a sixteenth and an eighth of the width from its own channel,
/// plus up to a thirty-second of the width where the forest is thin (the
/// world.density's complement), never under 3 cells.
pub fn path(seed: int, cols: int, row: int) -> (int, int) {
    let width = cols * world.FP
    let centre = width * 5 / 16 + world.noise(seed, 1, row) * (width * 3 / 8) / world.FP
    var half = width / 16 + world.noise(seed, 2, row / 2) * (width / 16) / world.FP
    half += (world.FP - world.density(seed, row)) * (width / 32) / world.FP
    if half < 3 * world.FP {
        half = 3 * world.FP
    }
    (centre, half)
}

/// The shadows' spawn rate at `row`, in thousandths of a shadow a tick:
/// the difficulty curve (pk03). A base that rises with the distance
/// travelled (one more thousandth every `SPAWN_DISTANCE` rows) and with
/// the forest's world.density at the row (up to `SPAWN_DENSITY` more in a dense
/// stand), held under a ramp from the start (`SPAWN_RAMP_BASE` plus one
/// every `SPAWN_RAMP_ROWS` rows: a gentle first minute whatever the
/// forest) and under `SPAWN_CEILING`. Groups come above `sim.GROUP_RATE`.
/// Logged under `--trace` as `spawn`; rolled each tick against the
/// world's world.hash of the tick (pk02).
pub fn spawn_rate(seed: int, row: int) -> int {
    let ahead = if row > 0 then row else 0
    var rate = SPAWN_BASE +
        ahead / SPAWN_DISTANCE +
        world.density(seed, row) * SPAWN_DENSITY / world.FP
    let ramp = SPAWN_RAMP_BASE + ahead / SPAWN_RAMP_ROWS
    if rate > ramp {
        rate = ramp
    }
    if rate > SPAWN_CEILING {
        rate = SPAWN_CEILING
    }
    rate
}

/// The spawn rate at the start, thousandths a tick.
pub const SPAWN_BASE: int = 1

/// Rows per added thousandth.
pub const SPAWN_DISTANCE: int = 120

/// The world.density's whole contribution, thousandths a tick.
pub const SPAWN_DENSITY: int = 6

/// The ramp's start: the rate can be no more than this at row 0, however
/// dense the forest.
pub const SPAWN_RAMP_BASE: int = 1

/// Rows per added thousandth of the ramp: 70 is fifteen seconds at the
/// trot, so a dense start reaches groups (above `sim.GROUP_RATE`) after
/// the first minute and a clearing later.
pub const SPAWN_RAMP_ROWS: int = 50

/// The curve's ceiling, thousandths a tick: a shadow every 2.8 s on
/// average, in groups.
pub const SPAWN_CEILING: int = 12

/// The deer's rate at `row`, thousandths of a deer a tick (pk03): a base,
/// a share of the shadows' rate (so a long run is survivable with deer and
/// not without), and more in a clearing, where deer graze.
pub fn deer_rate(seed: int, row: int) -> int {
    DEER_BASE +
        spawn_rate(seed, row) / DEER_PER_SHADOW +
        (world.FP - world.density(seed, row)) * DEER_CLEARING / world.FP
}

/// The deer rate's base, thousandths a tick.
pub const DEER_BASE: int = 2

/// The shadows' rate over this is added to the deer's.
pub const DEER_PER_SHADOW: int = 4

/// The clearing's whole contribution to the deer rate, thousandths a tick.
pub const DEER_CLEARING: int = 3
