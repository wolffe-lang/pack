//! sim — the pack on the path: five wolves in formation, steered as one,
//! stepped once a tick from the keys that arrived, and nothing else. No
//! clock, no randomness but the seed (the world's), integer arithmetic
//! only, so a run is a pure function of (seed, inputs, size) and the same
//! bytes on every machine (campaign rule 3).
//!
//! Every creature has a position, a heading, a speed, an acceleration and
//! a maximum turn rate (the realism bars): nothing teleports, nothing
//! pivots. The numbers are the named constants below, mirrored in
//! `docs/DESIGN.md` with the date they were last tuned (R-PK-7: tuning is
//! the maintainer's, by play). Units: positions and speeds in `world.FP`
//! units a cell (a tick), headings in `HEADING_MAX`ths of a 45-degree
//! turn, stamina and health in points.
//!
//! **The formation** (R-pk01-2 C, the maintainer's ruling): a reference
//! point moves under the steer at lag zero; each wolf has a slot relative
//! to it (two leading, two flanking, the alpha trailing at the centre), its
//! own heading that follows the steer `slot_lag` ticks late (so a turn
//! ripples back through the pack), its own speed, a seeded wander around
//! its slot, a bounded pull toward the slot, and a separation rule: two
//! bodies that would overlap are nudged apart, never through each other.
//!
//! **Health** is the pack's (campaign): at each floor the farthest wolf
//! faints and is left behind as the world scrolls past; at each recovery
//! threshold a fainted wolf sprints back from the bottom edge to its slot
//! (R-pk01-3 A: at `RETURN_V`). Health moves by the shadows' landed attacks
//! (pk02), by the replay's `health` events (the goldens) and by the debug
//! keys. **Stamina** is one value for the pack (R-pk01-1 A): an exhausted
//! pack pants, and cannot sprint or leap.
//!
//! **The shadows** (pk02, M-PK2). A shadow wolf has the wolves' realism
//! bars: a position, a lateral heading turned at `SHADOW_TURN_RATE`
//! (R-pk02-1 A: the wolves' rate), a speed moved at `SHADOW_ACCEL` and
//! `SHADOW_BRAKE`, and a direction along the path. Shadows are the seed's:
//! each tick the world's hash of the tick is rolled against
//! `world.spawn_rate` (thousandths a tick) and a shadow appears at the
//! forest edge just above the top of the screen — alone, or in a group of
//! two or three once the rate passes `GROUP_RATE` — and lurks there, eyes
//! on the path. A lurking shadow that sees a pack member within `PERCEIVE`
//! cells turns toward it and stalks down the path at `STALK_V`; once the
//! pack is past it, it decelerates, its direction flips only when its speed
//! has reached zero (no pivot), and it chases at `CHASE_V` = 1.3 v, faster
//! than the trot and slower than the sprint, so a sprint shakes it and a
//! trot does not. Chasing shadows flock: separation (the pack's rule, now
//! over every pair of bodies), cohesion toward the shadows within
//! `FLOCK_CELLS`, and pursuit of the nearest pack member. A shadow within
//! `REACH` of its target winds up an attack over `ATTACK_WINDUP` ticks and
//! lands it if the target is still in reach: `DAMAGE` to the pack's health
//! when another shadow is in reach too (a group attack lands once per
//! shadow in it, R-pk02-2 A), `DAMAGE_LONE` alone; then `ATTACK_COOLDOWN`.
//! A shadow more than `GONE_ROWS` behind the alpha is gone.
//!
//! **The leap** (Space) aims the alternating group with the held arrows:
//! `LEAP_STAMINA` paid, a one-tick compass tell, then an eight-tick arc.
//! Targets within `LEAP_REACH_AIM` in its ±45-degree sector or within
//! `LEAP_REACH` all round are vanquished (fading over `FADE_TICKS`). The
//! arc changes no physics, camera or gait; the spent pack cannot leap — the
//! pant refuses and nothing happens. **The parry** (Shift+Down or `z`) is
//! a press, never a stance: for `PARRY_WINDOW` ticks any attack that lands
//! is turned (no damage; the shadow recoils `PARRY_PUSH` cells over
//! `PARRY_RECOIL` ticks and loses its speed), then `PARRY_COOLDOWN`
//! (R-pk02-3 A). **Death**: at health 0 the alpha is alone, and the next
//! landed attack ends the run (`dead`, `died_tick`); the simulation then
//! stands still while the tick keeps counting for the card.
//!
//! The alpha's eye (innovation 2): the alpha sits `WOLF_ROW_FROM_BOTTOM`
//! rows above the bottom of the screen, and the screen shows the path
//! ahead; `world_row` maps a screen row to a world row.

use input
use trail
use world

/// Trot speed `v`: 46 FP/tick, 5.39 cells/s. The maintainer's word
/// (2026-10-25): "only 15 % faster" than pk01's migrating trot of 40.
/// ACCEL 5 and BRAKE 10 preserve ten ticks to trot and five to stop.
pub const TROT_V: int = 46

/// Sprint speed, 1.8 v (the campaign's bar): a bounded burst, clearly
/// faster than the trot.
pub const SPRINT_V: int = 83

/// The speed a fainted wolf returns at (R-pk01-3 A: the sprint).
pub const RETURN_V: int = 83

/// The speed cap in the forest edge, v/2.
pub const FOREST_V: int = 23

/// Acceleration, FP units a tick each tick: the trot from a stop in 10 ticks.
pub const ACCEL: int = 5

/// Braking, FP units a tick each tick (a wolf stops faster than it starts).
pub const BRAKE: int = 10

/// The heading's reference: 64 is 45 degrees off the path's axis (the
/// small-angle split of the speed is written against it).
pub const HEADING_MAX: int = 64

/// The heading a held steer key turns toward: 48 is 34 degrees, enough to
/// follow the path's steepest bend at the trot (world.path's bound).
pub const STEER_HEADING: int = 48

/// The maximum turn rate, heading units a tick: full steer in 4 ticks and
/// straight again in 4 (133 ms) once the key is released. pk00 relaxed
/// the heading one unit a tick after a tap and left the wolf drifting for
/// two seconds; this is the realism bar's decay, and it is the whole of
/// the residual motion after a release (the maintainer's ruling, 2026-10-25).
pub const TURN_RATE: int = 12

/// Stamina's ceiling.
pub const STAMINA_MAX: int = 300

/// Below this the pack reads tired (ears back).
pub const STAMINA_TIRED: int = 200

/// Below this the pack reads spent (ears flat, tail low).
pub const STAMINA_SPENT: int = 100

/// A sprint burst's length in ticks (0.8 s): a tap starts one, since a
/// terminal has no key-up.
pub const SPRINT_BURST_TICKS: int = 24

/// Stamina a sprinting tick costs.
pub const SPRINT_DRAIN: int = 6

/// Stamina a standing tick returns.
pub const REGEN_STAND: int = 3

/// Stamina a trotting tick returns.
pub const REGEN_TROT: int = 1

/// Stamina needed to start a burst.
pub const SPRINT_MIN: int = 60

/// Stamina that ends the pant.
pub const EXHAUST_RECOVER: int = 90

/// Health's ceiling.
pub const HEALTH_MAX: int = 100

/// The floors are every `HEALTH_FLOOR` points below the ceiling: at 80, 60,
/// 40 and 20 one more wolf faints; at 0 the alpha is alone (pk02's card).
pub const HEALTH_FLOOR: int = 20

/// A fainted wolf returns once health is this far back above its floor.
pub const HEALTH_HYST: int = 10

/// The percent of the speed lost at zero health, linearly: the gait slows
/// as the pack weakens.
pub const HEALTH_SLOW: int = 25

/// The alpha's screen row, counted from the bottom.
pub const WOLF_ROW_FROM_BOTTOM: int = 5

/// Wolves in the pack.
pub const PACK_SIZE: int = 5

/// The alpha's index: the trailing slot at the centre.
pub const ALPHA: int = 4

/// The longest slot lag.
pub const LAG_MAX: int = 6

/// The wander's amplitude, sideways (`WANDER_X`) and along the path
/// (`WANDER_Y`), in half cells either way: slow seeded noise around the
/// slot (a lattice of 64 ticks, two seconds). Three is a cell and a half.
pub const WANDER_X: int = 3

/// Along the path, half a cell either way.
pub const WANDER_Y: int = 1

/// The pull toward the slot: a wolf closes this fraction of its offset a
/// tick (1/16), at most `PULL_MAX` FP units a tick.
pub const PULL: int = 16

/// The pull's bound, FP units a tick.
pub const PULL_MAX: int = 24

/// A body's footprint for the separation rule, cells: three wide, two tall
/// (the rich sprite; the plain tier is smaller and never overlaps either).
pub const BODY_W: int = 3

/// Two tall.
pub const BODY_H: int = 2

/// A bump moves each wolf this far apart in the tick the bodies touch, FP
/// units: half a cell each, a visible nudge (the wander closes on a
/// neighbour a few units a tick, so half the overlap alone would be
/// invisible), never through each other.
pub const BUMP: int = 128

// The shadows (pk02). Every number proposed 2026-10-25, the maintainer's
// to tune by play (R-PK-7); mirrored in docs/DESIGN.md.

/// Shadow chase stays 52 after the pack's 15% increase: above the trot
/// 46, below the sprint 83 (the escape bar, not the old 1.3 ratio).
pub const CHASE_V: int = 52

/// A shadow stalking down the path keeps its original speed of 20,
/// so its turn happens on the screen rather than below it.
pub const STALK_V: int = 20

/// A shadow's acceleration, FP units a tick each tick (the wolves').
pub const SHADOW_ACCEL: int = 4

/// A shadow's braking (the wolves'): the deceleration before its turn.
pub const SHADOW_BRAKE: int = 8

/// A shadow's maximum turn rate, heading units a tick (R-pk02-1 A: the
/// wolves' `TURN_RATE`).
pub const SHADOW_TURN_RATE: int = 12

/// The perception radius, cells: a lurking shadow turns toward a pack
/// member this close (the larger of the sideways and the along distance).
pub const PERCEIVE: int = 8

/// Close contact is heard all round; farther away requires the 60-degree
/// half-cone (4 dot² >= |f|² |d|²). R-pk04-1 A, proposed 2026-10-25.
pub const PERCEIVE_NEAR: int = 3

/// Spawn bands: forest edge 20%, inner verge 30%, path shoulder 50%.
pub const SPAWN_EDGE_PERCENT: int = 20

/// The inner-verge share, percent.
pub const SPAWN_VERGE_PERCENT: int = 30

/// Shoulder inset from the path edge, cells.
pub const SPAWN_SHOULDER_CELLS: int = 3

/// Above this spawn rate (thousandths a tick) shadows come in groups.
pub const GROUP_RATE: int = 5

/// A shadow this many rows behind the alpha is gone.
pub const GONE_ROWS: int = 12

/// Shadows alive at once, at most (the spawn waits).
pub const SHADOW_MAX: int = 12

/// Attack reach, cells, as `PERCEIVE` measures: bodies three cells wide
/// that touch sideways are three cells apart centre to centre, and a bump
/// leaves them four; a shadow on a wolf's flank is in reach.
pub const REACH: int = 4

/// A chasing shadow stops steering toward its target's column this close
/// to it (cells): it rides the flank where the bump left it rather than
/// jostling in every tick.
pub const FLANK: int = 4

/// The ticks an attack winds up before it lands (300 ms: the lunge the
/// player reads and parries).
pub const ATTACK_WINDUP: int = 12

/// The windup's final six ticks: the body lunges, landing on the last.
pub const ATTACK_LUNGE_TICKS: int = 6

/// The ticks between one shadow's attacks.
pub const ATTACK_COOLDOWN: int = 30

/// Health a landed attack costs when another shadow is in reach too (a
/// group attack: two landed cost one wolf). R-pk02-2 A.
pub const DAMAGE: int = 10

/// Health a lone shadow's landed attack costs.
pub const DAMAGE_LONE: int = 5

/// Cohesion: a chasing shadow is drawn toward the other shadows within
/// this many cells.
pub const FLOCK_CELLS: int = 8

/// The cohesion's pull: a shadow closes this fraction of its offset to the
/// flock's centre a tick (1/32), at most `COHESION_MAX`.
pub const COHESION: int = 32

/// The cohesion's bound, FP units a tick.
pub const COHESION_MAX: int = 8

/// Contact reach around an active leaper, cells (R-pk06-1 A proposed).
pub const LEAP_REACH: int = 2

/// Directional reach and the presentation arc's apex, grid cells.
pub const LEAP_REACH_AIM: int = 6

/// The pack arc's apex in grid cells, before collision clipping.
pub const LEAP_RANGE: int = 6

/// The held-arrow set's bits; a contradictory pair chooses forward.
pub const HELD_UP: int = 1

/// Down in the held-arrow set.
pub const HELD_DOWN: int = 2

/// Left in the held-arrow set.
pub const HELD_LEFT: int = 4

/// Right in the held-arrow set.
pub const HELD_RIGHT: int = 8

/// A compass aim in world coordinates: positive y is up the screen.
pub struct Aim { x: int, y: int }

/// The arrows held at the Space press. None and Up are identical;
/// either contradictory pair defaults the entire chord to forward.
pub fn leap_aim(held: int) -> Aim {
    let up = held % 2 == 1
    let down = held / 2 % 2 == 1
    let left = held / 4 % 2 == 1
    let right = held / 8 % 2 == 1
    if up && down || left && right { return Aim { x: 0, y: 1 } }
    let x = if left then -1 else if right then 1 else 0
    let y = if down then -1 else if up || x == 0 then 1 else 0
    Aim { x: x, y: y }
}

/// Inclusive ±45-degree sector plus the short all-round contact reach.
/// Chebyshev distance matches the game's cell reach; dot >= |cross|
/// describes exactly the sector without floating point or an angle table.
pub fn leap_hits(aim: Aim, dx: int, dy: int) -> bool {
    let distance = if abs(dx) > abs(dy) then abs(dx) else abs(dy)
    if distance <= LEAP_REACH * world.FP { return true }
    if distance > LEAP_REACH_AIM * world.FP { return false }
    let dot = aim.x * dx + aim.y * dy
    let cross = aim.x * dy - aim.y * dx
    dot > 0 && dot >= abs(cross)
}

/// The current inferred chord, including only arrow presses already seen.
pub fn held_arrows(s: Sim) -> int {
    var held = 0
    if input.held(s.hold_up, s.tick) { held += HELD_UP }
    if input.held(s.hold_down, s.tick) { held += HELD_DOWN }
    if input.held(s.hold_left, s.tick) { held += HELD_LEFT }
    if input.held(s.hold_right, s.tick) { held += HELD_RIGHT }
    held
}

/// The ticks between leaps.
pub const LEAP_COOLDOWN: int = 14

/// Stamina a leap costs (a fifth of the ceiling: about five leaps, then
/// the pant).
pub const LEAP_STAMINA: int = 60

/// The lunge: the pack at the sprint for this many ticks after a leap.
pub const LEAP_TICKS: int = 8

/// A vanquished shadow's body fades over this many ticks, then is gone.
pub const FADE_TICKS: int = 15

/// The parry's window, ticks after the press (R-pk02-3 A: 300 ms).
pub const PARRY_WINDOW: int = 12

/// The ticks between parries.
pub const PARRY_COOLDOWN: int = 30

/// A turned shadow recoils this many cells away from its target.
pub const PARRY_PUSH: int = 3

/// Over this many ticks (half a cell a tick: a visible knock-back, no
/// teleport).
pub const PARRY_RECOIL: int = 6

/// The red eyes pulse every this many ticks while a shadow chases.
pub const EYE_PULSE: int = 4

// The deer (pk03, M-PK3). Every number proposed 2026-10-25, the
// maintainer's to tune by play (R-PK-7); mirrored in docs/DESIGN.md.

/// A deer's walk, 0.4 v: it grazes and wanders, slower than anything else
/// on the path.
pub const DEER_WALK_V: int = 18

/// A deer's flight, 1.5 v (the campaign's bar): faster than the trot and
/// slower than the sprint, so a trot cannot close on a fresh deer and a
/// sprint can.
pub const FLEE_V: int = 69

/// A tired deer's flight, below the trot: the pack runs it down.
pub const DEER_TIRED_V: int = 37

/// A deer's acceleration, FP units a tick each tick: it bolts (the
/// wolves' `ACCEL` is 4).
pub const DEER_ACCEL: int = 6

/// A deer's braking.
pub const DEER_BRAKE: int = 8

/// A deer's maximum turn rate, heading units a tick: a lighter animal
/// than a wolf turns quicker.
pub const DEER_TURN_RATE: int = 16

/// A deer's perception radius, cells (as `PERCEIVE` measures): a running
/// wolf this close puts it to flight.
pub const DEER_PERCEIVE: int = 10

/// A fleeing deer calms once the nearest wolf is this many cells beyond
/// `DEER_PERCEIVE` (the hysteresis, so it does not stutter at the edge).
pub const DEER_CALM: int = 6

/// A deer's stamina: ticks of flight before it tires (three seconds).
pub const DEER_STAMINA: int = 90

/// A walking deer regains a point of stamina every this many ticks (a
/// fleeing tick costs one): a deer put to flight again and again tires,
/// which is how a pack at the trot runs one down.
pub const DEER_REGEN_TICKS: int = 3

/// A tired deer flees at `FLEE_V` again once its stamina is back to this.
pub const DEER_RECOVER: int = 60

/// A running wolf this close to a deer brings it down (cells, as `REACH`
/// measures): from behind, since the separation rule keeps bodies three
/// cells apart sideways.
pub const CATCH_REACH: int = 3

/// Health a deer feeds the pack (R-pk03-3 A: a fixed feed, one floor and
/// a bit): the first thing that raises health in play.
pub const FEED: int = 25

/// Deer alive at once, at most; the spawn waits.
pub const DEER_MAX: int = 3

/// A deer this many rows beyond the top of the screen has got away and is
/// gone; behind the alpha the shadows' `GONE_ROWS` holds for it too.
pub const DEER_GONE_MARGIN: int = 20

// Dusk (pk03, innovation 4). The phase of the day is a function of the
// distance travelled: afternoon to `DUSK_START`, a blend to dusk by
// `DUSK_FULL`, a blend to night by `NIGHT_FULL`, in rows. Proposed
// 2026-10-25; mirrored in docs/DESIGN.md and docs/PALETTE.md.

/// The afternoon lasts this many rows (about two minutes at the trot).
pub const DUSK_START: int = 600

/// Full dusk at this many rows (about four minutes).
pub const DUSK_FULL: int = 1200

/// Night at this many rows (about six and a half minutes); the palette
/// holds there.
pub const NIGHT_FULL: int = 1800

/// A deer's states: wandering (the walk, grazing across the path and the
/// verge).
pub const DEER_WANDERING: int = 0

/// Fleeing a wolf within `DEER_PERCEIVE`, along the path away from it.
pub const DEER_FLEEING: int = 1

/// Gone: caught (the pack fed), got away, or left behind; dropped at the
/// end of the tick.
pub const DEER_GONE: int = 2

/// One deer: its position, lateral heading, speed and direction along the
/// path (the realism bars), its state, its stamina and whether it is
/// tired; `id` is its number in the run (the wander's noise reads it, so
/// a deer keeps its own wander when another is dropped from the list).
pub struct Deer {
    id: int,
    x: int,
    y: int,
    heading: int,
    speed: int,
    dir: int,
    state: int,
    stamina: int,
    tired: bool,
}

/// A shadow's states.
pub const LURKING: int = 0

/// Chasing (or stalking) its target.
pub const CHASING: int = 1

/// Winding up an attack.
pub const ATTACKING: int = 2

/// Vanquished by a leap: fading.
pub const VANQUISHED: int = 3

/// Gone: removed at the end of the tick.
pub const GONE: int = 4

/// One shadow wolf: its position, lateral heading, speed and direction
/// along the path (`dir` +1 up the path with the pack, -1 down toward the
/// oncoming pack), its state, the pack member it pursues, its attack's
/// windup and cooldown, a parry's recoil, its fade.
pub struct Shadow {
    // A stationary lurker's facing: a seeded vector in the outward
    // half-circle, independent of the chase's later bounded heading.
    face_x: int,
    face_y: int,
    attack_age: int,
    attack_dx: int,
    attack_dy: int,
    pose_x: int,
    pose_y: int,
    x: int,
    y: int,
    heading: int,
    speed: int,
    dir: int,
    state: int,
    target: int,
    windup: int,
    cooldown: int,
    recoil: int,
    fade: int,
}

/// Postures (the HUD is posture, innovation 5).
pub const POSTURE_TROT: int = 0

/// Standing.
pub const POSTURE_STAND: int = 1

/// Sprinting.
pub const POSTURE_SPRINT: int = 2

/// Panting: exhausted, no sprint until `EXHAUST_RECOVER`.
pub const POSTURE_PANT: int = 3

/// Leaping: the lunge after Space (pk02).
pub const POSTURE_LEAP: int = 4

/// Stamina bands, read in the ears and the tail.
pub const BAND_FRESH: int = 0

/// Tired: ears back.
pub const BAND_TIRED: int = 1

/// Spent: ears flat, tail low.
pub const BAND_SPENT: int = 2

/// A wolf's states.
pub const RUNNING: int = 0

/// Fainted: left where it lies.
pub const FAINTED: int = 1

/// Returning from the bottom edge to its slot.
pub const RETURNING: int = 2

/// One wolf: its own position, heading, speed and state; the forest edge's
/// touch and its scratches.
pub struct Wolf {
    x: int,
    y: int,
    heading: int,
    speed: int,
    state: int,
    in_forest: bool,
    scratches: int,
}

/// The simulation: the seed, the screen's size, the tick count, the pack
/// (the reference point and its steer, the five wolves, the shared stamina
/// and health), the shadows, the leap's and the parry's timers, the
/// run's counts (vanquished, landed, turned, spawned) and its death.
pub struct Sim {
    seed: int,
    cols: int,
    rows: int,
    tick: int,
    wolves: List[Wolf],
    px: int,
    py: int,
    heading: int,
    heading_target: int,
    steer_hist: List[int],
    speed: int,
    stopping: bool,
    sprint_left: int,
    stamina: int,
    exhausted: bool,
    health: int,
    down: int,
    bumps: int,
    hold_up: input.Hold,
    hold_down: input.Hold,
    hold_left: input.Hold,
    hold_right: input.Hold,
    speed_scale: int,
    leaps: int,
    parries: int,
    shadows: List[Shadow],
    leap_left: int,
    leap_aim: Aim,
    leap_tell: bool,
    leap_held: int,
    leap_tick: int,
    leap_group: int,
    leap_next_group: int,
    leap_landing: bool,
    leap_x: List[int],
    leap_y: List[int],
    leap_marks_x: List[int],
    leap_marks_y: List[int],
    leap_ready_at: int,
    parry_until: int,
    parry_ready_at: int,
    vanquished: int,
    landed: int,
    turned: int,
    spawned: int,
    dead: bool,
    died_tick: int,
    deer: List[Deer],
    deer_spawned: int,
    fed: int,
}

/// A slot's sideways offset from the reference, in cells: the leaders two
/// cells either side (a four-cell gap between three-cell bodies, so their
/// wander meets and they bump), the flankers five.
pub fn slot_dx(i: int) -> int {
    match i {
        0 => -2,
        1 => 2,
        2 => -5,
        3 => 5,
        _ => 0,
    }
}

/// A slot's offset ahead of the reference, in cells.
pub fn slot_dy(i: int) -> int {
    match i {
        0 => 5,
        1 => 5,
        2 => 2,
        3 => 2,
        _ => 0,
    }
}

/// The ticks a slot's heading follows the steer late: the leaders turn
/// first, the flankers next, the alpha last.
pub fn slot_lag(i: int) -> int {
    match i {
        0 => 0,
        1 => 0,
        2 => 3,
        3 => 3,
        _ => LAG_MAX,
    }
}

/// A new simulation: the reference at the path's centre on world row 0,
/// every wolf in its slot, at trot, full stamina and health.
pub fn new(seed: int, cols: int, rows: int) -> Sim {
    new_at(seed, cols, rows, 0)
}

/// A new simulation whose run starts `start` rows up the path (the replay
/// header's `start N`, pk03): the same forest, the pack placed there, so
/// the distance (and with it the curve and the dusk) begins at `start`.
pub fn new_at(seed: int, cols: int, rows: int, start: int) -> Sim {
    let (centre, _) = trail.path(seed, cols, start)
    var wolves = List[Wolf]()
    var i = 0
    while i < PACK_SIZE {
        (mut wolves).push(Wolf {
            x: clamp_x(centre + slot_dx(i) * world.FP, cols),
            y: (start + slot_dy(i)) * world.FP,
            heading: 0,
            speed: TROT_V,
            state: RUNNING,
            in_forest: false,
            scratches: 0,
        })
        i += 1
    }
    var hist = List[int]()
    var k = 0
    while k <= LAG_MAX {
        (mut hist).push(0)
        k += 1
    }
    Sim {
        seed: seed,
        cols: cols,
        rows: rows,
        tick: 0,
        wolves: wolves,
        px: centre,
        py: start * world.FP,
        heading: 0,
        heading_target: 0,
        steer_hist: hist,
        speed: TROT_V,
        stopping: false,
        sprint_left: 0,
        stamina: STAMINA_MAX,
        exhausted: false,
        health: HEALTH_MAX,
        down: 0,
        bumps: 0,
        hold_up: input.hold_new(),
        hold_down: input.hold_new(),
        hold_left: input.hold_new(),
        hold_right: input.hold_new(),
        speed_scale: 100,
        leaps: 0,
        parries: 0,
        shadows: List[Shadow](),
        leap_left: 0,
        leap_aim: leap_aim(0),
        leap_tell: false,
        leap_held: 0,
        leap_tick: -1,
        leap_group: 0,
        leap_next_group: 0,
        leap_landing: false,
        leap_x: zero_slots(),
        leap_y: zero_slots(),
        leap_marks_x: List[int](),
        leap_marks_y: List[int](),
        leap_ready_at: 0,
        parry_until: 0,
        parry_ready_at: 0,
        vanquished: 0,
        landed: 0,
        turned: 0,
        spawned: 0,
        dead: false,
        died_tick: 0,
        deer: List[Deer](),
        deer_spawned: 0,
        fed: 0,
    }
}

/// A speed constant under the debug knob `--speed-scale` (percent; 100 is
/// the constants as written; the maintainer tunes by play, then the
/// constant moves and the knob goes back to 100).
pub fn scaled(s: Sim, v: int) -> int {
    v * s.speed_scale / 100
}

/// The screen changed size: the field scales to it (never below the
/// minimum, which the terminal layer refuses). The pack keeps its world
/// rows; every lateral position is rescaled to the new width so the pack
/// stays on the same part of the path.
pub fn resize(mut s: Sim, cols: int, rows: int) {
    if cols > 0 && s.cols > 0 {
        s.px = s.px * cols / s.cols
        var mark = 0
        while mark < s.leap_marks_x.len {
            s.leap_marks_x[mark] = s.leap_marks_x[mark] * cols / s.cols
            mark += 1
        }
        var slot = 0
        while slot < PACK_SIZE {
            s.leap_x[slot] = s.leap_x[slot] * cols / s.cols
            slot += 1
        }
        var i = 0
        while i < s.wolves.len {
            var w = copy s.wolves[i]
            w.x = w.x * cols / s.cols
            s.wolves[i] = w
            i += 1
        }
        var k = 0
        while k < s.shadows.len {
            var sh = copy s.shadows[k]
            sh.x = sh.x * cols / s.cols
            sh.attack_dx = sh.attack_dx * cols / s.cols
            sh.pose_x = sh.pose_x * cols / s.cols
            s.shadows[k] = sh
            k += 1
        }
        k = 0
        while k < s.deer.len {
            var d = copy s.deer[k]
            d.x = d.x * cols / s.cols
            s.deer[k] = d
            k += 1
        }
    }
    s.cols = cols
    s.rows = rows
}

/// The alpha.
pub fn alpha(s: Sim) -> Wolf {
    copy s.wolves[ALPHA]
}

/// The screen row the alpha is drawn on.
pub fn wolf_row(s: Sim) -> int {
    s.rows - WOLF_ROW_FROM_BOTTOM
}

/// The world row a screen row shows: the alpha's row shows the alpha's
/// world row, and rows above show rows ahead.
pub fn world_row(s: Sim, screen_row: int) -> int {
    alpha(s).y / world.FP + (wolf_row(s) - screen_row)
}

/// The screen row of wolf `i` (may be off the screen).
pub fn screen_row(s: Sim, i: int) -> int {
    wolf_row(s) - (s.wolves[i].y / world.FP - alpha(s).y / world.FP)
}

/// The screen column of wolf `i`'s centre.
pub fn screen_col(s: Sim, i: int) -> int {
    s.wolves[i].x / world.FP
}

/// Keys, as `input` names them; the simulation knows them by number so it
/// imports nothing that touches a terminal.
pub const KEY_UP: int = 1

/// Down.
pub const KEY_DOWN: int = 2

/// Left.
pub const KEY_LEFT: int = 3

/// Right.
pub const KEY_RIGHT: int = 4

/// Parry.
pub const KEY_PARRY: int = 5

/// Leap.
pub const KEY_LEAP: int = 6

fn clamp(v: int, lo: int, hi: int) -> int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    v
}

fn clamp_x(x: int, cols: int) -> int {
    clamp(x, world.FP * 3 / 2, cols * world.FP - world.FP * 3 / 2)
}

fn toward(v: int, target: int, step: int) -> int {
    if v < target {
        return if v + step > target then target else v + step
    }
    if v > target {
        return if v - step < target then target else v - step
    }
    v
}

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

/// The pack's speed target by its state (stopping, a burst, the trot),
/// slowed by lost health.
fn pack_target(s: Sim) -> int {
    var target = scaled(s, TROT_V)
    if s.stopping {
        target = 0
    } else if s.sprint_left > 0 {
        target = scaled(s, SPRINT_V)
    }
    target * (100 - HEALTH_SLOW * (HEALTH_MAX - s.health) / HEALTH_MAX) / 100
}

/// The wander of wolf `i` at `tick`: slow seeded noise around its slot,
/// `(dx, dy)` in FP units.
fn wander(s: Sim, i: int, tick: int) -> (int, int) {
    let nx = world.noise(s.seed + 1000 + i, 5, tick) - world.FP / 2
    let ny = world.noise(s.seed + 2000 + i, 6, tick) - world.FP / 2
    (nx * WANDER_X, ny * WANDER_Y)
}

/// Where wolf `i` wants to be: its slot off the reference, plus its wander.
fn desired(s: Sim, i: int) -> (int, int) {
    let (wx, wy) = wander(s, i, s.tick)
    (clamp_x(s.px + slot_dx(i) * world.FP + wx, s.cols), s.py + slot_dy(i) * world.FP + wy)
}

/// The floors crossed at `health`: how many wolves it puts down.
fn floors_below(health: int) -> int {
    var n = 0
    var f = HEALTH_MAX - HEALTH_FLOOR
    while f >= HEALTH_FLOOR {
        if health <= f {
            n += 1
        }
        f -= HEALTH_FLOOR
    }
    if n > PACK_SIZE - 1 then PACK_SIZE - 1 else n
}

/// The farthest running wolf from the alpha (never the alpha), or -1.
fn farthest(s: Sim) -> int {
    let a = alpha(s)
    var best = -1
    var best_d = -1
    var i = 0
    while i < PACK_SIZE {
        if i != ALPHA && s.wolves[i].state != FAINTED {
            let d = abs(s.wolves[i].x - a.x) + abs(s.wolves[i].y - a.y)
            if d > best_d {
                best_d = d
                best = i
            }
        }
        i += 1
    }
    best
}

/// One wolf faints: it stops where it is and is left behind.
fn faint_one(mut s: Sim) {
    let i = farthest(s)
    if i < 0 {
        return
    }
    var w = copy s.wolves[i]
    w.state = FAINTED
    w.speed = 0
    w.heading = 0
    s.wolves[i] = w
    s.down += 1
}

/// One fainted wolf returns: from where it lies if that is still on the
/// screen, else from one row below the bottom edge at its slot's column,
/// sprinting back to its slot.
fn return_one(mut s: Sim) {
    var i = 0
    while i < PACK_SIZE {
        if s.wolves[i].state == FAINTED {
            var w = copy s.wolves[i]
            let row = screen_row(s, i)
            if row < 0 || row >= s.rows {
                let (dx, _) = desired(s, i)
                w.x = dx
                w.y = alpha(s).y - (s.rows - wolf_row(s) + 1) * world.FP
            }
            w.state = RETURNING
            w.speed = 0
            s.wolves[i] = w
            s.down -= 1
            return
        }
        i += 1
    }
}

/// Health: faint one wolf per floor crossed downward, return one per
/// recovery threshold crossed upward, at most one change a tick.
fn health_step(mut s: Sim) {
    let target = floors_below(s.health)
    if s.down < target {
        faint_one(mut s)
    } else if s.down > 0 && s.health >= HEALTH_MAX - s.down * HEALTH_FLOOR + HEALTH_HYST {
        return_one(mut s)
    }
}

/// One tick: apply `keys` (in order) and `health_delta` (the replay's
/// `health` event or a debug key; zero otherwise), then move the pack.
pub fn step(mut s: Sim, keys: List[int], health_delta: int) {
    if s.dead {
        // The run is over: the world stands still under the card while the
        // tick keeps counting (the replay's clock for the card's keys).
        s.tick += 1
        return
    }
    s.leap_landing = false
    s.leap_tell = false
    // A run of the same key in one tick is one press (autorepeat bytes
    // that arrived together); the hold decides how long it lasts.
    var left = false
    var right = false
    var up = false
    var down = false
    for k in keys {
        if k == KEY_LEFT {
            if !left { input.hold_press(mut s.hold_left, s.tick) }
            left = true
            s.stopping = false
        } else if k == KEY_RIGHT {
            if !right { input.hold_press(mut s.hold_right, s.tick) }
            right = true
            s.stopping = false
        } else if k == KEY_UP {
            if !up { input.hold_press(mut s.hold_up, s.tick) }
            up = true
            s.stopping = false
            if !s.exhausted && s.stamina >= SPRINT_MIN {
                s.sprint_left = SPRINT_BURST_TICKS
            }
        } else if k == KEY_DOWN {
            if !down { input.hold_press(mut s.hold_down, s.tick) }
            down = true
            s.stopping = true
            s.sprint_left = 0
        } else if k == KEY_LEAP {
            s.leaps += 1
            leap(mut s)
        } else if k == KEY_PARRY {
            s.parries += 1
            if s.parry_ready_at <= s.tick {
                s.parry_until = s.tick + PARRY_WINDOW
                s.parry_ready_at = s.tick + PARRY_COOLDOWN
            }
        }
    }
    // The shadows: spawn, perceive, chase, flock, attack. Their landed
    // attacks join the replay's and the debug keys' channel into health;
    // at health 0 the alpha is alone and the next landed attack ends the
    // run. The deer (pk03): spawn, wander, flee, tire; a deer brought down
    // feeds the pack through the same channel.
    spawn_shadows(mut s)
    spawn_deer(mut s)
    let damage = shadows_step(mut s)
    let feed = deer_step(mut s)
    if damage > 0 && s.health == 0 {
        s.dead = true
        s.died_tick = s.tick
    }
    s.health = clamp(s.health + health_delta - damage + feed, 0, HEALTH_MAX)
    health_step(mut s)
    // Steering: the heading target is the held steer (both held cancel),
    // and the reference's heading turns toward it at the turn rate;
    // released, it returns to straight at the same rate and the sideways
    // motion ends with it. The target's history feeds the slots' lags.
    var steer = 0
    if input.held(s.hold_left, s.tick) {
        steer -= 1
    }
    if input.held(s.hold_right, s.tick) {
        steer += 1
    }
    s.heading_target = steer * STEER_HEADING
    var k = LAG_MAX
    while k > 0 {
        s.steer_hist[k] = s.steer_hist[k - 1]
        k -= 1
    }
    s.steer_hist[0] = s.heading_target
    s.heading = toward(s.heading, s.heading_target, TURN_RATE)
    // The pack's speed: toward the target its state names, capped while
    // the alpha is in the forest edge.
    var target = pack_target(s)
    if alpha(s).in_forest && target > scaled(s, FOREST_V) {
        target = scaled(s, FOREST_V)
    }
    s.speed = toward(
        s.speed,
        target,
        if target < s.speed then scaled(s, BRAKE) else scaled(s, ACCEL),
    )
    // Stamina: a sprint drains, standing and trotting regenerate.
    if s.sprint_left > 0 {
        s.sprint_left -= 1
        s.stamina -= SPRINT_DRAIN
        if s.stamina <= 0 {
            s.stamina = 0
            s.exhausted = true
            s.sprint_left = 0
        }
    } else if s.speed == 0 {
        s.stamina = clamp(s.stamina + REGEN_STAND, 0, STAMINA_MAX)
    } else {
        s.stamina = clamp(s.stamina + REGEN_TROT, 0, STAMINA_MAX)
    }
    if s.exhausted && s.stamina >= EXHAUST_RECOVER {
        s.exhausted = false
    }
    // The reference moves: the heading's small-angle split of the speed.
    let (rvx, rvy) = split(s.speed, s.heading)
    s.px = clamp_x(s.px + rvx, s.cols)
    s.py += rvy
    // Each wolf: its heading follows the steer its slot's lag late, its
    // speed follows the pack's target (capped in the forest edge; the
    // return sprint for a returning wolf), it moves, and the pull closes
    // on its slot and wander.
    var i = 0
    while i < PACK_SIZE {
        var w = copy s.wolves[i]
        if w.state == FAINTED {
            i += 1
            continue
        }
        let (dx, dy) = desired(s, i)
        var wt = target
        if w.state == RETURNING {
            wt = scaled(s, RETURN_V)
            // Aim at the slot's column while far from it.
            let off = dx - w.x
            let aim = if off > world.FP {
                STEER_HEADING
            } else if off < 0 - world.FP {
                0 - STEER_HEADING
            } else {
                0
            }
            w.heading = toward(w.heading, aim, TURN_RATE)
            if w.y >= dy - world.FP / 2 {
                w.state = RUNNING
            }
        } else {
            w.heading = toward(w.heading, s.steer_hist[slot_lag(i)], TURN_RATE)
        }
        if w.in_forest && wt > scaled(s, FOREST_V) {
            wt = scaled(s, FOREST_V)
        }
        w.speed = toward(w.speed, wt, if wt < w.speed then scaled(s, BRAKE) else scaled(s, ACCEL))
        let (vx, vy) = split(w.speed, w.heading)
        let pull_x = clamp((dx - w.x) / PULL, 0 - PULL_MAX, PULL_MAX)
        let pull_y = clamp((dy - w.y) / PULL, 0 - PULL_MAX, PULL_MAX)
        w.x = clamp_x(w.x + vx + pull_x, s.cols)
        w.y += vy + pull_y
        s.wolves[i] = w
        i += 1
    }
    separate(mut s)
    // The forest edge slows and scratches the wolves that touch it.
    i = 0
    while i < PACK_SIZE {
        var w = copy s.wolves[i]
        if w.state != FAINTED {
            let (centre, half) = trail.path(s.seed, s.cols, w.y / world.FP)
            w.in_forest = abs(w.x - centre) > half
            if w.in_forest {
                w.scratches += 1
            }
            s.wolves[i] = w
        }
        i += 1
    }
    update_attack_poses(mut s)
    update_leap_poses(mut s)
    s.tick += 1
}

/// The heading's small-angle split of a speed into sideways and forward.
fn split(speed: int, h: int) -> (int, int) {
    let vx = speed * h / HEADING_MAX
    let vy = speed - speed * h * h / (2 * HEADING_MAX * HEADING_MAX)
    (vx, vy)
}

/// The bodies the separation rule sees: the five wolves, then the live
/// shadows, then the deer (a fainted wolf, a vanquished shadow and a
/// caught deer are not bodies).
fn body_count(s: Sim) -> int {
    PACK_SIZE + s.shadows.len + s.deer.len
}

/// Body `k`'s position and whether it is live: `(x, y, live)`.
fn body(s: Sim, k: int) -> (int, int, bool) {
    if k < PACK_SIZE {
        let w = copy s.wolves[k]
        return (w.x, w.y, w.state != FAINTED)
    }
    if k < PACK_SIZE + s.shadows.len {
        let sh = copy s.shadows[k - PACK_SIZE]
        return (sh.x, sh.y, sh.state != VANQUISHED && sh.state != GONE)
    }
    let d = copy s.deer[k - PACK_SIZE - s.shadows.len]
    (d.x, d.y, d.state != DEER_GONE)
}

/// Move body `k` sideways to `x`.
fn set_body_x(mut s: Sim, k: int, x: int) {
    if k < PACK_SIZE {
        var w = copy s.wolves[k]
        w.x = x
        s.wolves[k] = w
        return
    }
    if k < PACK_SIZE + s.shadows.len {
        var sh = copy s.shadows[k - PACK_SIZE]
        sh.x = x
        s.shadows[k - PACK_SIZE] = sh
        return
    }
    let j = k - PACK_SIZE - s.shadows.len
    var d = copy s.deer[j]
    d.x = x
    s.deer[j] = d
}

/// The separation rule over every pair of live bodies — wolves and
/// shadows alike, so a pack wolf and a shadow bump too and nothing ever
/// overlaps: two bodies whose footprints overlap are nudged apart
/// sideways, each by `BUMP` or by half the overlap if that is more, the
/// one on the left to the left; a tie goes by body order. Pairs in a fixed
/// order, and the pass repeats while a push made a new pair touch (at most
/// `PACK_SIZE` passes), so the result is the seed's alone and no overlap
/// survives; `bumps` counts the nudges.
fn separate(mut s: Sim) {
    var pass = 0
    while pass < PACK_SIZE && separate_pass(mut s) {
        pass += 1
    }
}

/// One pass over the pairs; true when something was pushed.
fn separate_pass(mut s: Sim) -> bool {
    let sep_x = BODY_W * world.FP
    let sep_y = BODY_H * world.FP
    let n = body_count(s)
    var pushed = false
    var i = 0
    while i < n {
        var j = i + 1
        while j < n {
            let (ax0, ay, a_live) = body(s, i)
            let (bx0, by, b_live) = body(s, j)
            if a_live && b_live {
                let dx = bx0 - ax0
                let dy = by - ay
                if abs(dx) < sep_x && abs(dy) < sep_y {
                    var push = (sep_x - abs(dx) + 1) / 2
                    if push < BUMP {
                        push = BUMP
                    }
                    s.bumps += 1
                    pushed = true
                    // The one on the left goes left, the other right; the
                    // share the field's edge refuses one goes to the other.
                    var lx = ax0
                    var rx = bx0
                    if dx < 0 {
                        lx = bx0
                        rx = ax0
                    }
                    let lx1 = clamp_x(lx - push, s.cols)
                    let lost_l = lx1 - (lx - push)
                    let rx1 = clamp_x(rx + push + lost_l, s.cols)
                    let lost_r = rx + push + lost_l - rx1
                    let lx2 = clamp_x(lx1 - lost_r, s.cols)
                    if dx < 0 {
                        set_body_x(mut s, i, rx1)
                        set_body_x(mut s, j, lx2)
                    } else {
                        set_body_x(mut s, i, lx2)
                        set_body_x(mut s, j, rx1)
                    }
                }
            }
            j += 1
        }
        i += 1
    }
    pushed
}

/// Whether any two live bodies (wolves and shadows) overlap now (a test's
/// and the trace's question; the separation rule keeps it false).
pub fn any_overlap(s: Sim) -> bool {
    let sep_x = BODY_W * world.FP
    let sep_y = BODY_H * world.FP
    let n = body_count(s)
    var i = 0
    while i < n {
        var j = i + 1
        while j < n {
            let (ax, ay, a_live) = body(s, i)
            let (bx, by, b_live) = body(s, j)
            if a_live && b_live && abs(bx - ax) < sep_x && abs(by - ay) < sep_y {
                return true
            }
            j += 1
        }
        i += 1
    }
    false
}

/// The pack's posture now (the alpha's reading of it).
pub fn posture(s: Sim) -> int {
    wolf_posture(s, ALPHA)
}

/// Wolf `i`'s posture.
pub fn wolf_posture(s: Sim, i: int) -> int {
    if s.exhausted {
        return POSTURE_PANT
    }
    let w = copy s.wolves[i]
    if w.speed == 0 {
        return POSTURE_STAND
    }
    if (s.leap_left > 0 || s.leap_landing) && leap_member(s.leap_group, i) && w.state == RUNNING {
        return POSTURE_LEAP
    }
    if w.state == RETURNING || s.sprint_left > 0 && w.speed > scaled(s, TROT_V) {
        return POSTURE_SPRINT
    }
    POSTURE_TROT
}

/// The stamina band the ears and tail show.
pub fn band(s: Sim) -> int {
    if s.exhausted || s.stamina < STAMINA_SPENT {
        return BAND_SPENT
    }
    if s.stamina < STAMINA_TIRED {
        return BAND_TIRED
    }
    BAND_FRESH
}

/// Wolf `i`'s trot frame (0-3), advancing with its own distance so the
/// gait matches its speed; a standing wolf holds frame 0.
pub fn trot_frame(s: Sim, i: int) -> int {
    let w = copy s.wolves[i]
    if w.speed == 0 {
        return 0
    }
    abs(w.y) / (world.FP / 2) % 4
}

/// The steer: the heading target the keys set (the trace reads it).
pub fn steer_target(s: Sim) -> int {
    s.heading_target
}

/// The reference's heading now.
pub fn steer_heading(s: Sim) -> int {
    s.heading
}

/// The reference's lateral position, FP units.
pub fn steer_x(s: Sim) -> int {
    s.px
}

/// The reference's world row position, FP units.
pub fn steer_y(s: Sim) -> int {
    s.py
}

/// Distance travelled by the alpha, in cells.
pub fn distance_cells(s: Sim) -> int {
    alpha(s).y / world.FP
}

/// The spawn-rate input pk02 reads: a function of the alpha's distance
/// and the forest's density at its row (`world.spawn_rate`).
pub fn spawn_rate(s: Sim) -> int {
    trail.spawn_rate(s.seed, alpha(s).y / world.FP)
}

// The shadows (pk02).

/// A shadow's row on the screen (its body's), by the alpha's eye.
pub fn shadow_screen_row(s: Sim, k: int) -> int {
    wolf_row(s) - (s.shadows[k].y / world.FP - alpha(s).y / world.FP)
}

/// A shadow's screen column.
pub fn shadow_screen_col(s: Sim, k: int) -> int {
    s.shadows[k].x / world.FP
}

/// Whether a shadow is alive (lurking, chasing or attacking).
pub fn shadow_alive(sh: Shadow) -> bool {
    sh.state == LURKING || sh.state == CHASING || sh.state == ATTACKING
}

/// How many shadows are alive now.
pub fn shadows_alive(s: Sim) -> int {
    var n = 0
    for sh in s.shadows {
        if shadow_alive(sh) {
            n += 1
        }
    }
    n
}

/// The eye variant a shadow is drawn with at `tick`: 1 (dim) while it
/// lurks or is pushed back, pulsing bright and dim every `EYE_PULSE` ticks
/// while it chases, 0 (bright, steady) through an attack's windup.
pub fn shadow_eyes(sh: Shadow, tick: int) -> int {
    if sh.state == ATTACKING {
        return 0
    }
    if sh.state == CHASING && sh.recoil == 0 {
        return tick / EYE_PULSE % 2
    }
    1
}

/// The spawn roll at `tick`: how many shadows appear (0 for none): the
/// world's hash of the tick against `rate` thousandths; one, or two or
/// three (by a second hash) once the rate passes `GROUP_RATE`. Pure, so a
/// run's spawns are the seed's and a test can read the odds.
pub fn spawn_roll(seed: int, tick: int, rate: int) -> int {
    if world.hash(seed + 5000, tick, 1, 1000) >= rate {
        return 0
    }
    if rate <= GROUP_RATE {
        return 1
    }
    2 + world.hash(seed + 5000, tick, 2, 2)
}

/// A shadow lurking at the forest edge of world row `row`, on `side` (-1
/// left, 1 right): half a cell into the verge, facing down the path.
pub fn lurker(s: Sim, row: int, side: int) -> Shadow {
    let (centre, half) = trail.path(s.seed, s.cols, row)
    let band = spawn_band(s.seed, s.tick, row)
    let off = if band == 0 {
        half + world.FP / 2
    } else if band == 1 {
        half - world.FP / 2
    } else {
        half - SPAWN_SHOULDER_CELLS * world.FP
    }
    let (fx, fy) = spawn_facing(s.seed, s.tick, row, side)
    Shadow {
        face_x: fx,
        face_y: fy,
        attack_age: 0,
        attack_dx: 0,
        attack_dy: 0,
        pose_x: 0,
        pose_y: 0,
        x: clamp_x(centre + side * off, s.cols),
        y: row * world.FP,
        heading: fx * HEADING_MAX / 2,
        speed: 0,
        dir: if fy < 0 then -1 else 1,
        state: LURKING,
        target: ALPHA,
        windup: 0,
        cooldown: 0,
        recoil: 0,
        fade: 0,
    }
}

/// The seed picks a spawn band, independently of its facing.
pub fn spawn_band(seed: int, tick: int, row: int) -> int {
    let n = world.hash(seed + 5100, tick, row, 100)
    if n < SPAWN_EDGE_PERCENT {
        0
    } else if n < SPAWN_EDGE_PERCENT + SPAWN_VERGE_PERCENT {
        1
    } else {
        2
    }
}

/// Five evenly spaced facings across the outward half-circle: along the
/// path both ways, diagonally toward it both ways, straight across to it.
/// No facing has a component into the woods, even on the right bank.
pub fn spawn_facing(seed: int, tick: int, row: int, side: int) -> (int, int) {
    let n = world.hash(seed + 5200, tick, row, 5)
    let fx = if n == 0 || n == 4 then 0 else 0 - side * 2
    let fy = if n < 2 then -2 else if n == 2 then 0 else 2
    (fx, fy)
}

/// A wolf within PERCEIVE and in the forward 60-degree half-cone, or
/// brushing past within PERCEIVE_NEAR all round. Integer dot products;
/// the original Chebyshev range and the hit envelope do not change.
pub fn shadow_perceives(sh: Shadow, x: int, y: int) -> bool {
    let dx = x - sh.x
    let dy = y - sh.y
    let d = reach_dist(sh.x, sh.y, x, y)
    if d <= PERCEIVE_NEAR * world.FP { return true }
    if d > PERCEIVE * world.FP { return false }
    let dot = dx * sh.face_x + dy * sh.face_y
    dot >= 0 &&
        4 * dot * dot >= (sh.face_x * sh.face_x + sh.face_y * sh.face_y) * (dx * dx + dy * dy)
}

/// The nearest visible living wolf, not merely whether the nearest wolf
/// is visible (a nearer wolf behind the cone must not mask one in front).
pub fn perceived_wolf(s: Sim, sh: Shadow) -> int {
    var best = -1
    var best_d = 0
    var i = 0
    while i < PACK_SIZE {
        let w = copy s.wolves[i]
        if w.state != FAINTED && shadow_perceives(sh, w.x, w.y) {
            let d = reach_dist(sh.x, sh.y, w.x, w.y)
            if best < 0 || d < best_d { best = i; best_d = d }
        }
        i += 1
    }
    best
}

/// The side a spawn lurks on, by the path's bend between the alpha's row
/// and the spawn row (pk03): the OUTSIDE of the bend, where a pack that
/// steers late drifts (a path bending right as it climbs puts the pack on
/// its left verge), so a group waits where the pack will be and not across
/// a wide path from it; on a straight (under a cell of bend) the seed's
/// coin.
pub fn spawn_side(s: Sim, top: int) -> int {
    let (here, _) = trail.path(s.seed, s.cols, alpha(s).y / world.FP)
    let (there, _) = trail.path(s.seed, s.cols, top)
    let bend = there - here
    if bend > world.FP {
        return -1
    }
    if bend < 0 - world.FP {
        return 1
    }
    if world.hash(s.seed + 5000, s.tick, 3, 2) == 0 then -1 else 1
}

/// Spawn: roll the tick; a shadow (or a group spaced three rows apart,
/// the same side) appears at the forest edge one row above the top of the
/// screen, on the side the bend names, while fewer than `SHADOW_MAX` are
/// alive.
fn spawn_shadows(mut s: Sim) {
    let n = spawn_roll(s.seed, s.tick, spawn_rate(s))
    if n == 0 {
        return
    }
    let top = world_row(s, 0) + 1
    let side = spawn_side(s, top)
    var k = 0
    while k < n && shadows_alive(s) < SHADOW_MAX {
        (mut s.shadows).push(lurker(s, top + 3 * k, side))
        s.spawned += 1
        k += 1
    }
}

/// Place `n` shadows chasing around the pack at once (the perf gate's
/// `--bench-shadows`; nothing in a game calls it).
pub fn seed_shadows(mut s: Sim, n: int) {
    var k = 0
    while k < n {
        let side = if k % 2 == 0 then -1 else 1
        let row = alpha(s).y / world.FP + 10 - 3 * k
        var sh = lurker(s, row, side)
        sh.state = CHASING
        sh.dir = if k % 3 == 0 then -1 else 1
        sh.speed = if k % 3 == 0 then STALK_V else CHASE_V
        (mut s.shadows).push(sh)
        k += 1
    }
}

/// The distance between two points as `PERCEIVE` and `REACH` measure it:
/// the larger of the sideways and the along distance, in FP units.
fn reach_dist(ax: int, ay: int, bx: int, by: int) -> int {
    let dx = abs(bx - ax)
    let dy = abs(by - ay)
    if dx > dy then dx else dy
}

/// The nearest running or returning pack member to `(x, y)`, or -1 when
/// every wolf has fainted (never: the alpha never faints).
fn nearest_wolf(s: Sim, x: int, y: int) -> int {
    var best = -1
    var best_d = 0
    var i = 0
    while i < PACK_SIZE {
        let w = copy s.wolves[i]
        if w.state != FAINTED {
            let d = reach_dist(x, y, w.x, w.y)
            if best < 0 || d < best_d {
                best = i
                best_d = d
            }
        }
        i += 1
    }
    best
}

/// How many shadows are alive within `REACH` of any running wolf.
fn shadows_in_reach(s: Sim) -> int {
    var n = 0
    for sh in s.shadows {
        if shadow_alive(sh) {
            let w = copy s.wolves[sh.target]
            if w.state != FAINTED && reach_dist(sh.x, sh.y, w.x, w.y) <= REACH * world.FP {
                n += 1
            }
        }
    }
    n
}

fn zero_slots() -> List[int] {
    var xs = List[int]()
    var i = 0
    while i < PACK_SIZE { (mut xs).push(0); i += 1 }
    xs
}

/// Alternating groups: the leaders and left flanker, then right flanker
/// and alpha. Only accepted leaps alternate; refusals do not.
pub fn leap_member(group: int, slot: int) -> bool {
    if group == 0 then slot < 3 else slot >= 3
}

/// One shared integer arc: out and back at at most half a cell per tick,
/// pointing toward (dx, dy). Its apex is ticks/4 cells away (two for the
/// pack's eight ticks, three for a twelve-tick shadow arc). No clock.
pub fn leap_arc(dx: int, dy: int, age: int, ticks: int) -> (int, int) {
    if age <= 0 || age >= ticks { return (0, 0) }
    let n = if age <= ticks / 2 then age else ticks - age
    let span = if abs(dx) > abs(dy) then abs(dx) else abs(dy)
    if span == 0 { return (0, 0) }
    let travel = n * world.FP / 2
    (dx * travel / span, dy * travel / span)
}

/// A presented body's offset, separate from physics and the alpha's eye.
fn pose_offset(s: Sim, k: int) -> (int, int) {
    if k < PACK_SIZE { return (s.leap_x[k], s.leap_y[k]) }
    if k < PACK_SIZE + s.shadows.len {
        let sh = copy s.shadows[k - PACK_SIZE]
        return (sh.pose_x, sh.pose_y)
    }
    (0, 0)
}

/// Clip every substep of an arc against live presented bodies. Sampling
/// at 1/8 cell cannot tunnel across a two-cell footprint; stop before the
/// first contact. The physical hit envelope and separation stay unchanged.
fn safe_displacement(s: Sim, k: int, ox: int, oy: int) -> (int, int) {
    let span = if abs(ox) > abs(oy) then abs(ox) else abs(oy)
    let steps = span / (world.FP / 8) + 1
    let (x, y, _) = body(s, k)
    var safe_x = 0
    var safe_y = 0
    var n = 1
    while n <= steps {
        let nx = ox * n / steps
        let ny = oy * n / steps
        if x + nx < 3 * world.FP / 2 || x + nx > s.cols * world.FP - 3 * world.FP / 2 { break }
        var blocked = false
        var j = 0
        while j < body_count(s) {
            let (bx, by, live) = body(s, j)
            let (px, py) = pose_offset(s, j)
            if j != k &&
                live &&
                abs(x + nx - bx - px) < BODY_W * world.FP &&
                abs(y + ny - by - py) < BODY_H * world.FP {
                blocked = true
            }
            j += 1
        }
        if blocked { break }
        safe_x = nx
        safe_y = ny
        n += 1
    }
    (safe_x, safe_y)
}

/// The pack's six-grid-cell out-and-back arc, before body clipping.
/// Its eight ticks follow the tell; no physics or camera position changes.
pub fn leap_displacement(aim: Aim, age: int) -> (int, int) {
    if age <= 0 || age >= LEAP_TICKS { return (0, 0) }
    let n = if age <= LEAP_TICKS / 2 then age else LEAP_TICKS - age
    let travel = LEAP_RANGE * world.FP * n / (LEAP_TICKS / 2)
    (aim.x * travel, aim.y * travel)
}

fn update_leap_poses(mut s: Sim) {
    var i = 0
    if s.leap_left == 0 || s.leap_tell { return }
    let age = LEAP_TICKS - s.leap_left + 1
    i = 0
    while i < PACK_SIZE {
        if leap_member(s.leap_group, i) && s.wolves[i].state == RUNNING {
            let (ox, oy) = leap_displacement(s.leap_aim, age)
            let (dx, dy) = safe_displacement(s, i, ox, oy)
            s.leap_x[i] = dx
            s.leap_y[i] = dy
        }
        i += 1
    }
    s.leap_landing = s.leap_left == 1
    s.leap_left -= 1
}

fn update_attack_poses(mut s: Sim) {
    var i = 0
    while i < PACK_SIZE {
        s.leap_x[i] = 0
        s.leap_y[i] = 0
        i += 1
    }
    var k = 0
    while k < s.shadows.len {
        var sh = copy s.shadows[k]
        sh.pose_x = 0
        sh.pose_y = 0
        s.shadows[k] = sh
        k += 1
    }
    k = 0
    while k < s.shadows.len {
        var sh = copy s.shadows[k]
        if shadow_alive(sh) {
            var ox = 0
            var oy = 0
            if shadow_crouching(sh) {
                // Gather backwards for three half-cell beats, hold for
                // three. This opens a readable gap even on a tight flank.
                let elapsed = ATTACK_WINDUP - sh.windup
                let age = if elapsed < 3 then elapsed else 3
                let (x, y) = leap_arc(0 - sh.attack_dx, 0 - sh.attack_dy, age, 6)
                ox = x
                oy = y
            } else if sh.state == ATTACKING || sh.attack_age > 0 {
                let (x, y) = leap_arc(
                    sh.attack_dx,
                    sh.attack_dy,
                    sh.attack_age,
                    2 * ATTACK_LUNGE_TICKS,
                )
                let (cx, cy) = leap_arc(sh.attack_dx, sh.attack_dy, 3, 6)
                if sh.attack_age <= ATTACK_LUNGE_TICKS {
                    ox = x - cx
                    oy = y - cy
                } else {
                    // After landing, settle back over six beats rather
                    // than snapping to the formation-space hitbox.
                    ox = x / 2
                    oy = y / 2
                }
            }
            let (x, y) = safe_displacement(s, PACK_SIZE + k, ox, oy)
            sh.pose_x = x
            sh.pose_y = y
            s.shadows[k] = sh
        }
        k += 1
    }
}

/// The shadow's animated world position: the same bounded arc as the
/// pack, clipped against presented bodies without changing bite reach.
pub fn shadow_draw_position(s: Sim, k: int) -> (int, int) {
    let sh = copy s.shadows[k]
    (sh.x + sh.pose_x, sh.y + sh.pose_y)
}

/// The first beat of the windup is compressed and steady-eyed.
pub fn shadow_crouching(sh: Shadow) -> bool {
    sh.state == ATTACKING && sh.windup > ATTACK_LUNGE_TICKS
}

/// A wolf's animated world position. Physics and the viewport keep the
/// formation position, so an alpha leap never moves the camera.
pub fn wolf_draw_position(s: Sim, i: int) -> (int, int) {
    (s.wolves[i].x + s.leap_x[i], s.wolves[i].y + s.leap_y[i])
}

/// Whether two presented live bodies overlap (both tiers use this bound).
pub fn any_pose_overlap(s: Sim) -> bool {
    var i = 0
    while i < body_count(s) {
        let (x, y, live) = body(s, i)
        let (px, py) = pose_offset(s, i)
        var j = i + 1
        while j < body_count(s) {
            let (bx, by, other) = body(s, j)
            let (qx, qy) = pose_offset(s, j)
            if live &&
                other &&
                abs(x + px - bx - qx) < BODY_W * world.FP &&
                abs(y + py - by - qy) < BODY_H * world.FP {
                return true
            }
            j += 1
        }
        i += 1
    }
    false
}

/// The active alternating group commits to the held compass aim. The
/// tell precedes its eight-tick collision-clipped arc; vanquishes resolve
/// at the press from that group's formation positions, never the camera.
fn leap(mut s: Sim) {
    if s.exhausted || s.stamina < LEAP_STAMINA || s.leap_ready_at > s.tick {
        return
    }
    s.stamina -= LEAP_STAMINA
    s.leap_ready_at = s.tick + LEAP_COOLDOWN
    s.leap_left = LEAP_TICKS
    s.leap_held = held_arrows(s)
    s.leap_tick = s.tick
    s.leap_aim = leap_aim(s.leap_held)
    s.leap_tell = true
    s.leap_group = s.leap_next_group
    s.leap_next_group = 1 - s.leap_next_group
    s.leap_marks_x = List[int]()
    s.leap_marks_y = List[int]()
    s.stopping = false
    var k = 0
    while k < s.shadows.len {
        var sh = copy s.shadows[k]
        if shadow_alive(sh) {
            var hit = false
            var i = 0
            while i < PACK_SIZE {
                let w = copy s.wolves[i]
                if w.state == RUNNING &&
                    leap_member(s.leap_group, i) &&
                    leap_hits(s.leap_aim, sh.x - w.x, sh.y - w.y) {
                    hit = true
                }
                i += 1
            }
            if hit {
                sh.state = VANQUISHED
                sh.fade = 0
                sh.speed = 0
                s.shadows[k] = sh
                s.vanquished += 1
                (mut s.leap_marks_x).push(sh.x)
                (mut s.leap_marks_y).push(sh.y)
            }
        }
        k += 1
    }
}

/// One tick of every shadow: perception, the chase (direction, speed,
/// heading, the move), the flock's cohesion, the attack; the health the
/// landed attacks cost is returned (a turned attack costs nothing). Gone
/// shadows are dropped from the list at the end.
fn shadows_step(mut s: Sim) -> int {
    var damage = 0
    let in_reach_before = shadows_in_reach(s)
    var k = 0
    while k < s.shadows.len {
        var sh = copy s.shadows[k]
        if sh.state == VANQUISHED {
            sh.fade += 1
            if sh.fade >= FADE_TICKS {
                sh.state = GONE
            }
            s.shadows[k] = sh
            k += 1
            continue
        }
        if sh.state == GONE {
            k += 1
            continue
        }
        if sh.attack_age >= ATTACK_LUNGE_TICKS {
            sh.attack_age += 1
            if sh.attack_age >= 2 * ATTACK_LUNGE_TICKS { sh.attack_age = 0 }
        }
        // Pursuit of the nearest pack member; perception for a lurker.
        let t = if sh.state == LURKING then perceived_wolf(s, sh) else nearest_wolf(s, sh.x, sh.y)
        if t >= 0 {
            sh.target = t
        }
        let w = copy s.wolves[sh.target]
        if sh.state == LURKING {
            if t >= 0 {
                sh.state = CHASING
            }
        }
        if sh.state != LURKING {
            if sh.recoil > 0 {
                // The parry's knock-back: half a cell a tick away from the
                // target, the speed lost.
                sh.recoil -= 1
                sh.speed = 0
                let away = if sh.y >= w.y then 1 else -1
                sh.y += away * PARRY_PUSH * world.FP / PARRY_RECOIL
            } else {
                // Where it wants to go: up the path after a pack that
                // passed it at the chase speed, down the path toward an
                // oncoming pack at the stalk, level with a target in reach.
                let want_dir = if w.y > sh.y then 1 else -1
                var want_speed = if want_dir > 0 then scaled(s, CHASE_V) else scaled(s, STALK_V)
                if abs(w.y - sh.y) <= REACH * world.FP && want_dir == sh.dir {
                    want_speed = if w.speed < want_speed then w.speed else want_speed
                }
                if want_dir != sh.dir {
                    // Decelerate; the direction flips only at rest (no pivot).
                    sh.speed = toward(sh.speed, 0, scaled(s, SHADOW_BRAKE))
                    if sh.speed == 0 {
                        sh.dir = want_dir
                    }
                } else {
                    sh.speed = toward(
                        sh.speed,
                        want_speed,
                        if want_speed < sh.speed {
                            scaled(s, SHADOW_BRAKE)
                        } else {
                            scaled(s, SHADOW_ACCEL)
                        },
                    )
                }
                // The lateral heading turns toward the target's column at
                // the turn rate; the move is the heading's split of the
                // speed along its direction.
                let off = w.x - sh.x
                let aim = if off > FLANK * world.FP {
                    STEER_HEADING
                } else if off < 0 - FLANK * world.FP {
                    0 - STEER_HEADING
                } else {
                    0
                }
                sh.heading = toward(sh.heading, aim, SHADOW_TURN_RATE)
                // Sideways it runs: a shadow cuts across to the pack at the
                // chase speed's split even while it stalks slowly along the
                // path, or it would hang in the verge for seconds.
                let (vx, _) = split(scaled(s, CHASE_V), sh.heading)
                let (_, vy) = split(sh.speed, sh.heading)
                var nx = sh.x + vx
                // Cohesion toward the other chasing shadows within
                // FLOCK_CELLS, bounded.
                let (cx, cy) = cohesion(s, k)
                nx += cx
                sh.x = clamp_x(nx, s.cols)
                sh.y += sh.dir * vy + cy
            }
            // The attack: in reach, wind up; landing, cost health unless a
            // parry turns it; then the cooldown.
            if sh.cooldown > 0 {
                sh.cooldown -= 1
            }
            let w2 = copy s.wolves[sh.target]
            let near = reach_dist(sh.x, sh.y, w2.x, w2.y) <= REACH * world.FP
            if sh.state == ATTACKING {
                if !near {
                    sh.state = CHASING
                    sh.windup = 0
                    // An interrupted lunge comes back along its arc.
                    if sh.attack_age > 0 { sh.attack_age = 2 * ATTACK_LUNGE_TICKS - sh.attack_age }
                } else {
                    if sh.windup == ATTACK_LUNGE_TICKS {
                        sh.attack_dx = w2.x - sh.x
                        sh.attack_dy = w2.y - sh.y
                    }
                    if sh.windup <= ATTACK_LUNGE_TICKS {
                        sh.attack_age = ATTACK_LUNGE_TICKS - sh.windup + 1
                    }
                    sh.windup -= 1
                    if sh.windup <= 0 {
                        if s.tick < s.parry_until {
                            s.turned += 1
                            sh.recoil = PARRY_RECOIL
                            sh.speed = 0
                        } else {
                            damage += if in_reach_before >= 2 then DAMAGE else DAMAGE_LONE
                            s.landed += 1
                        }
                        sh.state = CHASING
                        sh.cooldown = ATTACK_COOLDOWN
                    }
                }
            } else if near && sh.cooldown == 0 && sh.recoil == 0 {
                sh.state = ATTACKING
                sh.windup = ATTACK_WINDUP
                sh.attack_age = 0
                sh.attack_dx = w2.x - sh.x
                sh.attack_dy = w2.y - sh.y
            }
        }
        // Shaken, or never woken: far enough behind the alpha, it is gone.
        if sh.y < alpha(s).y - GONE_ROWS * world.FP {
            sh.state = GONE
        }
        s.shadows[k] = sh
        k += 1
    }
    // Drop the gone, keeping order (the pairs' order is the seed's).
    var n = 0
    k = 0
    while k < s.shadows.len {
        if s.shadows[k].state != GONE {
            if n != k {
                s.shadows[n] = copy s.shadows[k]
            }
            n += 1
        }
        k += 1
    }
    while s.shadows.len > n {
        let _ = (mut s.shadows).pop() else lurker(s, 0, 1)
    }
    damage
}

/// The cohesion pull on shadow `k`: toward the centre of the other alive
/// chasing shadows within `FLOCK_CELLS`, a fraction of the offset a tick,
/// bounded.
fn cohesion(s: Sim, k: int) -> (int, int) {
    let me = copy s.shadows[k]
    var sx: int = 0
    var sy: int = 0
    var n = 0
    var j = 0
    while j < s.shadows.len {
        if j != k {
            let o = copy s.shadows[j]
            if o.state == CHASING || o.state == ATTACKING {
                if reach_dist(me.x, me.y, o.x, o.y) <= FLOCK_CELLS * world.FP {
                    sx += o.x
                    sy += o.y
                    n += 1
                }
            }
        }
        j += 1
    }
    if n == 0 {
        return (0, 0)
    }
    (
        clamp((sx / n - me.x) / COHESION, 0 - COHESION_MAX, COHESION_MAX),
        clamp((sy / n - me.y) / COHESION, 0 - COHESION_MAX, COHESION_MAX),
    )
}

// The deer (pk03).

/// The deer rate at the alpha's row (`world.deer_rate`), thousandths a
/// tick.
pub fn deer_rate(s: Sim) -> int {
    trail.deer_rate(s.seed, alpha(s).y / world.FP)
}

/// Whether the tick's roll brings a deer: the world's hash of the tick
/// (salted apart from the shadows' roll) against `rate` thousandths. Pure.
pub fn deer_roll(seed: int, tick: int, rate: int) -> bool {
    world.hash(seed + 6000, tick, 1, 1000) < rate
}

/// How many deer are alive now.
pub fn deer_alive(s: Sim) -> int {
    var n = 0
    for d in s.deer {
        if d.state != DEER_GONE {
            n += 1
        }
    }
    n
}

/// A deer's row on the screen (its body's), by the alpha's eye.
pub fn deer_screen_row(s: Sim, k: int) -> int {
    wolf_row(s) - (s.deer[k].y / world.FP - alpha(s).y / world.FP)
}

/// A deer's screen column.
pub fn deer_screen_col(s: Sim, k: int) -> int {
    s.deer[k].x / world.FP
}

/// A deer standing on the path at world row `row`, `off` FP units from the
/// path's centre, facing down the path at a walk (it grazes toward the
/// oncoming pack until it sees it).
pub fn grazer(s: Sim, row: int, off: int) -> Deer {
    let (centre, _) = trail.path(s.seed, s.cols, row)
    Deer {
        id: s.deer_spawned,
        x: clamp_x(centre + off, s.cols),
        y: row * world.FP,
        heading: 0,
        speed: 0,
        dir: -1,
        state: DEER_WANDERING,
        stamina: DEER_STAMINA,
        tired: false,
    }
}

/// Spawn a deer: roll the tick against the deer rate; one appears on the
/// path one row above the top of the screen, at a column the seed picks
/// across the path's width, while fewer than `DEER_MAX` are alive. Deer
/// are the seed's, never a replay event, as the shadows are.
fn spawn_deer(mut s: Sim) {
    if deer_alive(s) >= DEER_MAX || !deer_roll(s.seed, s.tick, deer_rate(s)) {
        return
    }
    let row = world_row(s, 0) + 1
    let (_, half) = trail.path(s.seed, s.cols, row)
    let span = 2 * half / world.FP
    let off = world.hash(s.seed + 6000, s.tick, 2, if span > 0 then span else 1) * world.FP - half
    (mut s.deer).push(grazer(s, row, off))
    s.deer_spawned += 1
}

/// Place `n` deer wandering ahead of the pack at once (the perf gate's
/// `--bench-deer`; nothing in a game calls it).
pub fn seed_deer(mut s: Sim, n: int) {
    var k = 0
    while k < n {
        let row = alpha(s).y / world.FP + 8 + 4 * k
        (mut s.deer).push(grazer(s, row, (k % 3 - 1) * 3 * world.FP))
        s.deer_spawned += 1
        k += 1
    }
}

/// One tick of every deer: perception (flight within `DEER_PERCEIVE`,
/// calm again beyond it plus `DEER_CALM`), stamina (flight drains it,
/// walking returns it; tired below the trot), the wander (a seeded
/// heading across the path, the walk's direction from the same noise,
/// turned back past the verge) or the flight (along the path away from
/// the nearest wolf, toward the path's centre), the move under the realism
/// bars (the direction flips only at rest), the catch (a running wolf
/// within `CATCH_REACH` brings it down: the pack is fed `FEED`, the deer
/// gone), and gone when far behind the alpha or away beyond the top. The
/// health fed is returned; gone deer are dropped at the end.
fn deer_step(mut s: Sim) -> int {
    var feed = 0
    var k = 0
    while k < s.deer.len {
        var d = copy s.deer[k]
        if d.state == DEER_GONE {
            k += 1
            continue
        }
        let t = nearest_wolf(s, d.x, d.y)
        let w = copy s.wolves[t]
        let dist = reach_dist(d.x, d.y, w.x, w.y)
        if dist <= CATCH_REACH * world.FP {
            // Brought down: the pack feeds, the deer is gone.
            feed += FEED
            s.fed += 1
            d.state = DEER_GONE
            s.deer[k] = d
            k += 1
            continue
        }
        if d.state == DEER_FLEEING {
            if dist > (DEER_PERCEIVE + DEER_CALM) * world.FP {
                d.state = DEER_WANDERING
            }
        } else if dist <= DEER_PERCEIVE * world.FP {
            d.state = DEER_FLEEING
        }
        if d.state == DEER_FLEEING {
            d.stamina -= 1
            if d.stamina <= 0 {
                d.stamina = 0
                d.tired = true
            }
        } else if s.tick % DEER_REGEN_TICKS == 0 {
            d.stamina = clamp(d.stamina + 1, 0, DEER_STAMINA)
        }
        if d.tired && d.stamina >= DEER_RECOVER {
            d.tired = false
        }
        let (centre, half) = trail.path(s.seed, s.cols, d.y / world.FP)
        var want_dir = d.dir
        var want_speed = scaled(s, DEER_WALK_V)
        var aim = 0
        if d.state == DEER_FLEEING {
            // Away from the wolf along the path, and onto the path's
            // centre, where the running is.
            want_dir = if d.y >= w.y then 1 else -1
            want_speed = scaled(s, if d.tired then DEER_TIRED_V else FLEE_V)
            let off = centre - d.x
            aim = if off > world.FP {
                STEER_HEADING / 2
            } else if off < 0 - world.FP {
                0 - STEER_HEADING / 2
            } else {
                0
            }
        } else {
            // The wander: slow seeded noise across the path, the walk's
            // direction from a slower channel's sign; a deer past the
            // verge turns back toward the path.
            let n = world.noise(s.seed + 3000 + d.id, 7, s.tick)
            aim = (n - world.FP / 2) * STEER_HEADING / (world.FP / 2)
            want_dir = if world.noise(s.seed + 4000 + d.id, 8, s.tick / 4) >= world.FP / 2 {
                1
            } else {
                -1
            }
            let off = d.x - centre
            if abs(off) > half + world.FP {
                aim = if off > 0 then 0 - STEER_HEADING else STEER_HEADING
            }
        }
        if want_dir != d.dir {
            // Brake; the direction flips only at rest (no pivot).
            d.speed = toward(d.speed, 0, scaled(s, DEER_BRAKE))
            if d.speed == 0 {
                d.dir = want_dir
            }
        } else {
            d.speed = toward(
                d.speed,
                want_speed,
                if want_speed < d.speed then scaled(s, DEER_BRAKE) else scaled(s, DEER_ACCEL),
            )
        }
        d.heading = toward(d.heading, aim, DEER_TURN_RATE)
        let (vx, vy) = split(d.speed, d.heading)
        d.x = clamp_x(d.x + vx, s.cols)
        d.y += d.dir * vy
        let a = alpha(s)
        if d.y < a.y - GONE_ROWS * world.FP ||
            d.y > a.y + (wolf_row(s) + DEER_GONE_MARGIN) * world.FP {
            d.state = DEER_GONE
        }
        s.deer[k] = d
        k += 1
    }
    // Drop the gone, keeping order.
    var n = 0
    k = 0
    while k < s.deer.len {
        if s.deer[k].state != DEER_GONE {
            if n != k {
                s.deer[n] = copy s.deer[k]
            }
            n += 1
        }
        k += 1
    }
    while s.deer.len > n {
        let _ = (mut s.deer).pop() else grazer(s, 0, 0)
    }
    feed
}

/// The phase of the day from the distance, in `tier`'s units: 0 the
/// afternoon, 256 dusk, 512 night, blended between (never a step).
pub fn phase(s: Sim) -> int {
    phase_at(distance_cells(s))
}

/// The phase at a distance in rows. Pure.
pub fn phase_at(rows: int) -> int {
    if rows <= DUSK_START {
        return 0
    }
    if rows < DUSK_FULL {
        return (rows - DUSK_START) * 256 / (DUSK_FULL - DUSK_START)
    }
    if rows < NIGHT_FULL {
        return 256 + (rows - DUSK_FULL) * 256 / (NIGHT_FULL - DUSK_FULL)
    }
    512
}

/// Seconds the run lasted (to its death, or so far).
pub fn seconds(s: Sim) -> int {
    (if s.dead then s.died_tick else s.tick) / 30
}

/// The score: shadows vanquished × 100 + seconds survived × 2 + the
/// distance in cells (the campaign's formula).
pub fn score(s: Sim) -> int {
    s.vanquished * 100 + seconds(s) * 2 + distance_cells(s)
}
