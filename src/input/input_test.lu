//! The decoder's table tests: every control from byte strings, whole and
//! split at every byte, the lone-ESC timeout, and the ignored forms.

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn decode_whole(s: str) -> List[int] {
    var d = new()
    var keys = List[int]()
    feed_all(mut d, bytes_of(s), 1000, mut keys)
    flush(mut d, 1000 + ESC_TIMEOUT_MS, mut keys)
    keys
}

fn decode_split(s: str, at: int) -> List[int] {
    var d = new()
    var keys = List[int]()
    let bs = bytes_of(s)
    var i = 0
    while i < bs.len {
        // The second read arrives 10 ms later: well inside the ESC timeout.
        feed(mut d, bs[i], if i < at then 1000 else 1010, mut keys)
        i += 1
    }
    flush(mut d, 1010 + ESC_TIMEOUT_MS, mut keys)
    keys
}

fn same_keys(a: List[int], b: List[int]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn one(k: int) -> List[int] {
    var v = List[int]()
    (mut v).push(k)
    v
}

fn check(s: str, want: List[int], what: str) {
    let got = decode_whole(s)
    assert(same_keys(got, want), "{what}: whole read gave {got}, want {want}")
    var at = 1
    while at < s.len {
        let split = decode_split(s, at)
        assert(same_keys(split, want), "{what}: split at {at} gave {split}, want {want}")
        at += 1
    }
}

fn test_csi_arrows() {
    check("\x1b[A", one(KEY_UP), "CSI up")
    check("\x1b[B", one(KEY_DOWN), "CSI down")
    check("\x1b[C", one(KEY_RIGHT), "CSI right")
    check("\x1b[D", one(KEY_LEFT), "CSI left")
}

fn test_ss3_arrows() {
    check("\x1bOA", one(KEY_UP), "SS3 up")
    check("\x1bOB", one(KEY_DOWN), "SS3 down")
    check("\x1bOC", one(KEY_RIGHT), "SS3 right")
    check("\x1bOD", one(KEY_LEFT), "SS3 left")
}

fn test_shift_down_is_parry() {
    check("\x1b[1;2B", one(KEY_PARRY), "Shift+Down")
    check("\x1b[1;2A", one(KEY_UP), "Shift+Up is Up")
    check("\x1b[1;2C", one(KEY_RIGHT), "Shift+Right is Right")
    check("\x1b[1;2D", one(KEY_LEFT), "Shift+Left is Left")
}

fn test_other_modifiers_are_the_bare_arrow() {
    check("\x1b[1;3B", one(KEY_DOWN), "Alt+Down")
    check("\x1b[1;5B", one(KEY_DOWN), "Ctrl+Down")
    check("\x1b[1;6B", one(KEY_DOWN), "Shift+Ctrl+Down")
    check("\x1b[1;4B", one(KEY_DOWN), "Shift+Alt+Down")
}

fn test_plain_keys() {
    check(" ", one(KEY_LEAP), "space")
    check("z", one(KEY_PARRY), "z")
    check("Z", one(KEY_PARRY), "Z")
    check("q", one(KEY_QUIT), "q")
    check("Q", one(KEY_QUIT), "Q")
    check("\x03", one(KEY_INTERRUPT), "Ctrl-C")
    check("-", one(KEY_HEALTH_DOWN), "- (debug: health down)")
    check("_", one(KEY_HEALTH_DOWN), "_")
    check("=", one(KEY_HEALTH_UP), "= (debug: health up)")
    check("+", one(KEY_HEALTH_UP), "+")
    check("s", one(KEY_SAVE), "s (the card: save the replay)")
    check("S", one(KEY_SAVE), "S")
}

fn test_lone_esc_waits_for_the_timeout() {
    var d = new()
    var keys = List[int]()
    feed(mut d, 27 as byte, 500, mut keys)
    flush(mut d, 500 + ESC_TIMEOUT_MS - 1, mut keys)
    assert(keys.len == 0 && esc_pending(d), "not yet")
    assert(esc_deadline_ms(d) == 550, "the deadline is 50 ms after the ESC")
    flush(mut d, 500 + ESC_TIMEOUT_MS, mut keys)
    assert(same_keys(keys, one(KEY_QUIT)) && !esc_pending(d), "Esc at the timeout")
}

fn test_esc_then_bracket_late_is_still_a_sequence() {
    // The bracket arrives 40 ms after the ESC: inside the timeout, so the
    // sequence completes and no Esc is guessed.
    var d = new()
    var keys = List[int]()
    feed(mut d, 27 as byte, 0, mut keys)
    flush(mut d, 40, mut keys)
    feed(mut d, 91 as byte, 40, mut keys)
    feed(mut d, 66 as byte, 41, mut keys)
    assert(same_keys(keys, one(KEY_DOWN)), "Down, not Esc then junk: {keys}")
}

fn test_esc_then_plain_byte_is_esc_and_the_byte() {
    var want = List[int]()
    (mut want).push(KEY_QUIT)
    (mut want).push(KEY_LEAP)
    check("\x1b ", want, "Alt+Space")
}

fn test_ignored_forms() {
    var d = new()
    var keys = List[int]()
    feed_all(mut d, bytes_of("\x1b[57;2u"), 0, mut keys)
    feed_all(mut d, bytes_of("\x1b[5~"), 0, mut keys)
    feed_all(mut d, bytes_of("\x1b[2;1;3m"), 0, mut keys)
    feed_all(mut d, bytes_of("\x1bOP"), 0, mut keys)
    assert(keys.len == 0, "nothing decoded: {keys}")
    assert(d.ignored == 4, "four ignored: {d.ignored}")
}

fn test_unknown_bytes_are_dropped_and_counted() {
    var d = new()
    var keys = List[int]()
    feed_all(mut d, bytes_of("ab\x7f\x01"), 0, mut keys)
    assert(keys.len == 0 && d.dropped == 4, "dropped {d.dropped}")
}

fn test_two_sequences_in_one_read() {
    var want = List[int]()
    (mut want).push(KEY_LEFT)
    (mut want).push(KEY_PARRY)
    (mut want).push(KEY_LEAP)
    check("\x1b[D\x1b[1;2B ", want, "left, parry, leap")
}

fn test_key_names_round_trip() {
    var k = 1
    while k <= 8 {
        let back = key_of(key_name(k)) else -1
        assert(back == k, "name of {k}")
        k += 1
    }
    let bad = key_of("sideways") else -1
    assert(bad == -1, "an unknown name is parse")
}

fn test_title_keys_and_text_mode() {
    var d = new()
    var keys = List[int]()
    feed(mut d, 114 as byte, 0, mut keys)
    feed(mut d, 80 as byte, 0, mut keys)
    feed(mut d, 47 as byte, 0, mut keys)
    assert(
        keys.len == 3 && keys[0] == KEY_RESTART && keys[1] == KEY_PLAY && keys[2] == KEY_PROMPT,
        "r, P and / are the title's keys: {keys}",
    )
    // Text mode: letters are characters, Enter and Backspace keys, Esc the
    // quit (the cancel), an arrow still an arrow.
    set_text(mut d, true)
    (mut keys).reset()
    for b in "aq/".bytes() {
        feed(mut d, b, 0, mut keys)
    }
    feed(mut d, 127 as byte, 0, mut keys)
    feed(mut d, 13 as byte, 0, mut keys)
    assert(keys.len == 5, "five keys: {keys}")
    assert(
        char_of(keys[0]) == 97 && char_of(keys[1]) == 113 && char_of(keys[2]) == 47,
        "the characters",
    )
    assert(keys[3] == KEY_BACKSPACE && keys[4] == KEY_ENTER, "backspace and enter")
    assert(char_of(KEY_ENTER) == -1 && char_of(KEY_UP) == -1, "a key is no character")
    (mut keys).reset()
    for b in "\x1b[A".bytes() {
        feed(mut d, b, 0, mut keys)
    }
    assert(keys.len == 1 && keys[0] == KEY_UP, "an arrow in text mode")
    (mut keys).reset()
    feed(mut d, 27 as byte, 0, mut keys)
    flush(mut d, ESC_TIMEOUT_MS + 1, mut keys)
    assert(keys.len == 1 && keys[0] == KEY_QUIT, "a lone Esc in text mode is the quit")
    set_text(mut d, false)
    (mut keys).reset()
    feed(mut d, 97 as byte, 0, mut keys)
    assert(keys.len == 0, "out of text mode a letter is dropped")
}
