//! replay — the `.pk` file (`docs/REPLAY.md`): a run as a seed, a tier, a
//! size and timestamped inputs, enough to reproduce it exactly (campaign
//! innovation 1). The same text is the headless script. Line-oriented,
//! plain text, one fact a line:
//!
//!     pk 1
//!     seed 42
//!     tier rich
//!     size 80x24
//!     t 30 up
//!     t 95 size 100x30
//!
//! `pk 1` is the version. Events are `t TICK KEY` (a key name as `input`
//! names them) or `t TICK size WxH` (a resize), ticks non-decreasing. A
//! blank line or one starting `#` is ignored. `parse` names a line that
//! is none of these (the parser's row carries nothing more: the file is
//! small and a reader reads it).

/// A resize event's key (no key); `cols` and `rows` carry the size.
pub const EV_SIZE: int = 0

/// One event: at `tick`, a key (as `input` numbers them) or, with `key`
/// `EV_SIZE`, a resize to `cols` by `rows`.
pub struct Event {
    tick: int,
    key: int,
    cols: int,
    rows: int,
}

/// A replay.
pub struct Replay {
    seed: int,
    tier: int,
    cols: int,
    rows: int,
    events: List[Event],
}

/// An empty replay with the given header.
pub fn new(seed: int, tier: int, cols: int, rows: int) -> Replay {
    Replay { seed: seed, tier: tier, cols: cols, rows: rows, events: List[Event]() }
}

/// Record a key at a tick.
pub fn push_key(mut r: Replay, tick: int, key: int) {
    (mut r.events).push(Event { tick: tick, key: key, cols: 0, rows: 0 })
}

/// Record a resize at a tick.
pub fn push_size(mut r: Replay, tick: int, cols: int, rows: int) {
    (mut r.events).push(Event { tick: tick, key: EV_SIZE, cols: cols, rows: rows })
}

/// The keys at `tick`, pushed onto `keys` in file order; the last resize
/// at that tick as `(cols, rows)`, or `(0, 0)` when none.
pub fn at(r: Replay, tick: int, mut keys: List[int]) -> (int, int) {
    var size = (0, 0)
    for e in r.events {
        if e.tick == tick {
            if e.key == EV_SIZE {
                size = (e.cols, e.rows)
            } else {
                (mut keys).push(e.key)
            }
        }
    }
    size
}

/// The last tick any event names (0 for none).
pub fn last_tick(r: Replay) -> int {
    var t = 0
    for e in r.events {
        if e.tick > t {
            t = e.tick
        }
    }
    t
}

/// Parse `WxH`.
pub fn parse_size(s: str) -> (int, int) ! {parse} {
    let (w, h) = s.split_once("x") else |_| {
        return parse
    }
    let cols = w.trim().to_int()?
    let rows = h.trim().to_int()?
    if cols < 1 || rows < 1 {
        return parse
    }
    (cols, rows)
}

/// The key number a name means (`input.key_of`, repeated here so this
/// module imports nothing but the prelude).
fn key_of(name: str) -> int ! {parse} {
    if name == "up" {
        return 1
    }
    if name == "down" {
        return 2
    }
    if name == "left" {
        return 3
    }
    if name == "right" {
        return 4
    }
    if name == "parry" {
        return 5
    }
    if name == "leap" {
        return 6
    }
    if name == "quit" {
        return 7
    }
    if name == "interrupt" {
        return 8
    }
    parse
}

fn key_name(k: int) -> str {
    if k == 1 {
        return "up"
    }
    if k == 2 {
        return "down"
    }
    if k == 3 {
        return "left"
    }
    if k == 4 {
        return "right"
    }
    if k == 5 {
        return "parry"
    }
    if k == 6 {
        return "leap"
    }
    if k == 7 {
        return "quit"
    }
    if k == 8 {
        return "interrupt"
    }
    "none"
}

/// Read a `.pk` text. `parse` for a missing header line, an unknown
/// word, a bad number, a tick that goes backwards, or a version that is
/// not 1.
pub fn from_text(text: str) -> Replay ! {parse} {
    var r = new(0, 0, 0, 0)
    var have_version = false
    var have_seed = false
    var have_tier = false
    var have_size = false
    var last = 0
    for raw in text.lines() {
        let line = raw.trim()
        if line.len == 0 || line.starts_with("#") {
            continue
        }
        let words = line.words()
        if words.len < 2 {
            return parse
        }
        let w0 = words[0]
        if w0 == "pk" {
            if words[1] != "1" {
                return parse
            }
            have_version = true
        } else if w0 == "seed" {
            r.seed = words[1].to_int()?
            have_seed = true
        } else if w0 == "tier" {
            if words[1] == "rich" {
                r.tier = 1
            } else if words[1] == "plain" {
                r.tier = 0
            } else {
                return parse
            }
            have_tier = true
        } else if w0 == "size" {
            let (c, rows) = parse_size(words[1])?
            r.cols = c
            r.rows = rows
            have_size = true
        } else if w0 == "t" {
            if words.len < 3 {
                return parse
            }
            let tick = words[1].to_int()?
            if tick < last || tick < 0 {
                return parse
            }
            last = tick
            if words[2] == "size" {
                if words.len < 4 {
                    return parse
                }
                let (c, rows) = parse_size(words[3])?
                push_size(mut r, tick, c, rows)
            } else {
                push_key(mut r, tick, key_of(words[2])?)
            }
        } else {
            return parse
        }
    }
    if !have_version || !have_seed || !have_tier || !have_size {
        return parse
    }
    r
}

fn push_str(mut out: List[byte], s: str) {
    for b in s.bytes() {
        (mut out).push(b)
    }
}

/// The `.pk` text of `r`, as bytes.
pub fn format(r: Replay, mut out: List[byte]) {
    push_str(mut out, "pk 1\n")
    push_str(mut out, "seed {r.seed}\n")
    push_str(mut out, "tier {if r.tier == 1 then "rich" else "plain"}\n")
    push_str(mut out, "size {r.cols}x{r.rows}\n")
    for e in r.events {
        if e.key == EV_SIZE {
            push_str(mut out, "t {e.tick} size {e.cols}x{e.rows}\n")
        } else {
            push_str(mut out, "t {e.tick} {key_name(e.key)}\n")
        }
    }
}
