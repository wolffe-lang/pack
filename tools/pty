#!/usr/bin/env python3
"""tools/pty — drive the real binary in a pseudo-terminal and measure what
the terminal layer promises (campaign rule 4: restored on every exit path).

    python3 -I tools/pty [--bin target/release/pack]
                         [--rows quit,ctrl-c,trap,agree-rich,agree-plain,held-run,card,title] [--keep]

A holder process is the pty's session leader so the terminal outlives the
program (on macOS the slave is revoked when its session leader exits); it
runs the game as a job in its own foreground process group, the way a shell
does, and records the terminal's settings before and after. The rows:

  quit        keys typed (Down, Shift+Down, Space, z), then q: exit 0, the
              alternate screen entered and left, the cursor hidden then
              shown, raw mode undone (stty -a before and after equal, less
              `pendin` on macOS, which the kernel sets after any return to
              canonical mode, and less the window size), the leave bytes last.
  ctrl-c      the same, ended by the byte 0x03 typed into the pty: the line
              discipline raises the interrupt for the foreground group, the
              game alone, which hears it as a meaning (std.signal) and ends
              its loop cleanly: exit 0 and the same restore assertions.
  trap        `--trap-at 20`: the process traps (exit 134, `wolf-trap` on
              stderr) and the runtime restores: the same assertions on the
              terminal.
  agree-TIER  `--replay tests/cases/steer-forest.pk --ticks 120 --tier TIER`
              in an 80x24 pty: the captured bytes replayed through the
              terminal model (`pack --apply`) equal the headless run's final
              frame of the same case and tier, cell for cell, styles too.
  held-run    the input drift the maintainer felt (pk01): Left typed as a
              held key, one `ESC [ D` every 33 ms for a second (a terminal's
              autorepeat; there is no key-up), then nothing. Under `--trace`
              the game prints one line a tick; the row reads the tick of the
              last byte and asserts that the heading stops turning further
              within HELD_STOP_TICKS of it and is straight again, the wolf's
              column at rest, within HELD_STRAIGHT_TICKS: the hold ends when
              the repeats end, and the heading returns at the turn rate, not
              by a slow relaxation.

  card        the complete loop (pk02): `--seed 16 --debug --trace --record
              target/pty/card.pk --no-title`, the debug key `-` typed ten times (health
              to zero: the alpha alone), the shadows' first landed attack
              ends the run (the trace's `dead 1`), then `s` saves the replay
              and `q` leaves: exit 0 and the restore assertions; the closing
              line names the death and the saved file; the saved `.pk`
              parses, ends with the quit, and re-run headless twice gives
              byte-identical frames; the screen captured before `s` (the
              card) equals the headless final frame of the saved replay,
              cell for cell: a replay reproduces the run through its death.

  title       the title card (pk03), under a HOME of its own (target/pty/home,
              so the maintainer's ~/.pack/best is never touched): the game
              starts on the title (`any key to run` captured), `r` runs seed
              16 under --debug --trace --record, `-` ten times, the death, `s`
              saves the replay (with its score comment), `q` returns to the
              title (the last score and the saved name shown, the best file
              written with them), `r` runs the SAME seed again (the trace's
              tick count restarts; the closing lines name seed 16 twice),
              `q` back to the title, `p` plays the saved replay (its card
              says `verified`), `q` to the title, `q` leaves: exit 0 and the
              restore assertions.

The rows other than `title` and `agree-*` pass `--no-title`, so the run
starts at once as every build before pk03 did.

Exit 0 when every row passes; each row prints one line. Captures are kept
under target/pty/ with --keep (and always for a failed row).
"""
import argparse, fcntl, os, pty, re, select, struct, subprocess, sys, termios, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ENTER_ALT, LEAVE_ALT = b"\x1b[?1049h", b"\x1b[?1049l"
HIDE, SHOW = b"\x1b[?25l", b"\x1b[?25h"
LEAVE_BYTES = b"\x1b[0m\x1b[?25h\x1b[?1049l"


def stty_words(text):
    """stty -a's words less what a run may legitimately change: the window
    size (digits) and macOS's `pendin` state flag."""
    return [w for w in text.split() if w not in ("pendin", "-pendin") and not w.rstrip(";").isdigit()]


class Session:
    """A pseudo-terminal with the game running in it, the way a shell runs
    a job. A HOLDER process is the session leader and keeps the terminal
    open (on macOS the slave is revoked once its session leader exits, so
    the holder outlives the game); the game runs in its own process group,
    made the terminal's foreground group (tcsetpgrp), so what the line
    discipline raises for a typed Ctrl-C reaches the game alone. The holder
    records the terminal's settings before and after (tcgetattr, and
    `stty -a` on the slave for the record) and the game's exit status on a
    pipe. Nothing here traps, masks or sends a signal."""

    def __init__(self, argv, rows, cols, env):
        self.master, slave = pty.openpty()
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        r_rep, w_rep = os.pipe()
        r_err, w_err = os.pipe()
        r_pid, w_pid = os.pipe()
        self.pid = os.fork()
        if self.pid == 0:
            os.setsid()
            fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
            before = termios.tcgetattr(slave)
            stty_before = subprocess.run(["stty", "-a"], stdin=slave, capture_output=True, text=True).stdout
            game = os.fork()
            if game == 0:
                os.setpgid(0, 0)
                os.dup2(slave, 0); os.dup2(slave, 1); os.dup2(w_err, 2)
                os.closerange(3, 1024)
                os.execve(argv[0], argv, env)
            try:
                os.setpgid(game, game)
            except OSError:
                pass
            os.tcsetpgrp(slave, game)
            os.write(w_pid, str(game).encode())
            os.close(w_pid)
            _, st = os.waitpid(game, 0)
            after = termios.tcgetattr(slave)
            stty_after = subprocess.run(["stty", "-a"], stdin=slave, capture_output=True, text=True).stdout
            status = os.WEXITSTATUS(st) if os.WIFEXITED(st) else 128 + os.WTERMSIG(st)
            report = repr((before, after, stty_before, stty_after, status)).encode()
            os.write(w_rep, report)
            os._exit(0)
        for fd in (slave, w_rep, w_err, w_pid):
            os.close(fd)
        self.r_rep, self.r_err = r_rep, r_err
        self.out = b""
        self.err = b""
        self.eof = False
        self.pump(0.3)
        self.job = int(os.read(r_pid, 32).strip() or b"0")
        os.close(r_pid)

    def pump(self, seconds):
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            fds = [] if self.eof else [self.master]
            fds.append(self.r_err)
            r, _, _ = select.select(fds, [], [], 0.02)
            if self.master in r:
                try:
                    chunk = os.read(self.master, 65536)
                except OSError:
                    chunk = b""
                if not chunk:
                    self.eof = True
                else:
                    self.out += chunk
            if self.r_err in r:
                chunk = os.read(self.r_err, 65536)
                if chunk:
                    self.err += chunk

    def type(self, data, settle=0.08):
        os.write(self.master, data)
        self.pump(settle)

    def finish(self, timeout=30.0):
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            pid, st = os.waitpid(self.pid, os.WNOHANG)
            if pid:
                break
            self.pump(0.05)
        else:
            raise RuntimeError("the session did not end within %.0f s" % timeout)
        self.pump(0.1)
        rep = b""
        while True:
            c = os.read(self.r_rep, 65536)
            if not c:
                break
            rep += c
        os.close(self.r_rep); os.close(self.r_err); os.close(self.master)
        import ast
        self.before, self.after, self.stty_before, self.stty_after, self.status = ast.literal_eval(rep.decode())


PENDIN = 0x20000000


def termios_words(attr):
    """A termios record as comparable words, less macOS's PENDIN state flag
    (the kernel sets it after any return to canonical mode; the spec's own
    restore witness records the same) and less the speeds."""
    iflag, oflag, cflag, lflag, _, _, cc = attr
    return [iflag, oflag, cflag, lflag - (lflag & PENDIN), [c if isinstance(c, int) else c for c in cc]]


def common_checks(s, want_status, problems):
    if s.status != want_status:
        problems.append("exit status %d, wanted %d" % (s.status, want_status))
    if termios_words(s.before) != termios_words(s.after):
        problems.append("termios differs after: before %r after %r" % (termios_words(s.before)[:4], termios_words(s.after)[:4]))
    if stty_words(s.stty_before) != stty_words(s.stty_after):
        b, a = stty_words(s.stty_before), stty_words(s.stty_after)
        problems.append("stty -a differs after: %s" % " ".join(sorted(set(a) ^ set(b))))
    if ENTER_ALT not in s.out:
        problems.append("the alternate screen was never entered")
    if LEAVE_ALT not in s.out:
        problems.append("the alternate screen was never left")
    if HIDE not in s.out or SHOW not in s.out:
        problems.append("the cursor was not hidden and shown")
    if not s.out.endswith(LEAVE_BYTES):
        problems.append("the leave bytes are not the last output (tail %r)" % s.out[-40:])


def env_for(tier_term="xterm-256color"):
    return {"TERM": tier_term, "LANG": "C.UTF-8", "PATH": "/usr/bin:/bin", "HOME": os.environ.get("HOME", "/tmp")}


def keep(name, s, args):
    d = os.path.join(ROOT, "target", "pty")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, name + ".bin"), "wb") as f:
        f.write(s.out)
    with open(os.path.join(d, name + ".err"), "wb") as f:
        f.write(s.err)


def row_keys(bin, name, how):
    s = Session([bin, "--seed", "7", "--no-title"], 24, 80, env_for())
    s.pump(0.4)
    s.type(b"\x1b[B"); s.type(b"\x1b[1;2B"); s.type(b" "); s.type(b"z")
    if how == "ctrl-c":
        # The byte 0x03: the line discipline raises the interrupt for the
        # foreground group, which is the game alone.
        s.type(b"\x03")
    else:
        s.type(b"q")
    s.finish()
    problems = []
    common_checks(s, 0, problems)
    want = b"ended by the interrupt" if how == "ctrl-c" else b"ended by the quit key"
    if want not in s.err:
        problems.append("the closing line does not say %r: %r" % (want, s.err[-200:]))
    return s, problems


def row_trap(bin):
    s = Session([bin, "--seed", "7", "--trap-at", "20", "--no-title"], 24, 80, env_for())
    s.finish()
    problems = []
    common_checks(s, 134, problems)
    if b"wolf-trap" not in s.err:
        problems.append("no wolf-trap report on stderr: %r" % s.err[-200:])
    return s, problems


def row_agree(bin, tier):
    case = os.path.join(ROOT, "tests", "cases", "steer-forest.pk")
    ticks = "120"
    s = Session([bin, "--replay", case, "--ticks", ticks, "--tier", tier, "--no-truecolor"], 24, 80, env_for())
    s.finish(timeout=60)
    problems = []
    common_checks(s, 0, problems)
    if b"ended by --ticks" not in s.err:
        problems.append("the closing line does not say the run ended by --ticks: %r" % s.err[-200:])
    d = os.path.join(ROOT, "target", "pty")
    os.makedirs(d, exist_ok=True)
    cap = os.path.join(d, "agree-%s.bin" % tier)
    with open(cap, "wb") as f:
        f.write(s.out)
    applied = subprocess.run([bin, "--apply", cap, "--size", "80x24"], capture_output=True)
    if applied.returncode != 0:
        problems.append("--apply failed: %r" % applied.stderr[-200:])
        return s, problems
    text, sty, tail = applied.stdout.decode("utf-8").split("--\n")
    hd = os.path.join(ROOT, "target", "pty", "headless-%s" % tier)
    run = subprocess.run([bin, "--headless", "--script", case, "--frames", ticks, "--every", ticks,
                          "--tier", tier, "--dump", hd], capture_output=True)
    if run.returncode != 0:
        problems.append("the headless run failed: %r" % run.stderr[-200:])
        return s, problems
    want_text = open(os.path.join(hd, "final.txt"), encoding="utf-8").read()
    want_sty = open(os.path.join(hd, "final.sty"), encoding="utf-8").read()
    if text != want_text:
        for i, (a, b) in enumerate(zip(text.splitlines(), want_text.splitlines())):
            if a != b:
                problems.append("glyphs differ first at row %d:\n  pty      %r\n  headless %r" % (i, a, b))
                break
        else:
            problems.append("glyphs differ in length")
    if sty != want_sty:
        for i, (a, b) in enumerate(zip(sty.splitlines(), want_sty.splitlines())):
            if a != b:
                problems.append("styles differ first at row %d:\n  pty      %s\n  headless %s" % (i, a[:120], b[:120]))
                break
        else:
            problems.append("styles differ in length")
    if "alt_enters 1 alt_leaves 1 cursor_visible true unknown 0" not in tail:
        problems.append("the model's tail: %s" % tail.strip())
    return s, problems


# The held-run row's bars, in ticks after the last byte's tick: the heading
# stops turning further (the hold ended: one repeat interval plus the margin)
# and the heading is straight with the column at rest (the turn rate's
# return, no slow relaxation). The old model relaxed one unit a tick and
# left the heading off-axis for two seconds after the last byte.
HELD_STOP_TICKS = 2
HELD_STRAIGHT_TICKS = 10


def trace_ticks(err):
    """The per-tick trace lines as dicts (tick, in, keys, steer, heading, x, y)."""
    rows = []
    for line in err.decode(errors="replace").splitlines():
        if not line.startswith("trace tick "):
            continue
        w = line.split()
        d = {}
        for i in range(1, len(w) - 1, 2):
            try:
                d[w[i]] = int(w[i + 1])
            except ValueError:
                pass
        rows.append(d)
    return rows


def row_held_run(bin):
    s = Session([bin, "--seed", "7", "--trace", "--no-title"], 24, 80, env_for())
    s.pump(0.5)
    # A held Left: the autorepeat stream a terminal sends, one sequence a
    # tick for a second (30 bytes groups), then release.
    t_end = time.monotonic() + 1.0
    n = 0
    while time.monotonic() < t_end:
        os.write(s.master, b"\x1b[D")
        n += 1
        s.pump(0.033)
    s.pump(3.0)
    s.type(b"q")
    s.finish()
    problems = []
    common_checks(s, 0, problems)
    rows = trace_ticks(s.err)
    if len(rows) < 60:
        problems.append("only %d trace lines; is --trace printing?" % len(rows))
        return s, problems
    fed = [r for r in rows if r.get("keys", 0) > 0]
    if not fed:
        problems.append("no tick applied a key: %r" % s.err[-300:])
        return s, problems
    last = fed[-1]["tick"]
    after = [r for r in rows if r["tick"] > last]
    # 1. The heading stops turning further within HELD_STOP_TICKS.
    peak = max(abs(r["heading"]) for r in rows if r["tick"] <= last + HELD_STOP_TICKS)
    turned_more = [r["tick"] for r in after if r["tick"] > last + HELD_STOP_TICKS and abs(r["heading"]) > peak]
    if turned_more:
        problems.append("the heading kept turning after tick %d + %d (first at %d, |heading| %d over %d)" % (
            last, HELD_STOP_TICKS, turned_more[0], max(abs(r["heading"]) for r in after), peak))
    # 2. Straight, and the column at rest, within HELD_STRAIGHT_TICKS.
    straight_at = next((r["tick"] for r in after if r["heading"] == 0), None)
    if straight_at is None or straight_at > last + HELD_STRAIGHT_TICKS:
        problems.append("the heading was not straight within %d ticks of the last byte (tick %d): straight at %s; headings %s" % (
            HELD_STRAIGHT_TICKS, last, straight_at, [r["heading"] for r in after[:40]]))
    xs = [r["x"] for r in after if r["tick"] >= last + HELD_STRAIGHT_TICKS]
    rest_at = None
    for i in range(1, len(after)):
        if all(r["x"] == after[i]["x"] for r in after[i:]):
            rest_at = after[i]["tick"]
            break
    if xs and len(set(xs)) != 1:
        problems.append("the column still moved after tick %d + %d: x %s" % (last, HELD_STRAIGHT_TICKS, sorted(set(xs))[:6]))
    s.evidence = "%d sequences typed, last key at tick %d, peak |heading| %d, straight at %s, column at rest at %s" % (
        n, last, peak, straight_at, rest_at)
    return s, problems


def row_card(bin):
    d = os.path.join(ROOT, "target", "pty")
    os.makedirs(d, exist_ok=True)
    rec = os.path.join(d, "card.pk")
    if os.path.exists(rec):
        os.unlink(rec)
    s = Session([bin, "--seed", "16", "--debug", "--trace", "--record", rec, "--no-title"], 24, 80, env_for())
    s.pump(0.4)
    for _ in range(10):
        s.type(b"-", settle=0.04)
    # Wait for the death: the trace line says `dead 1` once the first landed
    # attack ends the run (seed 16: within about ten seconds).
    end = time.monotonic() + 40.0
    while time.monotonic() < end and b" dead 1 " not in s.err:
        s.pump(0.2)
    problems = []
    if b" dead 1 " not in s.err:
        s.type(b"q")
        s.finish()
        problems.append("the run did not end within 40 s: %r" % s.err[-300:])
        return s, problems
    s.pump(0.3)
    before_save = len(s.out)
    s.type(b"s", settle=0.3)
    s.type(b"q")
    s.finish()
    common_checks(s, 0, problems)
    closing = [l for l in s.err.decode(errors="replace").splitlines() if l.startswith("pack: ended")]
    line = closing[-1] if closing else ""
    if "dead at tick" not in line:
        problems.append("the closing line does not name the death: %r" % line[-300:])
    if ("saved %s" % rec) not in line:
        problems.append("the closing line does not name the saved file: %r" % line[-300:])
    if not os.path.exists(rec):
        problems.append("no replay at %s" % rec)
        return s, problems
    text = open(rec, encoding="utf-8").read()
    events = [l for l in text.splitlines() if l.startswith("t ")]
    if not events or events[-1].split()[2] != "quit":
        problems.append("the saved replay does not end with the quit: %r" % events[-3:])
        return s, problems
    if not any(l.split()[2] == "health" for l in events):
        problems.append("the saved replay carries no health event: %r" % events[:3])
    last_tick = int(events[-1].split()[1])
    frames = str(last_tick + 1)
    # The saved replay, re-run twice: byte-identical frames (the complete
    # loop reproduces).
    outs = []
    for n in (1, 2):
        hd = os.path.join(d, "card-rerun-%d" % n)
        run = subprocess.run([bin, "--headless", "--script", rec, "--frames", frames, "--every", "25",
                              "--tier", "rich", "--dump", hd], capture_output=True)
        if run.returncode != 0:
            problems.append("the headless re-run %d failed: %r" % (n, run.stderr[-200:]))
            return s, problems
        outs.append(hd)
    cmp = subprocess.run(["diff", "-r", outs[0], outs[1]], capture_output=True)
    if cmp.returncode != 0:
        problems.append("the two re-runs differ: %r" % cmp.stdout[:300])
    # The card the player saw (the capture up to the save) equals the
    # headless final frame of the saved replay.
    cap = os.path.join(d, "card.bin")
    with open(cap, "wb") as f:
        f.write(s.out[:before_save])
    applied = subprocess.run([bin, "--apply", cap, "--size", "80x24"], capture_output=True)
    if applied.returncode != 0:
        problems.append("--apply failed: %r" % applied.stderr[-200:])
        return s, problems
    text_pty, sty_pty, _ = applied.stdout.decode("utf-8").split("--\n")
    want_text = open(os.path.join(outs[0], "final.txt"), encoding="utf-8").read()
    want_sty = open(os.path.join(outs[0], "final.sty"), encoding="utf-8").read()
    if "the pack is gone" not in text_pty:
        problems.append("the captured screen shows no card")
    if text_pty != want_text:
        for i, (a, b) in enumerate(zip(text_pty.splitlines(), want_text.splitlines())):
            if a != b:
                problems.append("the card differs from the replay's at row %d:\n  pty    %r\n  replay %r" % (i, a, b))
                break
        else:
            problems.append("glyphs differ in length")
    if sty_pty != want_sty:
        problems.append("the card's styles differ from the replay's")
    s.evidence = "death in the trace, %d events saved, last tick %d, re-run twice identical" % (len(events), last_tick)
    return s, problems


def screen_text(bin, capture):
    """A capture's final screen as text through the terminal model, or ''."""
    d = os.path.join(ROOT, "target", "pty")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, "screen.bin")
    with open(path, "wb") as f:
        f.write(capture)
    applied = subprocess.run([bin, "--apply", path, "--size", "80x24"], capture_output=True)
    if applied.returncode != 0:
        return ""
    return applied.stdout.decode("utf-8").split("--\n")[0]


def row_title(bin):
    d = os.path.join(ROOT, "target", "pty")
    home = os.path.join(d, "home")
    import shutil
    shutil.rmtree(home, ignore_errors=True)
    os.makedirs(home)
    rec = os.path.join(d, "title.pk")
    if os.path.exists(rec):
        os.unlink(rec)
    env = env_for()
    env["HOME"] = home
    s = Session([bin, "--seed", "16", "--debug", "--trace", "--record", rec], 24, 80, env)
    s.pump(0.6)
    problems = []
    first = screen_text(bin, s.out)
    if "any key to run" not in first or "p a c k" not in first:
        problems.append("the title card is not on the first screen: %r" % first[:400])
    if "best   -" not in first:
        problems.append("a fresh HOME shows no best: %r" % [l for l in first.splitlines() if "best" in l])
    # r: the same seed runs; the trace starts.
    s.type(b"r", settle=0.5)
    for _ in range(10):
        s.type(b"-", settle=0.04)
    end = time.monotonic() + 40.0
    while time.monotonic() < end and b" dead 1 " not in s.err:
        s.pump(0.2)
    if b" dead 1 " not in s.err:
        s.type(b"q"); s.type(b"q")
        s.finish()
        problems.append("the first run did not end within 40 s: %r" % s.err[-300:])
        return s, problems
    s.pump(0.3)
    s.type(b"s", settle=0.3)
    before_q = len(s.out)
    s.type(b"q", settle=0.6)
    title2 = screen_text(bin, s.out)
    if "any key to run" not in title2:
        problems.append("q on the card did not return to the title: %r" % title2[:400])
    if "saved  title.pk" not in title2:
        problems.append("the title does not name the saved replay: %r" % [l for l in title2.splitlines() if "saved" in l or "last" in l])
    closing1 = [l for l in s.err.decode(errors="replace").splitlines() if l.startswith("pack: ended")]
    if len(closing1) != 1 or "dead at tick" not in closing1[0] or "seed 16" not in closing1[0]:
        problems.append("one closing line for the first run, dead, seed 16: %r" % closing1)
    score = None
    for w in closing1[0].split(";") if closing1 else []:
        if "score" in w:
            try:
                score = int(w.split("score")[-1].strip().split()[0].rstrip(","))
            except ValueError:
                pass
    if score is None:
        problems.append("no score in the closing line: %r" % closing1)
    else:
        if ("last   %d" % score) not in title2:
            problems.append("the title's last score is not %d: %r" % (score, [l for l in title2.splitlines() if "last" in l]))
        if ("best   %d" % score) not in title2:
            problems.append("the title's best is not %d" % score)
    bestfile = os.path.join(home, ".pack", "best")
    if not os.path.exists(bestfile):
        problems.append("no best file at %s" % bestfile)
    else:
        text = open(bestfile, encoding="utf-8").read()
        if score is not None and ("best %d 16 " % score) not in text:
            problems.append("the best file does not record the score: %r" % text)
        if ("saved %s" % rec) not in text:
            problems.append("the best file does not name the saved replay: %r" % text)
    if not os.path.exists(rec):
        problems.append("no replay at %s" % rec)
        s.type(b"q"); s.finish()
        return s, problems
    rtext = open(rec, encoding="utf-8").read()
    if score is not None and ("# score %d" % score) not in rtext:
        problems.append("the saved replay carries no score comment: %r" % rtext[:200])
    # r again: the SAME seed, the trace restarting at tick 1.
    err_before = len(s.err)
    s.type(b"r", settle=1.0)
    s.type(b"q", settle=0.6)
    tail = s.err[err_before:].decode(errors="replace")
    if "trace tick 1 " not in tail:
        problems.append("the second run's trace does not restart at tick 1")
    closing2 = [l for l in s.err.decode(errors="replace").splitlines() if l.startswith("pack: ended")]
    if len(closing2) != 2 or "seed 16" not in closing2[1] or "ended by the quit key" not in closing2[1]:
        problems.append("the second run: seed 16 again, ended by q: %r" % closing2[-1:])
    # p: the saved replay plays to its card, verified.
    s.type(b"p", settle=0.5)
    end = time.monotonic() + 40.0
    while time.monotonic() < end and b"replay score" not in s.err and len([l for l in s.err.decode(errors="replace").splitlines() if l.startswith("pack: ended")]) < 3:
        s.pump(0.2)
    s.pump(0.3)
    # The replay ended at its recorded quit and returned to the title; the
    # title's message names the verdict. One more q leaves.
    title3 = screen_text(bin, s.out)
    if "verified" not in title3:
        problems.append("the title does not report the replay verified: %r" % [l for l in title3.splitlines() if "verif" in l or "last" in l])
    s.type(b"q")
    s.finish()
    common_checks(s, 0, problems)
    closing = [l for l in s.err.decode(errors="replace").splitlines() if l.startswith("pack: ended")]
    if len(closing) != 3 or "replay score" not in closing[2] or "verified" not in closing[2]:
        problems.append("three runs, the third a verified replay: %r" % closing[-1:])
    s.evidence = "score %s; %d closing lines; best file %s" % (score, len(closing), "written" if os.path.exists(bestfile) else "missing")
    return s, problems


def mac_memory_ok():
    """RULES section 4's gate, nomad's alone: tools/memgate.py decides."""
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import memgate
    return memgate.check("pty")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", default=os.path.join(ROOT, "target", "release", "pack"))
    ap.add_argument("--rows", default="quit,ctrl-c,trap,agree-rich,agree-plain,held-run,card,title")
    ap.add_argument("--keep", action="store_true")
    a = ap.parse_args()
    if not mac_memory_ok():
        return 3
    bin = os.path.abspath(a.bin)
    if not os.access(bin, os.X_OK):
        print("pty: no binary at %s" % bin)
        return 2
    failed = 0
    for name in a.rows.split(","):
        try:
            if name in ("quit", "ctrl-c"):
                s, problems = row_keys(bin, name, name)
            elif name == "trap":
                s, problems = row_trap(bin)
            elif name.startswith("agree-"):
                s, problems = row_agree(bin, name.split("-", 1)[1])
            elif name == "held-run":
                s, problems = row_held_run(bin)
            elif name == "card":
                s, problems = row_card(bin)
            elif name == "title":
                s, problems = row_title(bin)
            else:
                print("pty: %s: no such row" % name)
                failed += 1
                continue
        except Exception as e:
            print("pty: %s FAILED: %s" % (name, e))
            failed += 1
            continue
        if problems or a.keep:
            keep(name, s, a)
        if problems:
            failed += 1
            print("pty: %s FAILED (%s %s):" % (name, sys.platform, os.uname().machine))
            if getattr(s, "evidence", None):
                print("  evidence: " + s.evidence)
            for p in problems:
                print("  - " + p)
        else:
            extra = ("; " + s.evidence) if getattr(s, "evidence", None) else ""
            print("pty: %s ok (%s %s, exit %d, %d bytes captured%s)" % (name, sys.platform, os.uname().machine, s.status, len(s.out), extra))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
