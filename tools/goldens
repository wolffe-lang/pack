#!/bin/sh
# goldens — the headless cases against tests/goldens/, or regenerate them.
#
#   tools/goldens [--bin BIN]          run every case on both tiers into
#                                      target/goldens/ and diff -r each
#                                      against tests/goldens/<case>-<tier>/
#   tools/goldens --update [--bin BIN] write tests/goldens/ afresh
#
# A case is tests/cases/<case>.pk (a replay with a `# frames N every K`
# line the runner reads, `# frames N every K from T` to start the written
# frames at tick T); the art study's sheets are the case `art`.
# BIN defaults to target/release/pack. Determinism is the oracle: a golden
# differs only when the simulation, the world, the tiers or the renderer
# changed, and the diff says exactly where.
set -eu
PACK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$PACK_ROOT"
. tools/lib-mem.sh
require_memory
bin=target/release/pack
update=0
while [ $# -gt 0 ]; do
    case $1 in
    --update) update=1 ;;
    --bin) bin=$2; shift ;;
    *) echo "goldens: unknown option $1" >&2; exit 2 ;;
    esac
    shift
done
[ -x "$bin" ] || { echo "goldens: no binary at $bin (tools/build --release)" >&2; exit 2; }
out=target/goldens
rm -rf "$out"
mkdir -p "$out"
status=0
for case_file in tests/cases/*.pk; do
    name=$(basename "$case_file" .pk)
    frames=$(sed -n 's/^# frames \([0-9]*\).*/\1/p' "$case_file" | head -1)
    every=$(sed -n 's/^# frames [0-9]* every \([0-9]*\).*/\1/p' "$case_file" | head -1)
    from=$(sed -n 's/^# frames [0-9]* every [0-9]* from \([0-9]*\).*/\1/p' "$case_file" | head -1)
    for tier in rich plain; do
        dir="$out/$name-$tier"
        "$bin" --headless --script "$case_file" --frames "${frames:-60}" --every "${every:-10}" --from "${from:-0}" --tier "$tier" --dump "$dir"
        if [ "$update" = 1 ]; then
            rm -rf "tests/goldens/$name-$tier"
            mkdir -p tests/goldens
            cp -R "$dir" "tests/goldens/$name-$tier"
            echo "goldens: wrote tests/goldens/$name-$tier"
        elif diff -r "tests/goldens/$name-$tier" "$dir" >"$out/$name-$tier.diff" 2>&1; then
            echo "goldens: $name-$tier ok"
        else
            echo "goldens: $name-$tier DIFFERS ($out/$name-$tier.diff)"
            head -20 "$out/$name-$tier.diff"
            status=1
        fi
    done
done
# The art study's sheets.
"$bin" --art-study --dump "$out/art"
if [ "$update" = 1 ]; then
    rm -rf tests/goldens/art
    cp -R "$out/art" tests/goldens/art
    echo "goldens: wrote tests/goldens/art"
elif diff -r tests/goldens/art "$out/art" >"$out/art.diff" 2>&1; then
    echo "goldens: art ok"
else
    echo "goldens: art DIFFERS ($out/art.diff)"
    head -20 "$out/art.diff"
    status=1
fi
exit $status
