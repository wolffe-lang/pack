#!/usr/bin/env python3
"""tools/perf-idle — the two perf rows that need a real terminal: wake-ups
at idle and input latency. Drives the release binary in a pty through
tools/pty's Session.

  idle     the game standing still (Down typed) for 10 s: the voluntary
           context switches of the process over the window, from
           /proc/PID/status on Linux (a loud SKIP elsewhere: macOS has no
           such counter without root). The bar: one wake a tick, 300 in
           10 s, with a fifth of slack either way (240 to 360): fewer means
           the tick is not running, more means the loop wakes for nothing.
  latency  Left typed 20 times, a third of a second apart, the game under
           `--trace`; the time from the write to the trace line the game
           prints right after writing the frame that CARRIES the key
           (`trace frame ... carries_key`), so a frame that happened to be
           in flight is never counted (pk00's measurement did, and read
           four-tick outliers that were its own). The bar (R-pk00-6): the
           median under one tick plus a render (40 ms) and the 90th
           percentile under two ticks (70 ms); the maximum is recorded, not
           gated, since one stall of a shared host is that host's. The
           game's own share (`inner_us`, from the key's read to the frame's
           write) is printed beside each sample.

PACK_PERF_SLACK multiplies the latency bars.
"""
import importlib.util, os, select, statistics, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
import importlib.machinery
_loader = importlib.machinery.SourceFileLoader("ptyrun", os.path.join(ROOT, "tools", "pty"))
ptyrun = importlib.util.module_from_spec(importlib.util.spec_from_loader("ptyrun", _loader))
_loader.exec_module(ptyrun)
SLACK = float(os.environ.get("PACK_PERF_SLACK", "1"))


def ctxt(pid):
    try:
        with open("/proc/%d/status" % pid) as f:
            for line in f:
                if line.startswith("voluntary_ctxt_switches:"):
                    return int(line.split()[1])
    except OSError:
        return None
    return None


def row_idle(bin):
    s = ptyrun.Session([bin, "--seed", "7"], 24, 80, ptyrun.env_for())
    s.pump(0.4)
    s.type(b"\x1b[B", settle=0.5)
    a = ctxt(s.job)
    if a is None:
        s.type(b"q")
        s.finish()
        print("perf-idle: idle SKIP (no /proc on this host; measure on Linux)")
        return True
    s.pump(10.0)
    b = ctxt(s.job)
    s.type(b"q")
    s.finish()
    wakes = b - a
    ok = 240 <= wakes <= 360
    print("perf-idle: idle %d voluntary context switches in 10 s at a standstill (bar 240..360) %s" % (wakes, "ok" if ok else "FAILED"))
    return ok


def row_latency(bin):
    s = ptyrun.Session([bin, "--seed", "7", "--trace"], 24, 80, ptyrun.env_for())
    s.pump(0.5)
    samples = []
    inner = []
    for i in range(20):
        s.pump(0.3)
        seen = s.err.count(b"carries_key")
        t0 = time.monotonic()
        os.write(s.master, b"\x1b[D")
        deadline = t0 + 1.0
        while time.monotonic() < deadline:
            r, _, _ = select.select([s.master, s.r_err], [], [], 0.001)
            if s.master in r:
                try:
                    chunk = os.read(s.master, 65536)
                except OSError:
                    chunk = b""
                if not chunk:
                    s.finish()
                    print("perf-idle: latency FAILED: the game ended after %d keys (exit %d, stderr %r)" % (i, s.status, s.err[-300:]))
                    return False
                s.out += chunk
            if s.r_err in r:
                chunk = os.read(s.r_err, 65536)
                if chunk:
                    s.err += chunk
                if s.err.count(b"carries_key") > seen:
                    samples.append((time.monotonic() - t0) * 1000)
                    line = [l for l in s.err.decode(errors="replace").splitlines() if "carries_key" in l][-1]
                    w = line.split()
                    inner.append(int(w[w.index("inner_us") + 1]) / 1000.0)
                    break
    s.type(b"q")
    s.finish()
    if len(samples) < 20:
        print("perf-idle: latency only %d of 20 keys drew a frame that carries them FAILED" % len(samples))
        return False
    print("perf-idle: latency samples ms (key write to the carrying frame's trace line): %s" % " ".join("%.0f" % x for x in samples))
    print("perf-idle: latency inner ms (the key's read to the frame's write): %s" % " ".join("%.1f" % x for x in inner))
    closing = [l for l in s.err.decode(errors="replace").splitlines() if l.startswith("pack:")]
    print("perf-idle: latency run's closing line: %s" % (closing[-1] if closing else "(none)"))
    ordered = sorted(samples)
    med, p90, mx = statistics.median(samples), ordered[int(len(ordered) * 0.9) - 1], max(samples)
    ok = med < 40 * SLACK and p90 < 70 * SLACK
    print("perf-idle: latency median %.1f ms p90 %.1f ms max %.1f ms over 20 keys (bars median %.0f, p90 %.0f ms) %s" % (med, p90, mx, 40 * SLACK, 70 * SLACK, "ok" if ok else "FAILED"))
    return ok


def main():
    bin = os.path.abspath(sys.argv[sys.argv.index("--bin") + 1]) if "--bin" in sys.argv else os.path.join(ROOT, "target", "release", "pack")
    if not ptyrun.mac_memory_ok():
        return 3
    ok = row_idle(bin)
    ok = row_latency(bin) and ok
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
