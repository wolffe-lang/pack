#!/bin/sh
# fetch-toolchain — stage the pinned wolf, lupin and std into .wolf-bin/.
#
# Archives are fetched from the GitHub release and REFUSED unless their
# sha256 matches wolf-toolchain.toml (yew's pattern, tools/fetch-toolchain
# there). The std tree is the one the wolf archive bundles, and the pin
# must name that exact commit: a pin that drifts from the bundle is
# refused, never papered over by a second fetch. A stage whose recorded
# stamp already matches is left alone, so the tool is cheap to run before
# every build.
set -eu
PACK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PACK_ROOT
cd "$PACK_ROOT"
. tools/lib-toml.sh

target=$(host_target) || {
    echo "fetch-toolchain: no pinned archive for $(uname -s) $(uname -m)" >&2
    exit 1
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

wolf_digest=$(toml_value wolf "$target")
lupin_digest=$(toml_value lupin "$target")
std_rev=$(toml_value std rev)
want_stamp="$target wolf=$wolf_digest lupin=$lupin_digest std=$std_rev"

if [ -f .wolf-bin/STAMP ] && [ "$(cat .wolf-bin/STAMP)" = "$want_stamp" ]; then
    echo "fetch-toolchain: .wolf-bin/ already holds the pin ($target)"
    exit 0
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/pack-toolchain.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
rm -rf .wolf-bin
mkdir -p .wolf-bin

# fetch_archive <section> <name-prefix> <digest>
fetch_archive() {
    version=$(toml_value "$1" version)
    repo=$(toml_value "$1" repo)
    base="$2-$version-$target"
    # $PACK_ARCHIVE_DIR takes the archive from a directory instead of the
    # network, for a host whose link to GitHub is slow or absent. The
    # digest check below is the same either way.
    if [ -n "${PACK_ARCHIVE_DIR:-}" ] && [ -f "$PACK_ARCHIVE_DIR/$base.tar.gz" ]; then
        echo "fetch-toolchain: $PACK_ARCHIVE_DIR/$base.tar.gz"
        cp "$PACK_ARCHIVE_DIR/$base.tar.gz" "$tmp/$base.tar.gz"
    else
        url="https://github.com/$repo/releases/download/v$version/$base.tar.gz"
        echo "fetch-toolchain: $url"
        curl -sSfL --retry 3 --retry-delay 5 -o "$tmp/$base.tar.gz" "$url"
    fi
    have=$(sha256 "$tmp/$base.tar.gz")
    if [ "$have" != "$3" ]; then
        echo "fetch-toolchain: REFUSED — $base.tar.gz sha256 $have, pin wants $3" >&2
        exit 1
    fi
    echo "fetch-toolchain: sha256 $have OK"
    tar -xzf "$tmp/$base.tar.gz" -C "$tmp"
    cp -R "$tmp/$base/." .wolf-bin/
}

fetch_archive wolf wolf "$wolf_digest"
fetch_archive lupin lupin "$lupin_digest"

# The wolf archive bundles its std (`std/STD-REV` names the commit). The
# pin must be that commit: the bundle is what the compiler was released
# with, and pack builds against nothing else.
bundled=$(cat .wolf-bin/std/STD-REV 2>/dev/null || echo "(no STD-REV)")
if [ "$bundled" != "$std_rev" ]; then
    echo "fetch-toolchain: REFUSED — the archive bundles std $bundled, the pin names $std_rev" >&2
    exit 1
fi
echo "fetch-toolchain: std $bundled (bundled, equal to the pin)"

echo "$want_stamp" >.wolf-bin/STAMP
echo "fetch-toolchain: staged $target into .wolf-bin/"
