#!/usr/bin/env python3
"""tools/keyprobe — what does this terminal send? Raw mode, every key's
bytes printed in hex and as an escaped string, `q` to finish (the terminal
restored). Run it in Terminal.app, iTerm2, a Linux VT or PAX's console and
paste the lines into docs/KEYS.md with the date. No dependency: python3.
"""
import os, sys, termios, tty, select

fd = sys.stdin.fileno()
saved = termios.tcgetattr(fd)
print("keyprobe: press keys; q finishes. TERM=%s" % os.environ.get("TERM", "?"))
try:
    tty.setraw(fd)
    while True:
        data = os.read(fd, 64)
        # A lone ESC against a sequence: wait 50 ms for more bytes.
        while data == b"\x1b" or (data.startswith(b"\x1b") and select.select([fd], [], [], 0.05)[0]):
            data += os.read(fd, 64)
            if not select.select([fd], [], [], 0.05)[0]:
                break
        sys.stdout.write("%-24s %r\r\n" % (" ".join("%02X" % b for b in data), data))
        sys.stdout.flush()
        if data in (b"q", b"Q"):
            break
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
