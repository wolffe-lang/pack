#!/bin/sh
# in-container — run a command in the Linux leg's container (ci/Containerfile)
# with the repository mounted at /work: podman on a lane host, docker on CI
# (PACK_ENGINE), pinned to PACK_CPUS with taskset inside when set (the
# rootless engines reach no cpuset; hasu's blocks are `taskset -c 6-11`).
#
#   tools/in-container CMD ARGS...
#   PACK_ENGINE=docker tools/in-container tools/check-linux
set -eu
PACK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$PACK_ROOT"
engine=${PACK_ENGINE:-podman}
cpus=${PACK_CPUS:-}
if command -v sha256sum >/dev/null 2>&1; then
    tag=$(sha256sum ci/Containerfile | cut -c1-16)
else
    tag=$(shasum -a 256 ci/Containerfile | cut -c1-16)
fi
image="localhost/pack-ci:$tag"
if ! "$engine" image inspect "$image" >/dev/null 2>&1; then
    "$engine" build --memory 12g -t "$image" -f ci/Containerfile ci
fi
set -- "$@"
if [ -n "$cpus" ]; then
    exec "$engine" run --rm --memory 12g -v "$PACK_ROOT:/work" -w /work "$image" taskset -c "$cpus" "$@"
fi
exec "$engine" run --rm --memory 12g -v "$PACK_ROOT:/work" -w /work "$image" "$@"
