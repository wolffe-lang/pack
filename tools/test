#!/bin/sh
# test — the unit tests: `wolf test --deny-warnings --nocapture src`, every
# `test_*` on the checked machine (every allocation modelled, every UB row
# detected). The exit is wolf test's own; a SKIP line, were one printed,
# would show under --nocapture and be counted here.
set -eu
PACK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PACK_ROOT
cd "$PACK_ROOT"
. tools/lib-toolchain.sh
"$WOLF" test --deny-warnings --nocapture src 2>&1 | tee target/test.log
status=$?
[ "$status" = 0 ] || exit "$status"
skips=$(grep -c '^SKIP' target/test.log || true)
echo "test: $skips SKIP lines"
[ "$skips" = 0 ]
