#!/bin/sh
# build — compile pack on one tier or both.
#
#   tools/build [--native|--release|--all]
#   --native   the fast default backend  -> target/native/pack
#   --release  LLVM with the mid-end on  -> target/release/pack, and a
#              copy at target/pack (the one the maintainer runs)
#   --all      both (the default)
# Every build denies warnings. The program is src/pack.lu over the modules
# under src/ (grid, tier, term, input, clock, sim, world, replay, art).
set -eu
PACK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PACK_ROOT
cd "$PACK_ROOT"
. tools/lib-mem.sh
require_memory
. tools/lib-toolchain.sh

tiers="native release"
case "${1:-}" in
--native) tiers=native ;;
--release) tiers=release ;;
--all | "") ;;
*)
    echo "build: unknown option $1" >&2
    exit 2
    ;;
esac

for tier in $tiers; do
    mkdir -p "target/$tier"
    if [ "$tier" = release ]; then
        # WOLF_MIDEND=0: at wolf 0.2.35 the release tier's mid-end miscompiles
        # the live loop's key path (every key decoded as the quit key while
        # `pack --selftest` in the same binary passes; the native tier and the
        # release tier with the mid-end off decode every key; witness: the pty
        # runner's `quit` and `ctrl-c` rows and tests/cases under
        # notes/pk00-the-engine.md, the wolf-lang issue to file). The guide's
        # precedent for a mid-end fault (wolf-lang#146) is this switch.
        WOLF_MIDEND=0 "$WOLF" build --release --no-cache --deny-warnings src/pack.lu -o target/release/pack
        cp target/release/pack target/pack
    else
        "$WOLF" build --deny-warnings src/pack.lu -o target/native/pack
    fi
    echo "build: target/$tier/pack"
done
