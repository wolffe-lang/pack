#!/bin/sh
# check-linux — what the Linux leg runs INSIDE the container: the toolchain
# is already staged in .wolf-bin/ (fetched on the host by digest), so this
# is fmt, the unit tests, both builds, the goldens and the pty rows. The
# identity check in lib-toolchain.sh still runs through every tool.
set -eu
PACK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$PACK_ROOT"
tools/check-fmt
tools/test
tools/build --all
target/release/pack --selftest
tools/goldens
python3 -I tools/pty --bin target/release/pack
echo "check-linux: green"
