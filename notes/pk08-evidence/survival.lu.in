use sim
use world

fn abs(v: int) -> int {
    if v < 0 then 0 - v else v
}

fn rd(ax: int, ay: int, bx: int, by: int) -> int {
    let dx = abs(bx - ax)
    let dy = abs(by - ay)
    if dx > dy then dx else dy
}

/// A competent player: leap when a live shadow is within LEAP_REACH of a
/// running wolf; sprint when a tired deer is within 14 cells ahead.
fn play(seed: int, with_deer: bool, ticks: int) {
    var s = sim.new(seed, 80, 24)
    var i = 0
    var leaps = 0
    var sprints = 0
    while i < ticks && !s.dead {
        var keys = List[int]()
        var want_leap = false
        var aim_x = 0
        var aim_y = 1
        for sh in s.shadows {
            if sim.shadow_crouching(sh) && world.hash(seed + 77, i, 1, 3) != 0 {
                var w = 0
                while w < sim.PACK_SIZE {
                    let wolf = copy s.wolves[w]
                    if wolf.state == sim.RUNNING && sim.leap_member(s.leap_next_group, w) && rd(sh.x, sh.y, wolf.x, wolf.y) <= sim.LEAP_REACH_AIM * world.FP {
                        want_leap = true
                        aim_x = sh.x-wolf.x
                        aim_y = sh.y-wolf.y
                    }
                    w += 1
                }
            }
        }
        if want_leap && s.leap_ready_at <= s.tick && s.stamina >= sim.LEAP_STAMINA && !s.exhausted {
            if abs(aim_x) >= abs(aim_y) / 2 { (mut keys).push(if aim_x < 0 then sim.KEY_LEFT else sim.KEY_RIGHT) }
            if abs(aim_y) >= abs(aim_x) / 2 { (mut keys).push(if aim_y < 0 then sim.KEY_DOWN else sim.KEY_UP) }
            (mut keys).push(sim.KEY_LEAP)
            leaps += 1
        }
        let a = sim.alpha(s)
        for d in s.deer {
            if d.tired && d.y > a.y && d.y - a.y < 14 * world.FP && s.sprint_left == 0 && s.stamina >= 250 && s.health <= 75 {
                (mut keys).push(sim.KEY_UP)
                sprints += 1
            }
        }
        sim.step(mut s, keys, 0)
        if !with_deer {
            while s.deer.len > 0 {
                let _ = (mut s.deer).pop() else sim.grazer(s, 0, 0)
            }
        }
        if i % 1800 == 1799 {
            print("  seed {seed} deer={with_deer} t {i + 1} health {s.health} down {s.down} shadows {s.spawned} landed {s.landed} vanq {s.vanquished} fed {s.fed} dist {sim.distance_cells(s)} rate {sim.spawn_rate(s)}")
        }
        i += 1
    }
    print("seed {seed} deer={with_deer}: {if s.dead then "DEAD at {s.died_tick}" else "alive at {s.tick}"} health {s.health} landed {s.landed} vanquished {s.vanquished} fed {s.fed} of {s.deer_spawned} leaps {leaps} sprints {sprints} dist {sim.distance_cells(s)} score {sim.score(s)}")
}

fn main() {
    let seeds = [11, 7, 3, 5, 16]
    for seed in seeds {
        play(seed, true, 9000)
        play(seed, false, 9000)
    }
}
